# TEA custom domains (TPF-148): nginx keeps exact server names in a hash whose bucket size defaults to
# the CPU cache line (64 on x86_64). One name of 47 characters or more does not fit, and nginx then
# refuses to start ("could not build server_names_hash"). The TEA-only server block at the end of this
# file names the custom-domain hosts, each up to 239 characters (the bound the chart enforces); 256 is
# too small for 239, 512 holds it and hundreds of names. Set once, here: this file is included inside
# nginx.conf's http block, the context the directive belongs to, and nginx refuses it twice.
server_names_hash_bucket_size 512;

upstream backend {
    server ${HUB_HOST}:${HUB_PORT};
}

upstream keycloak {
    server ${KEYCLOAK_HOST}:${KEYCLOAK_PORT};
}

server {
    listen       80 default_server;
    server_name  localhost;
    client_max_body_size 1m;
    #charset koi8-r;
    #access_log  /var/log/nginx/host.access.log  main;

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;

        # Security headers for the SPA shell + static assets. HSTS is intentionally
        # NOT set here — TLS terminates at the Traefik ingress / upstream LB, which
        # owns Strict-Transport-Security. The backend (/api, /graphql) and Keycloak
        # (/kauth) emit their own headers, so these live only on the static app.
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # CSP ships in Report-Only first so it can be validated in a browser before
        # enforcing — switch the directive name to Content-Security-Policy to enforce.
        # 'unsafe-eval' is required by Vega (vega/vega-lite compile expressions via
        # Function); 'unsafe-inline' in style-src covers Vue's runtime-injected
        # <style> blocks and inline style attributes; img-src allows data:/blob: for
        # generated charts and client-side downloads.
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    }

    location /v1 {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        # https://www.nginx.com/resources/wiki/start/topics/examples/forwarded/
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 90;
        proxy_read_timeout 90;
        proxy_send_timeout 90;
    }

    location /api {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 90;
        proxy_read_timeout 90;
        proxy_send_timeout 90;
    }

    location /tea {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        # https://www.nginx.com/resources/wiki/start/topics/examples/forwarded/
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 90;
        proxy_read_timeout 90;
        proxy_send_timeout 90;
    }

    location /.well-known/tea {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        # https://www.nginx.com/resources/wiki/start/topics/examples/forwarded/
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 60;
        proxy_read_timeout 60;
        proxy_send_timeout 60;
    }

    location /graphql {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 90;
        proxy_read_timeout 180;
        proxy_send_timeout 180;
    }

    location /kauth {
        ${KEYCLOAK_ADMIN_ACCESS}
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/admin/Reliza {
        ${KEYCLOAK_RELIZA_ADMIN_ACCESS}
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/admin/realms/Reliza {
        ${KEYCLOAK_RELIZA_ADMIN_ACCESS}
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/admin/serverinfo {
        ${KEYCLOAK_RELIZA_ADMIN_ACCESS}
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/realms/Reliza {
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/resources {
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    location /kauth/js {
        proxy_pass http://keycloak;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
    }

    # Upstream answers pass through as sent on every proxied location: status, headers and body.
    # Clients read them: the API's JSON errors and the token endpoint's OAuth errors, Retry-After on
    # a 429, TEA's TeaErrorResponse, Keycloak's own error pages and JSON (TPF-49). The pages below are
    # for nginx's own errors only: an upstream it cannot reach or that does not answer in time (502,
    # 504: the server-down page) and a request nginx refuses itself (400, 405, 408, 413, 414 ...).
    # Never set proxy_intercept_errors on, here or in a location, and never give a location an
    # error_page of its own: it would replace these inherited lines and lose the server-down page.
    proxy_intercept_errors off;
    error_page  401              /error_pages/401.html;
    error_page  402              /error_pages/402.html;
    error_page  403              /error_pages/403.html;
    error_page  404              /error_pages/404.html;
    error_page  400 405 406 407 408 409 410 411 412 413 414 415 415 418 421 422 423 424 425 426 428 429 431 451 500 501 505 506 507 508 510 511 /error_pages/generic.html;
    error_page  502 503 504      /error_pages/server_down.html;

}


# TEA custom domains (TPF-148). TEA_CUSTOM_DOMAINS lists the hosts, separated by spaces, on which an
# organization's TEA API is served from its own domain. On such a host this block answers instead of the
# one above: it proxies only the TEA API (/tea/...) and its discovery document (/.well-known/tea) to the
# backend, and every other path is 404, so the UI files and /kauth are never served on a custom domain.
# nginx decodes the path and resolves dot segments before it picks a location, so an encoded escape such
# as /tea/..%2findex.html is matched as /index.html and lands in the 404. With no hosts listed,
# nginx_start.sh sets the reserved name tea-custom-domains.invalid, which no request can carry, so the
# block is inert. Any host not named here keeps the default_server above, as before. No error_page and no
# proxy_intercept_errors here: the backend's answers pass through as sent, and nginx's own errors (the 404
# below, a 502) use nginx's built-in pages, since this block serves no static files.
server {
    listen       80;
    server_name  ${TEA_CUSTOM_DOMAINS};

    location ^~ /tea/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        # https://www.nginx.com/resources/wiki/start/topics/examples/forwarded/
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 90;
        proxy_read_timeout 90;
        proxy_send_timeout 90;
    }

    location = /.well-known/tea {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        # https://www.nginx.com/resources/wiki/start/topics/examples/forwarded/
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $http_x_forwarded_proto; # aws version - essentially this sets https schema
        proxy_connect_timeout 60;
        proxy_read_timeout 60;
        proxy_send_timeout 60;
    }

    # Without this, /tea would get nginx's automatic 301 to /tea/ (a prefix location ending in a slash
    # that proxies); the backend serves nothing at /tea, so it is a 404 like every other path.
    location = /tea {
        return 404;
    }

    location / {
        return 404;
    }
}
