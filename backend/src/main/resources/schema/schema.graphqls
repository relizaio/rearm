

# ---------------------------------------------------------------------
# Notifications framework -- enums (promoted from String in Phase 3).
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Notifications framework -- write inputs (Phase 3).
# ---------------------------------------------------------------------


type Deliverable {
	uuid: ID
	name: String
	org: ID
	displayIdentifier: String
	branch: ID
	type: String
	notes: String
	tags: [TagRecord]
	version: String
	publisher: String
	group: String
	supportedOs: [OSEnum]
	supportedCpuArchitectures: [CPUArchitectureEnum]
	softwareMetadata: SoftwareMetadata
	hardwareMetadata: HardwareMetadata
	quantity: Int
	artifacts: [ID]
	artifactDetails: [Artifact]
	identifiers: [Identifier]
}

# ===== Distribution / HBOM -- CDX-aligned hardware deliverable metadata =====
enum PartyRole { MANUFACTURER ASSEMBLER SUPPLIER QUALITY_CONTROL DISTRIBUTOR OTHER }

type Coords { latitude: Float longitude: Float }
input CoordsInput { latitude: Float longitude: Float }
type Address { streetAddress: String city: String region: String postalCode: String country: String isoCode: String coords: Coords }
input AddressInput { streetAddress: String city: String region: String postalCode: String country: String isoCode: String coords: CoordsInput }
type PartyContact { name: String email: String phone: String }
input PartyContactInput { name: String email: String phone: String }
type OriginShare { originCode: String percentage: Float }
input OriginShareInput { originCode: String percentage: Float }
"""Country-of-origin + multi-source split (HBOM extension; emitted as a CDX property)."""
type Origin { basis: String origins: [OriginShare] }
input OriginInput { basis: String origins: [OriginShareInput] }
type ExternalRef { type: String url: String comment: String }
input ExternalRefInput { type: String url: String comment: String }
"""A CDX-2.0 party (entity with roles), per spec PR #930."""
type Party { roles: [PartyRole] bomRef: String priority: Int name: String address: Address contacts: [PartyContact] url: String origin: Origin }
input PartyInput { roles: [PartyRole] bomRef: String priority: Int name: String address: AddressInput contacts: [PartyContactInput] url: String origin: OriginInput }
"""CDX-aligned production facts for a hardware deliverable (a produced lot)."""
type HardwareMetadata { parties: [Party] origin: Origin manufactureDate: String externalRefs: [ExternalRef] extensions: Object }
input HardwareMetadataInput { parties: [PartyInput] origin: OriginInput manufactureDate: String externalRefs: [ExternalRefInput] extensions: Object }

type SoftwareMetadata {
	buildId: String
	buildUri: String
	cicdMeta: String
	digests: [String]
	digestRecords: [DigestRecord]
	dateFrom: DateTime
	dateTo: DateTime
	duration: Long
	packageType: PackageType
	downloadLinks: [Downloadlink]
}

type Component {
	uuid: ID
	name: String
	org: ID
	resourceGroup: ID
	type: ComponentType
	kind: ComponentKind
	versionSchema: String
	marketingVersionSchema: String
	versionType: VersionType
	vcs: ID
	vcsRepositoryDetails: VcsRepository
	featureBranchVersioning: String
	repositoryEnabled: Int
	status: Status
	apiKeyId: String
	apiKey: String
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	defaultConfig: String
	visibilitySetting: VisibilitySetting
	approvalPolicy: ID
	approvalPolicyDetails: ApprovalPolicy
	"""
	Resolved approval policy for this component. Per-component
	{@code approvalPolicy} wins when present AND still references an
	existing policy. Otherwise the org-wide rule list is walked in
	order; the first rule whose {@code namePattern} matches the
	component's name AND whose {@code componentType} accepts the
	component's type contributes its policy. {@code source} discriminates
	between the cases; {@code ruleName} is set only when source =
	ORG_RULE; {@code alsoMatchedRuleNames} carries any later-list rules
	whose pattern + type-filter also matched; {@code perComponentPolicyArchived}
	is true when the component carried a per-component reference but
	the referenced policy was archived/missing, so resolution fell
	through to org rules (signals a stale reference for the UI to
	warn about).
	"""
	effectiveApprovalPolicy: EffectiveApprovalPolicy
	releaseInputTriggers: [ReleaseInputEvent]
	outputTriggers: [ReleaseOutputEvent]
	identifiers: [Identifier]
	# Distribution module: device classification + profiles + native identifiers.
	nature: ComponentNature
	deviceClass: DeviceClass
	medicalProfile: MedicalProfile
	repoPath: String
	authentication: ComponentAuthentication
	branchSuffixMode: BranchSuffixMode
	globalInputEventRefs: [GlobalInputEventRef]
	perspectiveDetails: [Perspective]
	"""Component-level sid override (null = INHERIT)."""
	sidPurlOverride: SidPurlOverride
	"""Component-level decoded authority segments (null/empty = none stored)."""
	sidAuthoritySegments: [String!]
	"""Internal/external classification (D16). Null on legacy rows is treated as INTERNAL."""
	isInternal: BelongsToOrganization
	"""
	Synthetic component-level lifecycle derived from the lifecycles of the
	component's releases:
	- if every release lifecycle is ≤ GENERAL_AVAILABILITY, returns the
	  most-advanced of those (i.e. max-pre-or-at-GA);
	- otherwise returns the smallest lifecycle ≥ GENERAL_AVAILABILITY
	  observed across releases (i.e. min-post-GA).
	Null when the component has no releases.
	"""
	effectiveLifecycle: ReleaseLifecycleEnum
	"""Manually-assigned lead user UUIDs for this component/product."""
	leads: [ID!]
	"""Resolved org-user details for the manually-assigned leads."""
	leadDetails: [OrgUserData!]
	"""Freeform stakeholder contacts for non-registered users (HTML-sanitized on write)."""
	contacts: [ComponentContact!]
	"""
	Derived team: org users holding a READ_WRITE-or-stronger COMPONENT-scoped
	permission on this component. Falls back up the parent (product) chain when
	the component itself has no direct members.
	"""
	team: [OrgUserData!]
	"""
	Derived approvers: org users whose COMPONENT-scoped permission on this
	component carries one or more approval-role grants. Same parent fallback as team.
	"""
	approvers: [OrgUserData!]
	"""Stored durable owner (team-preferred, USER escape hatch); null = none set (RFC Phase 4)."""
	owner: ComponentOwner
	"""
	Computed ownership resolution: status / durability / derived suggestion. Pure
	recompute (never stored); a non-OWNED status drives a non-blocking banner + the
	at-risk report and NEVER blocks releases.
	"""
	ownership: ComponentOwnership!
	"""
	Guards written on this component. They accumulate with the guards its perspectives and its
	organization declare for it -- every applicable guard is evaluated and any one can refuse.
	"""
	actionGuards: [ActionGuard!]
	"""Locks raised on this component, active and recently released."""
	locks: [Lock!]
}

"""A freeform stakeholder contact for someone who is not a registered ReARM user."""
type ComponentContact {
	name: String
	contact: String
}

"""The kind of durable owner a component points at (RFC Phase 4)."""
enum ComponentOwnerType {
	TEAM
	USER
}

"""Computed ownership state of a component. Pure recompute; never blocks releases."""
enum ComponentOwnershipStatus {
	OWNED
	NON_DURABLE
	DEGRADED
	UNSET
	ORPHANED
}

"""A component's stored durable owner reference (a Team/UserGroup or a single user)."""
type ComponentOwner {
	ownerType: ComponentOwnerType!
	ownerRef: ID!
}

"""Resolved ownership view of a component (status/durability/derived suggestion)."""
type ComponentOwnership {
	ownerType: ComponentOwnerType
	ownerRef: ID
	durable: Boolean!
	status: ComponentOwnershipStatus!
	derived: Boolean!
	reason: String
}


enum ComponentKind {
	HELM
	GENERIC
}

type Identifier {
	idType: IdentifierType
	idValue: String
}


type Organization {
	uuid: ID
	name: String
	type: OrganizationType
	approvalRoles: [ApprovalRole]
	terminology: Terminology
	ignoreViolation: IgnoreViolation
	settings: Settings
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	"""
	Org-wide PR-validation trigger rules. Each rule maps a regex over
	{@code VcsRepository.uri} (matched fully-anchored, see {@link
	GlobalPrValidationTriggerRule.uriPattern}) to an EXTERNAL_VALIDATION
	trigger that should apply when a VCS in the org has no per-repo
	override. List order is the priority order -- the first matching
	rule wins, and the per-VCS resolver surfaces the losing rule names
	for operator clean-up. SAAS-only.
	"""
	globalPrValidationTriggerRules: [GlobalPrValidationTriggerRule]
	"""
	Org-wide approval-policy assignment rules. Each rule maps a regex
	over {@code Component.name} (matched fully-anchored) plus a
	{@code componentType} filter to an approval-policy UUID. When a
	component has no per-component policy reference (or it points to
	an archived/missing policy), the resolver walks this list in order
	and the first matching rule's policy becomes the effective policy.
	List order is the priority order -- first match wins; the per-
	Component resolver surfaces the losing rule names for operator
	clean-up. SAAS-only.
	"""
	globalApprovalPolicyRules: [GlobalApprovalPolicyRule]
	"""
	Org-wide team-assignment rules. Each rule maps a regex over
	{@code Component.name} (matched fully-anchored) plus a
	{@code componentType} filter to an owner team. When a component has no
	per-component owner, the resolver walks this list in order and the first
	matching rule's team becomes the component's durable owner -- the result
	is flagged derived and names the rule, so the UI can distinguish "someone
	chose this" from "a pattern matched". A per-component owner always wins.
	List order is the priority order -- first match wins.
	"""
	globalTeamAssignmentRules: [GlobalTeamAssignmentRule]
}

"""
Org-wide team-assignment rule (T2). See
{@link Organization.globalTeamAssignmentRules} for the priority contract.
"""
type GlobalTeamAssignmentRule {
	"""Display name; unique within the org."""
	name: String
	"""
	Java regex matched against {@code ComponentData.name} via
	{@code Pattern.matcher(name).matches()} -- fully anchored. Operators write
	{@code frontend-.*} (no leading {@code ^}, no trailing {@code $}).
	"""
	namePattern: String
	"""Type filter; ANY (or null) matches both COMPONENT and PRODUCT."""
	componentType: ComponentType
	"""Owner team (UserGroup) UUID; must exist and be active in this org."""
	ownerTeam: ID
}


"""
Org-wide PR-validation trigger rule. See
{@link Organization.globalPrValidationTriggerRules} for the priority
contract; see {@link VcsRepository.effectivePrValidationTrigger} for
how rules are resolved per repo.
"""
type GlobalPrValidationTriggerRule {
	"""Display name; unique within the org."""
	name: String
	"""
	Java regex matched against {@code VcsRepositoryData.uri} via
	{@code Pattern.matcher(uri).matches()} -- fully anchored. Operators
	write {@code github.com/myorg/.*} (no leading {@code ^}, no
	trailing {@code $}) and the engine anchors automatically.
	"""
	uriPattern: String
	"""
	Trigger spec. Same shape as a per-VCS trigger; must be of type
	EXTERNAL_VALIDATION and reference a GITHUB integration with the
	PR_VALIDATE capability in the same org.
	"""
	trigger: ReleaseOutputEvent
}


"""
Org-wide approval-policy assignment rule. See
{@link Organization.globalApprovalPolicyRules} for the priority
contract and {@link Component.effectiveApprovalPolicy} for how rules
are resolved per component.
"""
type GlobalApprovalPolicyRule {
	"""Display name; unique within the org."""
	name: String
	"""
	Java regex matched against {@code Component.name} via
	{@code Pattern.matcher(name).matches()} -- fully anchored. Operators
	write {@code frontend-.*} (no leading {@code ^}, no trailing
	{@code $}) and the engine anchors automatically.
	"""
	namePattern: String
	"""
	Type filter. {@code COMPONENT} / {@code PRODUCT} restrict the
	match; {@code ANY} (also the default when null) matches both
	concrete component types.
	"""
	componentType: ComponentType
	"""Referenced approval policy UUID."""
	approvalPolicy: ID
	"""Hydrated approval policy. Null when the referenced policy is missing/archived."""
	approvalPolicyDetails: ApprovalPolicy
}


"""
Resolved approval policy snapshot for a Component. See
{@link Component.effectiveApprovalPolicy}.
"""
type EffectiveApprovalPolicy {
	source: ApprovalPolicySource
	approvalPolicy: ID
	approvalPolicyDetails: ApprovalPolicy
	ruleName: String
	alsoMatchedRuleNames: [String]
	perComponentPolicyArchived: Boolean
}

enum ApprovalPolicySource {
	"""Per-component approvalPolicy reference is set and the policy still exists."""
	PER_COMPONENT
	"""Inherited from an org-wide GlobalApprovalPolicyRule."""
	ORG_RULE
	"""Neither per-component nor any matching org rule -- no approval policy is in effect."""
	NONE
}

type Terminology {
	featureSetLabel: String
}

type IgnoreViolation {
	licenseViolationRegexIgnore: [String]
	securityViolationRegexIgnore: [String]
	operationalViolationRegexIgnore: [String]
}

type Settings {
	declarativePrune: DeclarativePruneMode
	justificationMandatory: Boolean
	branchSuffixMode: BranchSuffixMode
	vexComplianceFramework: VexComplianceFramework
	"""
	Org-level mode for sid (Software IDentification) PURL emission. See SidPurlMode docs.
	Null is treated as DISABLED at resolution time.
	"""
	sidPurlMode: SidPurlMode
	"""
	Decoded authority segments used when emitting platform sid PURLs. The first segment is
	the authority (domain or registered name); subsequent segments are publisher / business
	unit / product line context. Required when sidPurlMode == ENABLED_STRICT; optional under
	ENABLED_FLEXIBLE (used as a fallback when components/perspectives don't supply their own);
	must be null/empty under DISABLED.
	"""
	sidAuthoritySegments: [String!]
	"""
	Retention window, in days, for the org's notification rows (outbox events,
	deliveries, read marks). Null means the 90-day default.
	"""
	notificationRetentionDays: Int
	"""
	The submission-level justification: what FDA L1021-1022 asks for literally, the reason
	per-component support information cannot be included. At the measured 2.3% upstream
	coverage this is the centre of a submission rather than a footnote.

	Null is a real state, not a default. A document with an empty REQUIRED slot is blocked
	rather than generated with the section missing -- on a submission a reviewer expects
	gaps, but on the patient-facing Device Support Statement a silent gap is itself
	misleading under 502(a)(1). No product-shipped default text: these are the
	manufacturer's own commitments.
	"""
	fdaAssessmentNarrative: String
	"""
	Whether this org's exports carry its support attestations.

	NULL MEANS DISABLED. The default is off: support properties do not appear in an
	export unless someone asks for them. It governs INJECTION only -- the
	forged-provenance strip runs on every egress whatever this says, because a
	security control and a content choice are not the same switch.
	"""
	supportInjection: SupportInjectionSetting
	"""
	Labeling VI.A.2: that patches and software updates may cease at end of support.
	"""
	fdaPatchesMayCeaseStatement: String
	"""
	Labeling VI.A.3: a REFERENCE to the controlled risk-transfer process -- an identifier or
	URL, never the process itself. Plans are design-history-file records, and a pasted copy
	becomes a second, unversioned original that drifts from the controlled one.
	"""
	fdaRiskTransferProcessRef: String
	"""
	Labeling VI.A.4: that end-user cybersecurity risk can be expected to increase over
	time.
	"""
	fdaRiskIncreasesNotice: String
	"""
	Org-wide default UI view (Security or DevOps) for users who have not
	picked one in their browser. Null means SECURITY.
	"""
	defaultView: DashboardView
	"""
	Guards declared once for the organization, each picking the components it governs by name
	pattern, the same way the org's approval-policy rules do.
	"""
	actionGuards: [ActionGuard!]
}

"""
UI views the dashboard and component pages can show. Selected per browser
in the header; the org's default (Settings.defaultView) applies when the
browser has no choice stored.
"""
enum DashboardView {
	SECURITY
	DEVOPS
}

"""
Org-level sid PURL emission policy. D11 / D15.
- DISABLED: no sid emission; tenant-supplied pkg:sid/... values pass through unchanged.
- ENABLED_STRICT: sid emitted org-wide; component/perspective overrides not honored;
  the org authority applies to every internal component.
- ENABLED_FLEXIBLE: sid emitted org-wide, but components and (SaaS) perspectives
  may override the per-component decision and supply their own authority.

Enabling sid is forward-only -- releases created before the toggle retain their
existing identifiers unchanged.

"""
enum SidPurlMode {
	DISABLED
	ENABLED_STRICT
	ENABLED_FLEXIBLE
}

"""
Whether an organization's BOM exports carry its support attestations.

Two values, and deliberately not four: SupportExportState's PARTIAL and UNKNOWN are things
OBSERVED about a running system, not things an operator chooses. Storing either would let
an operator configure a state meaning "we are not sure what we do".
"""
enum SupportInjectionSetting {
	"""
	Exports carry the attestations. Applies to the native single-artifact download, the
	SPDX-augmented download and the merged release export -- NOT the raw artifact download,
	which is swept for forged reliza:* provenance and marked, but never injected into, on any
	setting.
	"""
	ENABLED
	"""
	Exports carry no support properties. The default, including when the field is unset.

	It does not disable the forged-provenance strip, which runs on every egress regardless:
	a security control and a content choice are not the same switch.
	"""
	DISABLED
}

"""
Component- and perspective-level sid override. Only honored when the org is in
ENABLED_FLEXIBLE; the mutation layer rejects ENABLE/DISABLE writes when the org
is STRICT or DISABLED. INHERIT (and null) defer to the next level up.
"""
enum SidPurlOverride {
	INHERIT
	ENABLE
	DISABLE
}

"""
Internal/external classification of a component (D16). EXTERNAL components are
third-party dependencies tracked inside the tenant's org and never receive a
platform-stamped sid PURL -- stamping the tenant's authority on third-party
software would be a falsified vendor claim. Defaults to INTERNAL on create.
"""
enum BelongsToOrganization {
	INTERNAL
	EXTERNAL
}

"""
VEX compliance framework layered on top of the CycloneDX baseline data model.
NONE  = pure CycloneDX, no extra validation.
CISA  = CISA VEX minimum requirements
        (https://www.cisa.gov/sites/default/files/2023-04/minimum-requirements-for-vex-508c.pdf).
"""
enum VexComplianceFramework {
	NONE
	CISA
}

"""
Controls whether non-base branches append a branch-derived suffix to
semver, four-part, and calver versions.
- APPEND: append branch namespace (e.g., 1.2.3-feat_x)
- NO_APPEND: do not append; conflicts resolved via -0, -1, ... suffix
- APPEND_EXCEPT_FOLLOW_VERSION: append for all branches and feature sets,
  except those with at least one follow-version dependency (treated as NO_APPEND for such branches)
- INHERIT: component-level only; defer to organization setting. Not valid at organization level.
"""
enum BranchSuffixMode {
	APPEND
	NO_APPEND
	APPEND_EXCEPT_FOLLOW_VERSION
	INHERIT
}


"""Kill switch for a whole key id: INACTIVE refuses every secret and every token issued for the key, without deleting anything."""
enum ApiKeyOrigin {
	MANUAL
	CLI_SESSION
}

"External identity providers whose tokens an organization can trust"
enum FederatedProvider {
	GITHUB_ACTIONS
}


"The external repository behind a FEDERATED key row, with the ids pinned on first use"
type FederatedIdentity {
	provider: FederatedProvider
	issuer: String
	owner: String
	repository: String
	repositoryUri: String
	repositoryId: String
	ownerId: String
	pinnedDate: DateTime
	lastRef: String
	lastRunId: String
	lastActor: String
}


enum ApiKeyStatus {
	ACTIVE
	INACTIVE
	"Delete tombstone; never listed, and setApiKeyStatus refuses it (delete the key instead)"
	REVOKED
	"A free-form key a write user asked for: listed, never usable, until an admin approves (ACTIVE) or denies it"
	REQUESTED
	"A denied request: listed for the requester with the reason in the notes, never usable"
	DENIED
}

"""
One of up to two secrets of a key id (rotation: add the second, move clients, retire the first).
Only metadata: the secret itself is shown once, when created or regenerated.
"""
type ApiKeySecretInfo {
	slot: Int!
	active: Boolean!
	createdDate: DateTime
	lastUsedDate: DateTime
	"Optional hard stop; past it the secret is refused like a retired one, and its tokens end here at the latest"
	expiresDate: DateTime
}

type ApiKey {
	uuid: ID
	org: ID
	permissions: Permissions
	object: ID
	type: ApiTypeEnum
	keyOrder: String
	lastUpdatedBy: ID
	createdBy: ID
	accessDate: DateTime
	createdDate: DateTime
	notes: String
	status: ApiKeyStatus
	secrets: [ApiKeySecretInfo!]
	"FREEFORM keys: the user who requested the key and the only one who may mint or regenerate its secrets"
	holder: ID
	"Deactivated by an org admin: the owner or holder cannot re-activate it, only an admin can"
	adminDisabled: Boolean
	"MANUAL, or CLI_SESSION for a personal key a CLI browser login created for its session (deleted with the session)"
	origin: ApiKeyOrigin
	"FEDERATED rows: the external repository this identity stands for"
	federation: FederatedIdentity
	"""
	Root agents this key is bound to via the agent-identity it
	resolves to (agent_identity_credentials). Empty until an agent
	has authenticated with this key at least once. FREEFORM keys only.
	"""
	boundAgents: [Agent]
}


type OrgUserData {
	uuid: ID
	name: String
	email: String
	githubId: String
	permissions: Permissions
	combinedUserOrgPermissions: Permissions
	status: UserStatus
}

type Permissions {
	permissions: [UserPermission]	
}

type UserPermission {
	org: ID
	scope: PermissionScope
	object: ID
	type: PermissionType
	functions: [PermissionFunction]
	meta: String
	approvals: [String]
}


type Ticket {
	uuid: ID
	identifier: String
	status: TicketStatus
	org: ID
	summary: String
	content: String
	doneInRelease: ID
	dateDone: DateTime
	uri: String
}

# ========== Sealed Interface Changelog Types ==========


# ========== Organization Changelog Types ==========


type VcsRepository {
	uuid: ID
	name: String
	org: ID
	uri: String
	type: String
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	"""
	Pull-request-level output triggers for this VCS repository. Currently
	constrained to ≤1 entry of type EXTERNAL_VALIDATION -- used by the PR
	aggregator to dispatch the aggregated check-run verdict to the SCM.
	"""
	outputTriggers: [ReleaseOutputEvent]
	"""
	Resolved PR-validation trigger for this repo. Per-repo
	{@code outputTriggers} always wins; otherwise the org-wide rule
	list is walked in order and the first match's trigger is returned.
	{@code source} discriminates between the two; {@code ruleName} is
	set only when source = ORG_RULE; {@code alsoMatchedRuleNames}
	carries any later-list rules whose pattern also matched (for the
	provenance UI's "rules X, Y also match; X wins" warning);
	{@code staleRuleNames} flags rules that matched but reference a
	missing/archived integration and were therefore skipped.
	"""
	effectivePrValidationTrigger: EffectivePrValidationTrigger
}

"""
Resolved PR-validation trigger snapshot for a VCS repository. See
{@link VcsRepository.effectivePrValidationTrigger}.
"""
type EffectivePrValidationTrigger {
	source: PrValidationTriggerSource
	trigger: ReleaseOutputEvent
	ruleName: String
	alsoMatchedRuleNames: [String]
	staleRuleNames: [String]
}

enum PrValidationTriggerSource {
	"""Per-repo trigger configured directly on this VCS row."""
	PER_VCS
	"""Inherited from an org-wide GlobalPrValidationTriggerRule."""
	ORG_RULE
	"""Neither per-repo nor any matching org rule -- no verdict will be dispatched."""
	NONE
}

"""
First-class PullRequest entity. Owns its own identity at the SCM level
(target VCS + identity string), its own commit list (SCE UUIDs), and
both inbound (release_validation_events) and outbound
(pr_validation_events) event streams.
"""
type PullRequest {
	uuid: ID
	org: ID
	targetVcsRepository: ID
	sourceVcsRepository: ID
	identity: String
	state: String
	title: String
	sourceBranchName: String
	targetBranchName: String
	endpoint: String
	commits: [ID]
	prCreatedDate: DateTime
	closedDate: DateTime
	mergedDate: DateTime
	createdDate: DateTime
	prValidationEvents: [PullRequestValidationEvent]
	releaseValidationEvents: [ReleaseValidationEvent]
	"""
	Releases currently attributed to this PR -- every release whose
	primary sourceCodeEntry is one of the PR's commits, scoped to
	the PR's org. Same logic the aggregator uses to compute the
	PR-level verdict (no dispatch is triggered). Empty when the PR
	has no commits or no releases have been minted against any of
	them yet.
	"""
	attributedReleases: [Release]
	"""
	Hydrated commit list -- SCE rows for every entry in `commits`.
	Order matches `commits` (head is the last element). Used by the
	UI to render the actual git commit SHA / message / author
	instead of just the SCE UUID. Missing SCEs (e.g. one that was
	since archived) are silently dropped.
	"""
	commitDetails: [SourceCodeEntry]
	"""
	Releases referenced by any release_validation_event in this PR's
	history -- superset of attributedReleases. Required so the UI can
	display release names for events whose release has since been
	superseded (newest-per-component attribution drops the older
	release from attributedReleases but its event row remains).
	Distinct on UUID; missing releases (archived) are silently dropped.
	"""
	validatedReleaseDetails: [Release]
	"""
	Latest pr_validation_event verdict whose sourceCodeEntry matches
	the PR's current head commit. Mirrors the aggregator's
	"latest-for-head" lookup so this resolver and the SCM dispatch
	read the same value. {@code null} when the PR has no commits, no
	validation events, or no event for the current head -- UI should
	render that as "pending / not yet validated".
	"""
	currentValidationState: ValidationState
	"""
	Distinct ROOT agents that contributed to this PR -- walks
	`commits → SCE.agent → resolveRoot`. One PR can be attributed to
	multiple agents (different commits from different sessions / keys).
	Empty when no commits carry agentic attribution. Order is by first
	appearance in `commits`.
	"""
	agents: [Agent]
}

type PullRequestValidationEvent {
	date: DateTime
	validationState: ValidationState
	comment: String
	sourceCodeEntry: ID
	attributedReleases: [ID]
}

type ReleaseValidationEvent {
	release: ID
	date: DateTime
	validationResult: ValidationState
}

enum ValidationState {
	SUCCESS
	FAILURE
	NEUTRAL
	SKIPPED
	CANCELLED
	"""
	Internal "verdict not yet computable" state -- recorded on
	pr_validation_events when at least one release attributed to the
	PR has no validation event yet. Never dispatched to the SCM
	(GitHub doesn't have a matching check-run conclusion); the prior
	terminal verdict's check-run stays in place until a new terminal
	verdict supersedes it.
	"""
	PENDING
}

type Branch {
	uuid: ID
	name: String
	"""Locks raised on this branch, active and recently released."""
	locks: [Lock!]
	component: ID
	componentDetails: Component
	components: [ID]
	status: Status
	type: BranchType
	vcs: ID
	vcsBranch: String
	dependencies: [ChildComponent]
	dependencyPatterns: [DependencyPattern]
	effectiveDependencies: [EffectiveDependency]
	org: ID
	versionSchema: String
	marketingVersionSchema: String
	versionType: VersionType
	metadata: String
	hasChildren: Boolean
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	autoIntegrate: AutoIntegrateState
	vcsRepositoryDetails: VcsRepository
	findingAnalyticsParticipation: FindingAnalyticsParticipation
}


type ChildComponent {
	uuid: ID
	status: Status
	branch: ID
	release: ID
	componentDetails: Component
	branchDetails: Branch
	releaseDetails: Release
	isFollowVersion: Boolean
}

type DependencyPattern {
	uuid: ID!
	pattern: String!
	targetBranchName: String
	defaultStatus: Status!
	fallbackToBase: FallbackToBase
}

enum FallbackToBase {
	ENABLED
	DISABLED
}

type EffectiveDependency {
	component: Component!
	branch: Branch!
	status: Status!
	source: DependencySource!
	sourcePattern: DependencyPattern
	release: ID
	releaseDetails: Release
	isFollowVersion: Boolean
}

enum DependencySource {
	MANUAL
	PATTERN
}

type ReleaseCollection {
	uuid: ID
	artifactComparison: ArtifactComparison
}

type ArtifactComparison {
	changelog: ArtifactChangelog
	comparedReleaseUuid: ID
}

type ArtifactChangelog {
	added : [DiffComponent]
	removed: [DiffComponent]
}

type DiffComponent {
	purl: String
	version: String
}

type Release {
	uuid: ID
	version: String
	marketingVersion: String
	status: Status
	lifecycle: ReleaseLifecycleEnum
	"""
	Computed (Distribution): true when this release's component is HARDWARE, or --
	for a product release -- when at least one constituent component release is.
	"""
	hardware: Boolean
	org: ID
	orgDetails: Organization
	component: ID
	componentDetails: Component
	branch: ID
	branchDetails: Branch
	parentReleases: [ParentRelease]
	sourceCodeEntry: ID
	sourceCodeEntryDetails: SourceCodeEntry
	commits: [ID]
	commitTime: DateTime
	commitsDetails: [SourceCodeEntry]
	"""
	Pull requests this release participates in -- any PR whose commits[]
	intersects this release's commits[]. Computed at read time; resolves
	by matching SCE UUIDs.
	"""
	pullRequests: [PullRequest]
	artifacts: [ID]
	artifactDetails: [Artifact]
	inboundDeliverables: [ID]
	inboundDeliverableDetails: [Deliverable]
	tickets: [ID]
	ticketDetails: [Ticket]
	notes: String
	decoratedVersionString: String
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	endpoint: String
	inProducts: [Release]
	vcsRepository: VcsRepository
	tags: [TagRecord]
	approvedEnvironments: [String]
	approvalEvents: [ReleaseApprovalEvent]
	approvalRequests: [ReleaseApprovalRequest]
	variantDetails: [Variant]
	updateEvents: [ReleaseUpdateEvent]
	metrics: DependencyTrackMetrics
	identifiers: [Identifier]
	gudidRecord: GudidRecord
	gudidStatus: GudidStatus
	"""
	Release lifecycle date: the CLE END_OF_SUPPORT projection (TeaTransformerService).
	NOT the device support window -- that is declared on the device model at
	ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
	"""
	eos: String
	"""
	Release lifecycle date: the CLE END_OF_LIFE projection (TeaTransformerService).
	NOT the device support window -- that is declared on the device model at
	ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
	"""
	eol: String
	"""
	Per-release override of the org-level FDA assessment narrative.

	NULL MEANS INHERIT, not empty. Read it through the resolution seam -- release
	value else the org's Settings.fdaAssessmentNarrative -- never on its own: a
	generator reading only this field renders a blank justification section for
	every release that never set one, which is the overwhelming majority.
	"""
	fdaAssessmentNarrative: String
	"""
	Provenance for the release's own eos/eol -- the CLE lifecycle projections, NOT
	the device support window -- DERIVED from the most recent SUPPORT_WINDOW update
	event rather than stored separately. Null on a
	release whose window has never been touched (including one set only at
	release creation before this field existed).
	"""
	supportWindowSource: ProgrammaticType
	# Id of whoever/whatever last touched the window -- a user id for MANUAL, an API key id for API. Not gated by supportWindowSource; use it to tell the two kinds of id apart.
	supportWindowAssertedBy: ID
	# When the window was last touched -- CLE "published" for the resulting endOfSupport/endOfLife event.
	supportWindowLastAssessed: DateTime
	"""
	Component name snapshot captured when a sid PURL was first emitted for this release (D6).
	Immutable once set. Null on releases pre-dating sid enablement and on releases of
	EXTERNAL components.
	"""
	sidComponentName: String
	"""
	Resolved BOM root identifier per the D4 picker: sid PURL > any other PURL >
	release UUID. Always non-null. Used by the UI to display the canonical
	identifier and matches what VDR / OBOM / aggregated-SBOM emit at the BOM root.
	"""
	preferredBomIdentifier: String
	releaseCollection: ReleaseCollection
	"""
	Adjacent releases on this release's own branch / feature set, ordered by
	created date (the same CANCELLED-excluding lineage used for the SBOM-component
	changelog). previousRelease is the release created immediately before this one
	on the branch, nextRelease the one immediately after; both are null at the
	branch's first / last release. Unlike the changelog baseline these do NOT fall
	back to a base-branch fork point -- navigation stays within the same branch.
	Lazily resolved: only queried when selected. Select a light subselection
	(e.g. uuid version lifecycle createdDate) -- used by the release view's
	prev/next navigation arrows.
	"""
	previousRelease: Release
	nextRelease: Release
	intermediateFailedReleases: [IntermediateFailedRelease]
	# True if the release has been queued for SBOM-component reconciliation
	# but the every-minute scheduler hasn't drained it yet. Use to surface a
	# "reconcile pending" indicator in the UI.
	sbomReconcilePending: Boolean
	"""
	Distinct AgentSessions whose commits contributed to this release.
	Walks release.commits -> SCE.agentSession (the forward pointer set
	by the PR 2 commit-trailer parser) and dedupes. Empty list when
	no commits carry agent attribution.
	"""
	sessions: [Session]
}

type IntermediateFailedRelease {
	releaseUuid: ID!
	releaseVersion: String!
	releaseLifecycle: ReleaseLifecycleEnum!
	releaseCreatedDate: DateTime
	commits: [SourceCodeEntry]
}

type Variant {
	uuid: ID
	identifier: String
	identifierPrefix: String
	order: Int
	version: String
	marketingVersion: String
	sku: String
	type: VariantType
	org: ID
	orgDetails: Organization
	release: ID
	outboundDeliverables: [ID]
	outboundDeliverableDetails: [Deliverable]
	notes: String
	endpoint: String
	tags: [TagRecord] 
}


type WhoUpdated {
	createdType: ProgrammaticType
	lastUpdatedBy: String
}

type ParentRelease {
	org: ID
	release: ID
	releaseDetails: Release
}

type SourceCodeEntry {
	uuid: ID
	"""
	Whether anybody can be held to this commit: an enrolled key signed it, a live agent session
	owns it, or somebody has claimed it in an attestation. Computed on demand -- a verdict changes
	when a key is enrolled or revoked and a claim can be revoked later, so a stored flag would be
	wrong quietly. The same predicate rules read as `c.recognized`.
	"""
	recognized: Boolean
	"""What the attestations say about this commit, independently of signature and attribution."""
	attestation: CommitAttestation
	branch: ID
	vcsUuid: ID
	vcsBranch: String
	vcsRepository: VcsRepository
	commit: String
	commits: String
	commitMessage: String
	commitAuthor: String
	commitEmail: String
	vcsTag: String
	notes: String
	org: ID
	dateActual: DateTime
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	artifacts: [ID]
	artifactDetails: [Artifact]
	"""
	Resolved AgentSession this commit was authored under, or null on
	non-agent commits / unresolved trailers. Set by the PR 2
	commit-trailer parser from ReARM-Agentic-Session: on the commit
	message.
	"""
	agentSession: ID
	"""
	Leaf agent that authored the commit (may be a SUB; the session's
	{@code agent} is always the ROOT). Set by the PR 2 commit-trailer
	parser from ReARM-Agent: on the commit message.
	"""
	agent: ID
	"""
	Releases whose primary SCE is this commit. Typically 0 or 1, but
	rebuilds against the same commit produce multiple entries. Each
	release is the natural place the UI can jump to from a commit row.
	"""
	releases: [Release]
	"""
	Latest signature-verification verdict for this commit (or null when
	no signature artifact has been attached). Backed by the
	signature_verifications row pointed at by this SCE -- read-time
	pick of the most-recent verdict for (SCE, subjectUuid). Used by
	CEL via {@code commit.signature.*}.
	"""
	signature: SceSignature
	"""
	Outcome of the agent-attribution trailer resolution for this commit.
	UNATTRIBUTED on non-agent commits; RESOLVED when both trailers parsed
	and the agent / session were found; REJECTED when the trailers were
	present but the claim could not be resolved (malformed clientSessionId,
	unknown agent / session, cross-org, etc.). Used by CEL via
	{@code commit.attribution.state} -- symmetric with
	{@code commit.signature.state} for the unsigned-commit gate.
	"""
	attributionState: AttributionState
	"""
	Human-readable reason explaining a REJECTED attribution. Null on
	UNATTRIBUTED and RESOLVED.
	"""
	attributionReason: String
}

enum AttributionState {
	UNATTRIBUTED
	RESOLVED
	REJECTED
}

type DigestRecord{
	algo: TeaArtifactChecksumType
	digest: String
	scope: DigestScope
}

type Artifact {
	uuid: ID
	displayIdentifier: String
	"""
	Whether the artifact bytes live inside ReARM's blob store (REARM)
	or only as external download links (EXTERNALLY). UI uses this to
	decide whether to render an in-place download button.
	"""
	storedIn: ArtifactStoredIn
	org: ID
	branch: ID
	buildId: String
	buildUri: String
	cicdMeta: String
	digestRecords: [DigestRecord]
	isInternal: ArtifactBelonging
	type: ArtifactType
	bomFormat: BomFormat
	specVersion: SpecVersion
	serializationFormat: SerializationFormat
	notes: String
	tags: [TagRecord]
	tagRecords: [TagRecord]
	dateFrom: DateTime
	dateTo: DateTime
	duration: Long
	packageType: PackageType
	version: String
	publisher: String
	group: String
	dependencies: [ID]
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	internalBom: InternalBom
	downloadLinks: [Downloadlink]
	metrics: DependencyTrackMetrics
	componentUuid: ID
	artifacts: [ID]
	artifactDetails: [Artifact]
	# Rebom-side enrichment status for this artifact's BOM. Null for artifacts
	# without an internalBom (non-BOM types, or BOMs that failed to land in
	# rebom). The UI uses this to render PENDING / COMPLETED / FAILED / SKIPPED
	# pills next to the artifact row.
	enrichmentStatus: EnrichmentStatus
	# Outcome of the VEX import this artifact triggered (VEX artifacts only;
	# null otherwise). Lets the UI report matched / unmatched statement counts
	# instead of leaving the user with a silently empty VEX tab.
	vexImportSummary: VexImportSummary
}

# Counts from a single VEX import, persisted on the VEX artifact that produced
# it. proposalsCreated = statements staged for review (PENDING);
# proposalsAutoAccepted = statements applied immediately; statementsUnmatched =
# statements whose product did not match any component in the release's SBOM
# inventory (these produce no proposal).
type VexImportSummary {
	statementsTotal: Int
	proposalsCreated: Int
	proposalsAutoAccepted: Int
	proposalsAutoRejected: Int
	# Subset of proposalsAutoAccepted whose Finding Analysis write is deferred
	# behind a PENDING MitigationAttestation (conditional claims: environmental
	# justifications like requires_environment, or exploitable-with-workaround).
	attestationsDeferred: Int
	statementsUnmatched: Int
	statementsErrored: Int
	errorMessages: [String]
}

enum EnrichmentStatus {
	PENDING
	COMPLETED
	FAILED
	SKIPPED
}


type DependencyTrackMetrics {
	dependencyTrackFullUri: String
	dtrackSubmissionFailed: Boolean
	dtrackSubmissionAttempts: Int
	dtrackSubmissionFailureReason: String
	dtrackFetchStatus: String
	dtrackFetchFailureCount: Int
	dtrackFetchFailureReason: String
	dtrackFetchSkipUntil: String
	lastScanned: DateTime
	firstScanned: DateTime
	critical: Int
	high: Int
	medium: Int
	low: Int
	unassigned: Int
	vulnerabilities: Int
	vulnerableComponents: Int
	components: Int
	suppressed: Int
	findingsTotal: Int
	findingsAudited: Int
	findingsUnaudited: Int
	inheritedRiskScore: Int
	policyViolationsFail: Int
	policyViolationsWarn: Int
	policyViolationsInfo: Int
	policyViolationsTotal: Int
	policyViolationsAudited: Int
	policyViolationsUnaudited: Int
	policyViolationsSecurityTotal: Int
	policyViolationsSecurityAudited: Int
	policyViolationsSecurityUnaudited: Int
	policyViolationsLicenseTotal: Int
	policyViolationsLicenseAudited: Int
	policyViolationsLicenseUnaudited: Int
	policyViolationsOperationalTotal: Int
	policyViolationsOperationalAudited: Int
	policyViolationsOperationalUnaudited: Int
	vulnerabilityDetails: [Vulnerability]
	violationDetails: [Violation]
	weaknessDetails: [Weakness]
}

type InternalBom {
	id: ID
	belongsTo: String
}

type ExternalBom {
	identifier: String
	version: String
	downloadLinks: [Downloadlink]
	inventoryTypes: [InventoryType]
	bomFormat: String
	date: String
	type: String
	documentType: String
}
type Downloadlink {
	uri: String
	content: String
}

type TagRecord {
	key: String
	value: String
	removable: RemvovableType
}

type Version {
	version: String
	dockerTagSafeVersion: String
	changelog: String
	releaseAlreadyExists: Boolean
	"""
	Lifecycle of the resolved release at the time getNewVersion returned.
	Reflects the state AFTER any synchronous component-trigger run during
	release creation -- so a CEL gate that pre-emptively moves the release
	to REJECTED is visible here. Callers (CLI / CI actions) should abort
	downstream build steps when this is a terminal state (REJECTED,
	CANCELLED) instead of charging into a subsequent addrelease that will
	collide on the (component, version) dedup gate. Null on the
	onlyVersion path (no release row was created).
	"""
	lifecycle: ReleaseLifecycleEnum
}


type ApprovalRole {
	id: String
	displayView: String
}

type ApprovalPolicy {
	uuid: String
	org: String
	policyName: String
	resourceGroup: String
	approvalMappings: [ApprovalMapping]
	approvalEntries: [ID]
	approvalEntryDetails: [ApprovalEntry]
	status: Status
	globalInputEvents: [ReleaseInputEvent]
	globalOutputEvents: [ReleaseOutputEvent]
}

type ApprovalMapping {
	mappingClass: ApprovalMappingClass
	mapTo: String
	approvalEntries: [ID]
}

type ApprovalEntry {
	uuid: ID
	org: ID
	approvalRequirements: [ApprovalRequirement]
	approvalName: String
	status: Status
}

type Perspective {
	uuid: ID
	org: ID
	name: String
	createdDate: DateTime
	type: PerspectiveType
	"""
	Perspective-level sid override (SaaS only, real perspectives only). Null/INHERIT
	defers to the org. Only writeable when the org is in ENABLED_FLEXIBLE.
	"""
	sidPurlOverride: SidPurlOverride
	"""
	Perspective-level decoded authority segments (SaaS only).
	"""
	sidAuthoritySegments: [String!]
	"""Guards applying to every component of this perspective."""
	actionGuards: [ActionGuard!]
}

enum PerspectiveType {
	PERSPECTIVE
	PRODUCT
}

type ApprovalRequirement {
	org: ID
	allowedApprovalRoleIds: [ID]
	allowedApprovalRoleIdExpanded: [ApprovalRole]
	requiredNumberOfApprovals: Int
	permittedNumberOfDisapprovals: Int
}

type ReleaseApprovalEvent {
	approvalEntry: ID
	approvalEntryName: String
	approvalRoleId: ID
	state: ApprovalState
	date: DateTime
	wu: WhoUpdated
	"""
	Optional free-form approver comment, sanitised server-side via
	jsoup's Safelist.basic() (allows simple inline tags, strips
	scripts/styles/event handlers). Capped at 4000 chars at the input
	boundary; empty-after-clean is normalised to null.
	"""
	comment: String
}


"""
One approval request recorded on a release (requestReleaseApprovals).
`resolvedAt` is stamped when every requested entry has reached a terminal
state (satisfied or disapproved); null while the request is open.
"""
type ReleaseApprovalRequest {
	uuid: ID
	requestedBy: ID
	approvalEntries: [ID!]
	requestedAt: DateTime
	resolvedAt: DateTime
}

type ReleaseUpdateEvent {
	rus: ReleaseUpdateScopeEnum
	rua: ReleaseUpdateActionEnum
	oldValue: String
	newValue: String
	objectId: ID
	"""
	Human-readable reason for this event, populated when the
	change carries context the oldValue/newValue tuple cannot
	convey on its own. For LIFECYCLE events fired by a
	component-level CEL input trigger, this carries the trigger
	name and the CEL expression that matched. null for events
	whose meaning is fully captured by the structural fields.
	"""
	message: String
	date: DateTime
	wu: WhoUpdated
}


type ReleaseInputEvent {
	uuid: ID
	name: String
	"""
	Output events fired when {@link #celExpression} evaluates to TRUE.
	"""
	outputEvents: [ID]
	"""
	Output events fired when {@link #celExpression} evaluates to FALSE.
	Optional -- leaving this empty preserves the legacy single-branch
	behavior (rule does nothing when CEL is false). When set, this gives
	operators a way to express "if X then A else B" in one rule instead
	of two competing rules. Both branches are skipped together when the
	rule is disabled or when the component opts out via its
	GlobalInputEventRef.
	"""
	outputEventsOnFalse: [ID]
	scope: EventScope
	celExpression: String
	"""
	Rule-level enable/disable. Defaults true. When false, the rule is
	skipped at evaluation time for every release that resolves against
	the owning approval policy, overriding any per-component
	GlobalInputEventRef.disabled state. Applies identically to component-
	local rules under Component.releaseInputTriggers.
	"""
	enabled: Boolean
	"""
	Optional rule-level precondition CEL. When non-empty, evaluated
	BEFORE {@link #celExpression}; if the precondition returns false
	(or throws), the rule is skipped entirely (neither matched- nor
	else-branch actions fire) and the PR conditions snapshot renders
	PENDING. Lets operators express "is this rule applicable yet?"
	separately from "did the condition match?". Necessary for rules
	with {@link #outputEventsOnFalse} populated because the false
	branch would otherwise fire on releases with missing data --
	canonical example: gate metrics-based rules on
	{@code release.firstScanned == true}.
	"""
	preconditionCelExpression: String
}

type ReleaseOutputEvent {
	uuid: ID
	name: String
	type: EventType
	toReleaseLifecycle: ReleaseLifecycleEnum
	integration: ID
	users: [ID]
	notificationMessage: String
  	vcs: ID
    eventType: String
    clientPayload: String
    celClientPayload: String
    schedule: String
    scope: EventScope
    includeSuppressed: Boolean
    snapshotApprovalEntry: ID
    snapshotLifecycle: ReleaseLifecycleEnum
    approvedEnvironment: String
    """
    Override the check-run name reported to the SCM for EXTERNAL_VALIDATION
    events. Defaults to `rearm/<componentName>` when null/empty. Set this
    when an org-wide branch-protection rule needs a single unified
    required-check entry (GitHub matches by exact string -- no wildcards).
    """
    checkName: String
    """LOCK: the branch this release is on, or the whole component. Defaults to BRANCH."""
    lockScope: LockScope
    """LOCK: who may release the lock this raises. Defaults to HUMAN."""
    lockUnlockLevel: UnlockLevel
    """LOCK: what must be claimed before the lock may be released. Defaults to ANY."""
    lockAttestationRequirement: AttestationRequirement
    """LOCK: shown verbatim in every refusal, so it is written for whoever hits it."""
    lockReason: String
}

type GlobalInputEventRef {
	uuid: ID
	"""
	Opt-out flag -- under the opt-out semantics introduced May 2026, every
	policy rule fires for every component using the policy unless the
	component has a ref with disabled=true. See ComponentData.GlobalInputEventRef.
	"""
	disabled: Boolean
	overrideOutputEventsLocally: Boolean
	outputEventsOverride: [ID]
}

type ApprovalEntryState {
	approvalEntry: ID
	approvalState: ApprovalState
}


enum ViolationType {
	LICENSE
	SECURITY
	OPERATIONAL
}

enum VulnerabilitySeverity {
	CRITICAL
	HIGH
	MEDIUM
	LOW
	UNASSIGNED
}

enum AnalysisState {
	EXPLOITABLE
	IN_TRIAGE
	FALSE_POSITIVE
	NOT_AFFECTED
	RESOLVED
}


# Vulnerability ID types based on OSV schema
# See: https://ossf.github.io/osv-schema/
enum VulnerabilityAliasType {
	CVE       # CVE-YYYY-NNNNN
	GHSA      # GHSA-xxxx-xxxx-xxxx
	GO        # GO-YYYY-NNNN
	PYSEC     # PYSEC-YYYY-NNN
	RUST      # RUSTSEC-YYYY-NNNN
	OSV       # OSV-YYYY-NNN
	DSA       # DSA-NNNN-N (Debian)
	DLA       # DLA-NNNN-N (Debian LTS)
	RHSA      # RHSA-YYYY:NNNN (Red Hat)
	RHBA      # RHBA-YYYY:NNNN (Red Hat Bug Advisory)
	RHEA      # RHEA-YYYY:NNNN (Red Hat Enhancement Advisory)
	ALAS      # ALAS-YYYY-NNNN (Amazon Linux)
	ALAS2     # ALAS2-YYYY-NNNN (Amazon Linux 2)
	ALPINE    # ALPINE-CVE-YYYY-NNNN
	CGA       # CGA-xxxx-xxxx-xxxx (Chainguard)
	MAL       # MAL-YYYY-NNNN (Malicious packages)
	GSD       # GSD-YYYY-NNNNN
	OTHER
}

enum SeveritySource {
	NVD
	GHSA
	ANALYSIS
	OTHER
}

type FindingSourceDto {
	artifact: ID
	release: ID
	variant: ID
	analysisState: AnalysisState
	analysisDate: DateTime
	releaseDetails: Release
	artifactDetails: Artifact
}

type VulnerabilityAliasDto {
	type: VulnerabilityAliasType
	aliasId: String
}

type SeveritySourceDto {
	source: SeveritySource
	severity: VulnerabilitySeverity
}

type Vulnerability {
	purl: String
	vulnId: String
	severity: VulnerabilitySeverity
	aliases: [VulnerabilityAliasDto]
	sources: [FindingSourceDto]
	severities: [SeveritySourceDto]
	analysisState: AnalysisState
	analysisDate: DateTime
	attributedAt: DateTime
	"True when this vulnerability (by CVE id or alias) is in the CISA KEV catalog"
	knownExploited: Boolean
}

type Violation {
	purl: String
	type: ViolationType
	license: String
	violationDetails: String
	sources: [FindingSourceDto]
	analysisState: AnalysisState
	analysisDate: DateTime
	attributedAt: DateTime
}

type Weakness {
	cweId: String
	ruleId: String
	location: String
	fingerprint: String
	severity: VulnerabilitySeverity
	sources: [FindingSourceDto]
	analysisState: AnalysisState
	analysisDate: DateTime
	attributedAt: DateTime
}


type ConditionGroup {
	conditionGroups: [ConditionGroup]
	matchOperator: MatchOperator
	conditions: [Condition]
}

type Condition {
	type: ConditionType!
	approvalEntry: ID
	approvalState: ApprovalState
	possibleLifecycles: [ReleaseLifecycleEnum]
	possibleBranchTypes: [BranchType]
	metricsType: MetricsType
	comparisonSign: ComparisonSign
	metricsValue: Int
	firstScannedPresent: Boolean
}


input CreateComponentInput {
	org: ID
	name: String!
	type: ComponentType!
	defaultBranch: String
	versionSchema: String
	marketingVersionSchema: String
	versionType: VersionType
	featureBranchVersioning: String
	vcs: ID
	vcsRepository: VcsRepositoryInput
	includeApi: Boolean
	approvalPolicy: ID
	identifiers: [IdentifierInput]
	# Distribution module: device classification + profiles + native identifiers.
	nature: ComponentNature
	deviceClass: DeviceClass
	medicalProfile: MedicalProfileInput
	repoPath: String
	branchSuffixMode: BranchSuffixMode
	"""
	Component-level sid override. Only writeable when the org is in ENABLED_FLEXIBLE;
	the mutation layer rejects ENABLE/DISABLE writes otherwise (D3).
	"""
	sidPurlOverride: SidPurlOverride
	"""
	Component-level authority segments. May be set even when sidPurlOverride is INHERIT --
	the segments only take effect once a higher level enables sid for this component.
	"""
	sidAuthoritySegments: [String!]
	"""
	Whether this component is the tenant's own software (INTERNAL) or a tracked
	third-party dependency (EXTERNAL). Defaults to INTERNAL when null. EXTERNAL
	components never receive a platform-stamped sid PURL (D16).
	"""
	isInternal: BelongsToOrganization
}


input VcsRepositoryInput {
	org: ID
	name: String
	uri: String
	type: String
}


input SourceCodeEntryInput {
	branch: ID
	vcs: ID
	organizationUuid: ID
	uri: String
	type: String
	commit: String
	commits: [String]
	commitMessage: String
	commitAuthor: String
	commitEmail: String
	vcsTag: String
	dateActual: String
	vcsBranch: String
	notes: String
	artifacts: [ArtifactInput]
}


input TagRecordInput {
	key: String
	value: String
}

input DeliverableInput {
