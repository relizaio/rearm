#
# AI-Agent monitoring types. Backed by rearm.agents +
# rearm.agent_sessions + rearm.model_ontologies (V37 + V38). Shared
# (CE-included) GraphQL surface; policies / enforcement that wrap
# these arrive in PR 4 behind the SAAS package boundary. Full design
# rationale in backend/ai-plans/agentic/README.md.
#

"""
A coding agent registered to an org. ROOT agents are what an
external tool registers as and own sessions; SUB agents are
children a ROOT spawns and share the parent's session.

Identity = (org, lower(name)). Auto-registered on the first session
a calling FREEFORM key opens with a previously-unknown name in the
org. {@code model} points to a ModelOntology row carrying the
publisher / model / version / CycloneDX ML-BOM model card -- many
agents may share a model.
"""
type Agent {
	uuid: ID
	org: ID
	"""
	Registration key supplied by the runtime via --agent-name. Part of
	the (org, agentIdentity, lower(name)) resolution key -- treat as
	immutable. User-facing renames go through displayName.
	"""
	name: String
	"""
	Optional admin-chosen label shown in the UI in place of name. Falls
	back to name when null. Cosmetic only -- never used for resolution
	or uniqueness.
	"""
	displayName: String
	"""
	Resolved label the UI should render. Precedence (strongest last):
	name → first bound FREEFORM key note → displayName. I.e.
	displayName if set, else the note on a bound FREEFORM key, else name.
	Read-only -- set displayName to override.
	"""
	effectiveDisplayName: String
	"""ModelOntology row this agent runs."""
	model: ModelOntology @deprecated(reason: "Model is a property of the chat, not the durable agent. Read Session.primaryModel instead; this returns the agent's last-seen declared model as a transitional fallback.")
	"""Optional dashboard glyph."""
	iconKind: String
	"""Optional dashboard accent colour (CSS hex)."""
	color: String
	"""Free-form notes the user sets on the dashboard."""
	notes: String
	"""
	AgentIdentity row that scopes this agent. (org, agentIdentity,
	lower(name)) is the uniqueness boundary -- two different identities
	can each own a "Claude Code". SUB agents inherit their root's
	identity.
	"""
	agentIdentity: ID
	status: AgentStatus
	agentType: AgentType
	"""ROOT for top-level agents; SUB pointers point at the owning root."""
	rootAgent: ID
	"""Direct children spawned by this agent (best-effort report)."""
	subAgents: [ID]
	createdDate: DateTime
	# --- monitoring read-side (PR 3) ---
	"""
	OPEN sessions owned by this ROOT agent. Empty list on SUB agents
	(sub-agents do not own sessions). Returns the same ordering as
	{@code sessionsOfAgent} -- most recently active first.
	"""
	openSessions: [Session]
	"""
	CLOSED sessions owned by this ROOT agent. Same ordering as
	{@code openSessions}.
	"""
	closedSessions: [Session]
	"""
	Open + closed session counts for this agent. Cheaper than walking
	the full lists when the dashboard only needs the badges.
	"""
	sessionCounts: AgentSessionCounts
	"""
	Most-recent activity timestamp across all sessions this agent
	owns. Drives the dashboard "connected" pill. Null when the agent
	has no sessions yet.
	"""
	lastActivityAt: DateTime
	"""
	Enrolled public keys this agent signs commits with. Includes
	revoked entries -- UI filters by revokedAt for display, the
	verifier filters at lookup time.
	"""
	signingKeys: [SigningKey]
	"""
	FREEFORM API keys bound to this agent's identity
	(agent_identity_credentials of type REARM_API_KEY). These are the
	keys an agent runtime authenticates with to drive this agent.
	"""
	boundApiKeys: [ApiKey]
}

type AgentSessionCounts {
	openSessions: Int
	closedSessions: Int
}

"""
A single agent-policy evaluation outcome on a session. SAAS-only --
on CE deployments the session's {@code policyEvents} list is always
empty. Persisted append-only on AgentSession.
"""
type PolicyEvent {
	"""UUID of the AgentPolicy that produced this verdict."""
	policyUuid: ID
	"""Snapshot of the policy's name at evaluation time (denormalised so a renamed/deleted policy still surfaces sensibly)."""
	policyName: String
	kind: PolicyKind
	severity: PolicySeverity
	state: PolicyState
	"""Operator-facing failure message; null on PASSED verdicts."""
	message: String
	evaluatedAt: DateTime
	"""
	Full snapshot of the AgentPolicy that produced this verdict (CEL,
	description, current enabled flag). Lets a calling agent decide
	whether the failure is recoverable on its own (e.g. attach an
	orientation artifact and retry) or needs operator action (e.g.
	a "model must equal claude-opus" policy when the agent runs
	another model). Resolved at read time from the policyUuid; null
	if the policy was deleted after the event.
	"""
	policy: AgentPolicy
}

enum PolicyKind {
	"""Evaluated on session initialize + on artifact attach."""
	INPUT
	"""Evaluated on commit attribution and on artifact attach. Verdict locks at commit-attribution time."""
	OUTPUT
	"""
	Stays AWAITING through the entire session lifetime; verdict locks
	only at session close. Use when the gate depends on an artifact
	the agent doesn't file until its final step -- for example, a
	FINAL agentic-report tag that by definition arrives after the
	last commit. OUTPUT in that case would harden to FAILED before
	the report ever lands.
	"""
	CLOSE
}

enum PolicySeverity {
	"""Input failure rejects session init."""
	BLOCK
	"""Failure is recorded as a WARNING verdict; never throws."""
	WARN
}

enum PolicyState {
	PASSED
	WARNING
	FAILED
	"""
	Soft signal: the policy hasn't reached a terminal verdict for this
	session yet. Emitted at session init / artifact attach for OUTPUT
	policies that haven't been satisfied, and as a fallback when the
	evaluator hits a runtime error (the policy will be retried at the
	next eligible event). Renamed from PENDING to avoid name collision
	with rebom's EnrichmentStatus.PENDING in adjacent code.
	"""
	AWAITING
}

"""
SAAS-only AI-Agent policy. CEL expression evaluates against the
session context -- {@code session.*}, {@code agent.*},
{@code model.*}. **Match-to-block semantics** (same as component-level
CEL gates): the CEL describes the *failure* condition. Returns true
when the failure matches → the verdict on the session goes to FAILED
/ WARNING / PENDING per {@link #severity} + {@link #kind}. Returns
false → PASSED.
"""
type AgentPolicy {
	uuid: ID
	org: ID
	name: String
	description: String
	kind: PolicyKind
	severity: PolicySeverity
	"""CEL boolean expression -- true means the failure matches."""
	cel: String
	enabled: Boolean
	createdDate: DateTime
}


# ===== Distribution module (SAAS-only) -- Client + Site =====


"""821 disposition lifecycle of a shipped (tracked) unit."""
enum Disposition {
	SHIPPED
	RECEIVED
	RETURNED
	EXPLANTED
	DISPOSED
	DONATED
	LOST
}

"""Where an actual report came from."""
enum ReportSource {
	PHONE_HOME
	MANUAL
	SUPPORT_TICKET
}

"""821 tracking block -- meaningful for MEDICAL_TRACKED devices only. Per-device."""
type TrackingRecord {
	receivedDate: String
	patientId: String
	disposition: Disposition
	dispositionDate: String
}


"""Phone-home / observed actual state (optional, expected-empty). Per-device."""
type ActualReport {
	reportedRelease: ID
	reportedAt: DateTime
	source: ReportSource
}


"""Expected/asserted state of a device (defaults from its shipment's release)."""
type DevicePlan {
	expectedRelease: ID
}


"""
An individual fielded unit -- the optional per-unit layer below a shipment.
Instance-like: plan (expected version) vs actual (phone-home) + 821 tracking.
"""
type Device {
	uuid: ID
	org: ID
	"""Soft-delete marker: ARCHIVED rows are hidden from listings."""
	status: Status
	shippedProduct: ID
	site: ID
	"""Unit-level identifiers (SERIAL, UDI, UDI-PI, ...)."""
	identifiers: [Identifier]
	plan: DevicePlan
	actual: ActualReport
	tracking: TrackingRecord
	"""Latest reconciled software state (digital twin, software side)."""
	observedState: ObservedState
	notes: String
	"""Computed: observed version diverges from the device's expected release."""
	versionDrift: Boolean
	createdDate: DateTime
	"""
	The device support window that applies to this unit (D7): its shipment's override if
	that batch has one, else the product component's declaration, with the level it came
	from. This is the window the fleet evaluation measures the unit's software against.
	"""
	effectiveDeviceSupportWindow: ResolvedDeviceSupportWindow
}


"""Physical-ness axis of a component (Distribution module)."""
enum ComponentNature {
	SOFTWARE
	HARDWARE
}

"""UDI issuing agency (Distribution module)."""
enum IssuingAgency {
	GS1
	HIBCC
	ICCBBA
}

"""GUDID submission workflow state for a UDI-bearing release."""
enum GudidStatus {
	NOT_SUBMITTED
	SUBMITTED
	PUBLISHED
}

"""Stable GUDID descriptors carried at component level, inherited by releases."""
type GudidDefaults {
	brandName: String
	companyName: String
	gmdnCode: String
}

input GudidDefaultsInput {
	brandName: String
	companyName: String
	gmdnCode: String
}

"""Version-specific GUDID record for a UDI-bearing release."""
type GudidRecord {
	brandName: String
	versionModel: String
	gmdnCode: String
	sterile: Boolean
	singleUse: Boolean
	mriSafety: Boolean
}

input GudidRecordInput {
	brandName: String
	versionModel: String
	gmdnCode: String
	sterile: Boolean
	singleUse: Boolean
	mriSafety: Boolean
}

"""Regulatory metadata for a medical-device component."""
type MedicalProfile {
	issuingAgency: IssuingAgency
	udiBearing: Boolean
	gudidDefaults: GudidDefaults
	"""
	The section 524B device support window declared for this device model (decision D7).

	Null means NOT DECLARED, which is a fact in its own right rather than an unknown to
	fill in. This is the DEVICE window; it is not Release.eos/eol, which are release
	lifecycle for TEA/CLE and are unrelated to a support commitment.
	"""
	deviceSupportWindow: DeviceSupportWindow
}

input MedicalProfileInput {
	issuingAgency: IssuingAgency
	udiBearing: Boolean
	gudidDefaults: GudidDefaultsInput
}

"""
A manufacturer's declared section 524B support window for a device (decision D7).

Declared on the PRODUCT COMPONENT (the device model), optionally overridden per
ShippedProduct (a batch), and evaluated per Device (a unit). `eos` and `eol` are SEPARATE
FACTS and are never merged: under D5, `eol` means END OF SALE, which is not a support
horizon -- only `eos` is.
"""
type DeviceSupportWindow {
	"""Section 524B end of support: the device horizon. Null = not declared."""
	eos: String
	"""End of SALE per CycloneDX and D5, NOT a support horizon. Null = not declared."""
	eol: String
	"""The user who asserted this window."""
	assertedBy: ID
	"""When the assertion was made, as a UTC RFC-3339 instant. Caller-supplied."""
	assessedAt: String
	"""How it arrived: a human in the UI, an API caller, an automation."""
	source: ProgrammaticType
}


"""Which level a resolved device window was declared at."""
enum DeviceWindowSource {
	"""The product component -- the device model's default."""
	COMPONENT
	"""The shipment -- this batch differs from the model."""
	SHIPMENT
}

"""
A window resolved for a shipment or a unit, with the level it came from.

The source matters to a generated document: a Device Support Statement produced from a
batch must be able to say whether the dates are the model's default or this batch's
override, because a reader comparing two statements for the same model needs to know why
they differ.

Null when the model declares nothing and the batch has not overridden it. A batch that
overrode the model with NO window is reported as an object with both dates null and source
SHIPMENT -- a statement the batch made, distinct from the model's silence.
"""
type ResolvedDeviceSupportWindow {
	eos: String
	eol: String
	source: DeviceWindowSource
}

"""Regulatory classification of a component / device (Distribution module)."""
enum DeviceClass {
	NONE
	MEDICAL_UNTRACKED
	MEDICAL_TRACKED
}


enum AgentStatus {
	ACTIVE
	ARCHIVED
}

enum AgentType {
	ROOT
	SUB
}

"""
One ROOT Agent invocation. Many concurrent sessions per agent are
allowed on the same API key. Sub-agents of the root contribute
commits / artifacts to the same session via the commit-trailer
attribution path (PR 2).
"""
type Session {
	uuid: ID
	org: ID
	"""Owning ROOT agent uuid."""
	agent: ID
	"""
	Agent-supplied natural session id. Defaults to the row uuid when
	the agent didn't pick one on initialize. The two-line commit
	trailer references this value, not the row uuid.
	"""
	clientSessionId: String
	"""API key the agent used to open the session."""
	apiKey: ID
	title: String
	status: SessionStatus
	startedAt: DateTime
	closedAt: DateTime
	lastActivityAt: DateTime
	"""Artifact UUIDs attached to this session (reuses rearm.artifacts)."""
	artifacts: [ID]
	"""
	SCE UUIDs attributed to this session via the commit-trailer parser
	(PR 2). Order is append-order; head of list is the earliest commit.
	"""
	commits: [ID]
	"""
	Append-only log of agent-policy evaluations (PR 4). Empty on CE
	deployments and on sessions opened under an org with no policies.
	"""
	policyEvents: [PolicyEvent]
	"""
	Releases produced from this session's commits. Computed at read
	time by walking `commits → Release.sourceCodeEntry` (and
	`commits[]` for multi-commit releases). Distinct on release uuid.
	"""
	releases: [Release]
	"""
	Pull requests touched by this session's commits. Computed at read
	time by walking `commits → PullRequest.commits[]`. Distinct on
	PR uuid.
	"""
	pullRequests: [PullRequest]
	"""
	If this session was opened by an agent retrying after a prior
	BLOCKED / CLOSED predecessor, this is that predecessor's uuid.
	Null on first-time sessions.
	"""
	parentSession: ID
	"""
	The AI model this session ran. The model is a property of the chat,
	not the durable agent -- set from the agent's declared model on
	initialize. Null on legacy sessions written before per-session model
	tracking existed. Prefer this over the deprecated Agent.model.
	"""
	primaryModel: ModelOntology
	"""
	How much trust primaryModel carries. DECLARED = the agent self-
	reported the model string (the only source today). RUNTIME_OBSERVED is
	reserved for host-side hooks that read the model from the runtime's own
	record; not yet emitted. The UI must not imply the model carries the
	session signature's authority.
	"""
	modelAssertion: ModelAssertionState!
	createdDate: DateTime
}

"""
How much trust a session's recorded model carries -- see
Session.modelAssertion.
"""
enum ModelAssertionState {
	"""Agent self-reported the model string via the CLI; trusted but unverified."""
	DECLARED
	"""Model read from the runtime's own record (e.g. Claude Code transcript). Reserved for Path-B hooks; not yet emitted."""
	RUNTIME_OBSERVED
}

enum SessionStatus {
	OPEN
	CLOSED
	"""
	A BLOCK-severity INPUT policy failed on sessionInitializeProgrammatic.
	The row is persisted so the audit / dashboard show the rejected
	attempt with its policyEvents, but the trailer-attribution
	resolver refuses to bind commits against it -- trailers carrying
	this clientSessionId surface as REJECTED attribution. Terminal:
	the agent must mint a fresh, unique clientSessionId to retry.
	"""
	BLOCKED
}

"""
A row describing one AI/ML model an Agent runs. Identity =
(org, lower(name), version). Carries publisher + a full CycloneDX
ML-BOM model card (opaque jsonb). Auto-upserted on session
initialize from (agentVendor, agentModel, agentModelVersion).
"""
type ModelOntology {
	uuid: ID
	org: ID
	"""Model name, e.g. "claude-sonnet"."""
	name: String
	"""Model version, e.g. "4.5". Defaults to "unknown" on auto-registration when omitted."""
	version: String
	"""Publisher / vendor (e.g. "Anthropic"). Display-only."""
	publisher: String
	"""One-line summary for the dashboard tooltip."""
	description: String
	"""Optional canonical id (e.g. "pkg:huggingface/anthropic/claude-sonnet@4.5")."""
	purl: String
	"""
	CycloneDX ML-BOM model component (type machine-learning-model)
	stored opaquely. Empty {} on auto-registration; the user attaches
	a fuller card later via setModelOntologyModelCardProgrammatic.
	"""
	modelCard: Object
	notes: String
	createdDate: DateTime
}


# ============================================================
# Signature verification -- commit-level signatures (v1: SSH, GPG).
# Image / SBOM / X.509 land in v2. See backend/ai-plans/agentic/README §11.4.
# ============================================================


"""
Enrolled public key bound to an Agent or Committer. The verifier
matches signatures by fingerprint to this row and never trusts the
key embedded in a signature blob.
"""
type SigningKey {
	uuid: ID
	org: ID
	format: SignatureFormat
	ownerType: SigningKeyOwnerType
	ownerUuid: ID
	"""Normalised fingerprint -- SHA256:... for SSH, long key id for GPG."""
	fingerprint: String
	"""Principal string ssh-keygen expects via -I, or GPG user-id."""
	identity: String
	"""Wire-format pubkey -- single line SSH, ASCII-armoured GPG."""
	pubKey: String
	createdDate: DateTime
	revokedAt: DateTime
}

enum SignatureFormat {
	SSH
	GPG
	"""Reserved for v2 -- trust anchored at CA, not per-key."""
	X509
}

enum SigningKeyOwnerType {
	AGENT
	COMMITTER
}


enum SignatureVerificationState {
	"""No signature artifact attached."""
	UNSIGNED
	"""Cryptographic check passed and signer resolved to an enrolled key."""
	VERIFIED
	"""Cryptographic check failed."""
	INVALID_SIGNATURE
	"""Signature parsed but the signer key is not enrolled in this org."""
	UNKNOWN_KEY
	"""Signer key was matched but is revoked."""
	KEY_REVOKED
	"""Reserved for v2 -- attribution constraint failure decoupled from trust-store scope (e.g. image / attestation flows where the verifier's scope and the expected attribution can legitimately differ). Not produced in v1; the verifier narrows scope upfront from the SCE so a mismatched owner can't reach this branch."""
	WRONG_SIGNER
	"""Verification was scheduled but has not yet run."""
	PENDING
	"""Verifier subprocess errored -- see {@code details} for diagnostics."""
	ERRORED
}

"""
Compact CEL-facing view of an SCE's signature verdict. Surfaced as
{@code SourceCodeEntry.signature}; the underlying row lives in
signature_verifications.
"""
type SceSignature {
	state: SignatureVerificationState
	format: SignatureFormat
	signedByOwnerType: SigningKeyOwnerType
	signedByOwnerUuid: ID
	verifiedAt: DateTime
	keyFingerprint: String
}


# ===== Digital twin (Distribution) -- field events + observed software state =====


enum ObservedItemStatus {
	MATCHED
	DRIFTED
	FOREIGN_COMPONENT
	UNKNOWN
}

"""One reconciled observed item (e.g. a running container image digest)."""
type ObservedItem {
	identifier: String
	digest: String
	status: ObservedItemStatus
	deliverable: ID
	component: ID
	componentName: String
	observedRelease: ID
	observedVersion: String
	expectedRelease: ID
	expectedVersion: String
}

"""Latest observed software state, reconciled against the expected release tree."""
type ObservedState {
	reportedAt: DateTime
	source: ReportSource
	items: [ObservedItem]
	matchedCount: Int
	driftedCount: Int
	unknownCount: Int
}

input ObservedDigestInput {
	identifier: String
	digest: String!
}

"""
Programmatic phone-home payload: observed digests (structured) and/or a raw
text blob (e.g. a k8s image list) the backend extracts digests from.
"""
input DeviceStateReportInput {
	device: ID!
	source: ReportSource
	observed: [ObservedDigestInput]
	rawText: String
}


# ---------------------------------------------------------------------------
# Declarative configuration (GitOps-style). One spec kind per ownership slice;
# a file is authoritative only for what it declares. Apply is idempotent and
# keyed by name; cross-references (component, branch, release) go by name and
# are resolved at apply time. Rows stay the source of truth; provenance of the
# last apply is stamped on each touched row. Pruning of rows absent from a
# spec is governed by the org-wide Settings.declarativePrune (never by the
# spec itself).
# ---------------------------------------------------------------------------

"""How rows absent from an applied spec are treated. LEAVE (default) reports them; ARCHIVE archives them."""
enum DeclarativePruneMode {
	LEAVE
	ARCHIVE
}

"""What has been claimed about a commit, and by whom."""
type CommitAttestation {
	"""
	NONE, MINE, NOT_MINE, or CONFLICT when two different principals each say it is theirs.
	One principal's latest word replaces their earlier one, so disowning and then claiming is
	a correction rather than a conflict.
	"""
	state: String
	"""USER or AGENT, for the claim that made it accountable."""
	actorType: String
	actor: ID
	"""Who that is, by name -- an email for a user, the agent's name for an agent."""
	actorName: String
	"""When the standing claim was made."""
	claimedAt: DateTime
	"""Why it stands as it does: "signed by an enrolled key", "unsigned, no attribution"."""
	detail: String
	"""
	Where each principal stands now, latest word per principal, newest first. This is what a
	contested commit needs to be resolvable: who says what, and which row to revoke.
	"""
	claims: [CommitClaim]
}

"""One principal's standing statement about a commit."""
type CommitClaim {
	"""The attestation row, so it can be revoked by whoever needs to withdraw it."""
	uuid: ID
	"""MINE or NOT_MINE."""
	verdict: String
	"""USER or AGENT."""
	actorType: String
	actor: ID
	"""Who that is, by name."""
	actorName: String
	note: String
	createdDate: DateTime
}

"""
A sticky refusal of writes on a component or one of its branches.

Every other gate in ReARM evaluates a point in time, so a rule about a commit is defeated by
pushing another commit on top of it. A lock is the state that outlives the build: it refuses the
next one outright and stays until somebody resolves the cause and says so on the record.
"""
type Lock {
	uuid: ID
	scope: LockScope
	"""Set when scope is BRANCH."""
	branch: ID
	status: LockStatus
	"""Shown verbatim in every refusal."""
	reason: String
	origin: LockOrigin
	"""POLICY: the output event that raised it, which is also its idempotence key."""
	outputEvent: ID
	causes: [LockCause!]
	"""
	Causes dropped by the retention cap. Above zero the checklist is incomplete, so the lock will
	not release itself automatically however many causes are claimed.
	"""
	droppedCauses: Int
	unlockLevel: UnlockLevel
	attestationRequirement: AttestationRequirement
	"""
	The strongest level any cause has ever implied, kept because that cause may since have been
	dropped. A floor, never lowered.
	"""
	escalatedLevel: UnlockLevel
	"""Declared level and escalation floor combined -- who may actually release it."""
	effectiveLevel: UnlockLevel
	raisedAt: DateTime
	releasedAt: DateTime
	"""The LOCK_RELEASE attestation that released it."""
	releaseAttestation: ID
	"""
	Where the lock lives. A lock is stored inside its component or branch row, so these come from
	the read rather than from the record -- without them an organization-wide list of locks could
	not say what any of them was about.
	"""
	component: ID
	componentName: String
	branchName: String
}

"""One thing a lock is waiting on."""
type LockCause {
	subjectType: LockSubjectType
	subjectUuid: ID
	"""Human text carried into the refusal, e.g. "commit a1b2c3d: unsigned, no attribution"."""
	detail: String
}

enum LockScope { COMPONENT BRANCH }
enum LockStatus { ACTIVE RELEASED }
enum LockOrigin { MANUAL POLICY }
enum LockSubjectType { SCE RELEASE }

"""Who may release a lock."""
enum UnlockLevel {
	"""Any recognized principal, agent or user, through either API."""
	AGENT
	"""A user; an agent cannot."""
	HUMAN
	"""A component or organization administrator."""
	ADMIN
}

"""What must be true of a lock's causes before it may be released."""
enum AttestationRequirement {
	"""Nothing; the level alone decides."""
	NONE
	"""Every cause carries an active MINE attestation from any recognized principal."""
	ANY
	"""Every cause carries an active MINE attestation filed by a user."""
	HUMAN
}

"""
An accountable statement by a user or an agent. Append-only: a correction is a new row plus a
revocation of the old one, because a record that can be edited afterwards is not one.
"""
type Attestation {
	uuid: ID
	org: ID
	type: AttestationType
	subjectType: AttestationSubjectType
	subjectUuid: ID
	subjectRef: AttestationSubjectRef
	actorType: AttestationActorType
	actorUuid: ID
	"""AGENT: the session it was filed under."""
	agentSession: ID
	verdict: AttestationVerdict
	note: String
	"""LOCK_RELEASE: released without the requirement being met. Never silent."""
	override: Boolean
	status: AttestationRecordStatus
	revokedAt: DateTime
	revokeReason: String
	createdDate: DateTime
}

"""What the subject was called when the statement was made; display only."""
type AttestationSubjectRef {
	component: ID
	componentName: String
	commit: String
	version: String
}

enum AttestationType { COMMIT_ACKNOWLEDGEMENT LOCK_RELEASE }
enum AttestationSubjectType { SCE RELEASE LOCK }
enum AttestationActorType { USER AGENT }
enum AttestationRecordStatus { ACTIVE REVOKED }

"""
Verdicts of a commit acknowledgement. MINE makes a commit recognized; it does not certify the
content and is not a review. NOT_MINE leaves it unrecognized and escalates every lock it is a
cause of.
"""
enum AttestationVerdict { MINE NOT_MINE }


"""
One named rule withholding an action until its CEL expression holds.

Guards accumulate rather than override: every guard that applies to an action is evaluated, any
one of them can refuse, and the refusal names the guard that did it. A guard is the mirror of a
release trigger -- same expression language, same release.* variables, plus action.* describing
what is being attempted -- but where a trigger makes something happen, a guard only refuses.
"""
type ActionGuard {
	"""Names the guard in refusals and in the note a WARN guard leaves behind."""
	name: String
	action: GuardedAction
	"""CEL over release.* and action.*; the action proceeds only while this is true."""
	cel: String
	mode: GuardMode
	"""
	Java regex matched FULLY against the component name -- `guard-prod` governs the component
	named exactly that, not `guard-prod-api`; write `guard-prod.*` for a prefix. Same anchoring
	as the org's approval-policy and team-assignment rules. Meaningful only on organization-wide
	guards; guards written on a component or a perspective leave it null and are refused if they
	set it.
	"""
	namePattern: String
}


"""An action a guard can withhold. New actions bring their own action.* variables."""
enum GuardedAction {
	"""Moving a release forward through its lifecycle, however the move was requested."""
	RELEASE_PROMOTION
}

"""What happens when a guard is not satisfied."""
enum GuardMode {
	"""Kept but not evaluated."""
	OFF
	"""The action proceeds; the failure is recorded against it."""
	WARN
	"""The action is refused, naming the guard."""
	BLOCK
}

