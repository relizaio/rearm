}

type SbomChangesWithAttribution {
	artifacts: [ArtifactWithAttribution!]!
	totalAdded: Int!
	totalRemoved: Int!
}

# Canonical SBOM component identity shared across releases. canonicalPurl is
# the purl with qualifiers and subpath stripped; name / group / version /
# type are cached from the purl for quick display and filtering. isRoot is
# true when at least one uploaded BOM had this component as its
# metadata.component (the "subject" of the BOM).
type SbomComponent {
	uuid: ID!
	canonicalPurl: String!
	type: String
	group: String
	name: String
	version: String
	isRoot: Boolean
	# FDA-Readiness-1 per-component support disclosure. Dates + provenance live per-milestone
	# (see supportMilestones); supportStatus is DERIVED from them and the current date (never
	# stored). Dates are ISO-8601 (YYYY-MM-DD); supportLastAssessed is a UTC RFC-3339 instant.
	# supportNotes is internal-only (shown to authorized org users, never injected into an
	# export). endOfSupportDate/endOfLifeDate/supportSource/supportLastAssessed/supportNotes
	# are BACK-COMPAT convenience fields meaning "the END_OF_SUPPORT milestone's own values" --
	# not a component-wide value now that provenance is per-milestone; use supportMilestones
	# for the full per-date detail (e.g. an EOL asserted from a different source than EOS).
	supportStatus: SupportStatus
	# The manufacturer's ATTESTED level of support: what the upstream maintainer is actually
	# doing. Stored, not computed -- see SupportStatus. DELIBERATELY SEPARATE from
	# supportStatus, which is what the dates entail. When they disagree (a far-future EOL on
	# a library abandoned in practice), both are served and a reviewer judges; reconciling
	# them server-side would discard the disagreement, which is the signal worth having.
	# Never consume this without assessedAt: an undated claim cannot be weighed.
	attestedLevelOfSupport: LevelOfSupport
	# The same claim in FDA's own words, lowercase and verbatim ("actively maintained"),
	# which is what the guidance and CycloneDX taxonomy PR #186 expect on the wire.
	#
	# Today this happens to equal name().toLowerCase().replace('_',' '), so it looks like a
	# transform a client could do itself. Do NOT rely on that: the mapping is a deliberate
	# per-constant table precisely so a guidance revision changing FDA's wording is a
	# one-line server change rather than a break in every consumer that reimplemented the
	# rule. The coincidence holds for these three values and is not a contract.
	attestedLevelOfSupportText: String
	# When the HUMAN assessed (RFC-3339, UTC). Caller-supplied, so it may precede the moment
	# the attestation was filed; the system's own record time lives in the audit history.
	assessedAt: String
	# The user who made the attestation.
	assertedBy: ID
	# The manufacturer's stated basis for the claim -- what they checked and what they found.
	# The part a reviewer actually reads when the dates are absent or contested.
	justification: String
	# ATTESTED or WITHDRAWN. A WITHDRAWN attestation is retracted: it keeps its history but
	# is not injected into exports, so it reads as unassessed rather than as a live claim.
	attestationState: SupportState
	endOfGuaranteedSupportDate: String
	endOfSupportDate: String
	endOfLifeDate: String
	supportSource: SupportSource
	supportLastAssessed: String
	supportNotes: String
	# Full per-milestone detail: independent date + provenance for each milestone actually
	# asserted (0-3 entries). notes is internal-only here too, never exported.
	supportMilestones: [SupportMilestone!]!
	# Whether the manufacturer is the FIRST party for this component (its own device/release)
	# or a THIRD party making a claim about a component it has no operational control over
	# (e.g. log4j). Null means UNKNOWN -- never inferred from isRoot. Orthogonal to
	# supportSource: a supplier-provided BOM asserting a date for the org's OWN in-house
	# library is a first-party fact learned through a supplier channel, not a third-party one.
	supportParty: SupportParty
	# DERIVED (never stored): does this component's declared support window end before the
	# enclosing DEVICE's support horizon? The horizon is the DEVICE WINDOW resolved by
	# DeviceLifecycleResolver (device model, or the batch override where there is one) --
	# NOT the release's own eos, which is a CLE lifecycle projection. UNKNOWN for
	# non-PRODUCT releases, org-scoped reads, or when a horizon is missing.
	deviceSupportRisk: DeviceSupportRisk
}

input SbomComponentSearchInput {
	name: String!
	version: String
}

# A bulk attestation's outcome. The counts are derived server-side from results, so a
# client rendering "312 applied, 138 skipped" and a client iterating the list cannot
# disagree about the same run.
type SbomComponentSupportBulkResponse {
	results: [SbomComponentSupportBulkResult!]!
	appliedCount: Int!
	skippedCount: Int!
	failedCount: Int!
	# Correlates every audit row this call wrote. SERVER-minted; pass it back as the
	# batchId argument on batches 2..n of a paged sweep so the whole sweep is one id in
	# the audit history. Without it nothing in the record distinguishes an 800-component
	# sweep from 800 separate judgements -- assessmentSource is MANUAL either way.
	# Always present, including on an empty call.
	batchId: ID!
}

# One component's outcome from a bulk attestation.
type SbomComponentSupportBulkResult {
	sbomComponentUuid: ID!
	outcome: SupportBulkOutcome!
	# Why, when the outcome is FAILED; null otherwise. Deliberately never echoes the
	# attestation content back -- a caller that treats the response as confirmation of what
	# was stored is not re-reading, and the stored value is the one that matters.
	message: String
}

type SbomComponentSupportCoverage {
	total: Int!
	attested: Int!
	"""
	Whether this org's BOM exports actually CARRY the support properties these counts
	describe. Returned by the SAME resolver as the counts, deliberately: a client that
	fetched coverage and export state separately could render a full-coverage gauge beside
	an export that silently carries nothing, and that combination is precisely the failure
	a default-off export setting creates. One response, one resolver, cannot drift.

	An ENUM rather than a Boolean because an export setting is the kind of field that grows
	a third state -- inherited from a parent scope, per-release override, enabled-but-nothing
	-to-inject -- and this schema is published verbatim to the Community Edition, where a
	Boolean could not grow one without breaking clients. Same shape as sidPurlMode, which
	models org-level configuration the same way.

	Reads the org's supportInjection setting: ENABLED or DISABLED as configured, and UNKNOWN
	when the organization row cannot be read. Unset counts as DISABLED -- off is the default,
	so support properties do not appear in an export unless someone asks for them.

	It is the SAME predicate that gates every egress -- the native single-artifact download,
	the SPDX-augmented download and the merged release export -- so this field cannot report
	one thing while an export does another. The raw artifact download is the exception: it is
	swept for forged reliza:* provenance and marked, but never injected into, on any setting.

	That strip is unconditional everywhere and is NOT governed by this field. A security
	control and a content choice are not the same switch: turning injection off never stops
	us removing an uploader's forged attribution.

	UNKNOWN is a real answer, not a placeholder: once this reads a stored setting, that
	setting can be absent or unreadable, and saying so beats guessing. Clients must render
	UNKNOWN as unknown and must NOT collapse it to either state -- a gauge that silently
	assumes exports carry disclosures is the failure this field exists to prevent.

	NON-NULL deliberately. UNKNOWN carries "not determined" in band, so allowing null too
	would give the same condition two representations and put clients in the position of
	handling both -- which is the dual-representation problem choosing an enum over a
	Boolean was meant to avoid in the first place. There is exactly one answer shape.
	"""
	supportExportState: SupportExportState!
}

type SbomDependencyDeclaration {
	artifact: ID!
	sourceExactPurl: String!
	targetExactPurl: String!
}

type SearchDigestVersionResponse {
	commitReleases: [Release]
}

type Secret {
	uuid: ID
	name: String
	org: ID
	description: String
	createdType: ProgrammaticType
	lastUpdatedBy: ID
	createdDate: DateTime
	permissions: Permissions
}

input SecretInput {
	org: ID!
	name: String!
	description: String
	ptSecret: String!
}

input SecretUpdateInput {
	org: ID!
	description: String
	ptSecret: String
}

input SettingsInput {
	"""Org-wide prune mode for declarative applies. Partial-patch idiom: null leaves the existing value unchanged."""
	declarativePrune: DeclarativePruneMode
	justificationMandatory: Boolean
	branchSuffixMode: BranchSuffixMode
	vexComplianceFramework: VexComplianceFramework
	"""
	Org-wide default UI view. Partial-patch idiom: null leaves the existing value unchanged.
	"""
	defaultView: DashboardView
	"""
	Set the org-level sid PURL mode. See SidPurlMode docs. Partial-patch idiom:
	null leaves the existing value unchanged. Pairs with sidAuthoritySegments;
	ENABLED_STRICT requires non-empty segments to be present (either in this
	patch or already on the record).
	"""
	sidPurlMode: SidPurlMode
	"""
	Set the org-level decoded authority segments. Validation: domain-form first
	segment passes RFC 1035; registry-form first segment (no dot) accepted with
	a warning since the backend cannot verify the upstream PURL registry.
	Internal whitespace allowed (e.g. "Acme Robotics"); leading/trailing
	whitespace rejected.
	"""
	sidAuthoritySegments: [String!]
	"""
	Set the retention window, in days, for the org's notification rows
	(outbox events, deliveries, read marks). Accepted range 14..730; the
	minimum keeps clear of the email digest's maximum parking window plus
	the delivery retry curve. Partial-patch idiom: null leaves the existing
	value unchanged (90-day default applies when never set).
	"""
	notificationRetentionDays: Int
	"""
	The submission-level justification: what FDA L1021-1022 asks for literally, the reason
	per-component support information cannot be included. At the measured 2.3% upstream
	coverage this is the centre of a submission rather than a footnote.

	Null is a real state, not a default. A document with an empty REQUIRED slot is blocked
	rather than generated with the section missing -- on a submission a reviewer expects
	gaps, but on the patient-facing Device Support Statement a silent gap is itself
	misleading under 502(a)(1). No product-shipped default text: these are the
	manufacturer's own commitments.
	PATCH: OMIT to leave unchanged, send an EMPTY STRING to clear. Blank normalises to null
	in storage, so a generator's "required slot missing" test stays a null test.

	An explicit null is treated as OMITTED, not as a clear -- the clear signal is "", the
	same as on the attestation write. Worth knowing because null-to-clear is the more common
	convention elsewhere.
	"""
	fdaAssessmentNarrative: String
	"""
	PATCH: omitting the field leaves the stored value alone. There is no clear --
	the enum's two members already express both states, and null on the wire means
	"not part of this patch".
	"""
	supportInjection: SupportInjectionSetting
	"""
	Labeling VI.A.2: that patches and software updates may cease at end of support.
	PATCH: OMIT to leave unchanged, send an EMPTY STRING to clear. Blank normalises to null
	in storage, so a generator's "required slot missing" test stays a null test.

	An explicit null is treated as OMITTED, not as a clear -- the clear signal is "", the
	same as on the attestation write. Worth knowing because null-to-clear is the more common
	convention elsewhere.
	"""
	fdaPatchesMayCeaseStatement: String
	"""
	Labeling VI.A.3: a REFERENCE to the controlled risk-transfer process -- an identifier or
	URL, never the process itself. Plans are design-history-file records, and a pasted copy
	becomes a second, unversioned original that drifts from the controlled one.
	PATCH: OMIT to leave unchanged, send an EMPTY STRING to clear. Blank normalises to null
	in storage, so a generator's "required slot missing" test stays a null test.

	An explicit null is treated as OMITTED, not as a clear -- the clear signal is "", the
	same as on the attestation write. Worth knowing because null-to-clear is the more common
	convention elsewhere.
	"""
	fdaRiskTransferProcessRef: String
	"""
	Labeling VI.A.4: that end-user cybersecurity risk can be expected to increase over
	time.
	PATCH: OMIT to leave unchanged, send an EMPTY STRING to clear. Blank normalises to null
	in storage, so a generator's "required slot missing" test stays a null test.

	An explicit null is treated as OMITTED, not as a clear -- the clear signal is "", the
	same as on the attestation write. Worth knowing because null-to-clear is the more common
	convention elsewhere.
	"""
	fdaRiskIncreasesNotice: String
}

input ShipProductInput {
	org: ID!
	site: ID!
	featureSet: ID!
	release: ID!
	deliverable: ID
	"""
	Override the product component's device support window for this batch (D7). Omit to
	inherit, which is the ordinary case.
	"""
	deviceSupportWindow: DeviceSupportWindowInput
	"""
	Update-only: drop this batch's override so it inherits the product component again.
	Distinct from omitting the field (leaves it alone) and from sending an empty window
	object (which is a batch declaring nothing, not a retraction).
	"""
	clearDeviceSupportWindow: Boolean
	shipDate: String
	quantity: Int
	identifiers: [IdentifierInput]
	choiceResolutions: [ChoiceResolutionInput]
	manufactureDate: String
	expiryDate: String
	notes: String
	"""
	Plain software only: uuids of devices at the same site the release applies to (optional).
	Ignored for hardware and SaMD shipments, whose units are Device rows of their own.
	"""
	devices: [ID]
}

"""
An append-only, batch-level Distribution-module shipment record. Per-unit
observed state (actual / tracking) lives on the optional Device child.
"""
type ShippedProduct {
	uuid: ID
	org: ID
	"""Soft-delete marker: ARCHIVED rows are hidden from listings."""
	status: Status
	site: ID
	featureSet: ID
	release: ID
	deliverable: ID
	shipDate: String
	quantity: Int
	"""Batch-level production identifiers (LOT, UDI-DI, ...)."""
	identifiers: [Identifier]
	"""As-produced resolution of the release HBOM's CDX #929 choice slots."""
	choiceResolutions: [ChoiceResolution]
	manufactureDate: String
	expiryDate: String
	"""
	THIS BATCH's override of the device support window (D7). Null means INHERIT from the
	product component -- the ordinary case, and deliberately distinct from a window whose
	dates are both null, which is a batch asserting "not declared" over a model that does
	declare one.
	"""
	deviceSupportWindow: DeviceSupportWindow
	"""
	The window that actually applies to this batch: its own override if it has one, else
	the product component's declaration, with the level it came from.
	"""
	effectiveDeviceSupportWindow: ResolvedDeviceSupportWindow
	notes: String
	"""
	Physical-ness of the shipped feature set (any HARDWARE-nature component -> HARDWARE), derived
	at ship time; legacy rows are resolved the same way when listed.
	"""
	nature: ComponentNature
	"""
	Regulatory class of the shipped feature set's UDI-bearing component (NONE when there is
	none), derived at ship time. SOFTWARE + MEDICAL_* is SaMD.
	"""
	deviceClass: DeviceClass
	"""
	Plain software (nature SOFTWARE, deviceClass NONE) only: devices from hardware / SaMD
	shipments at the same site this release applies to. Empty when shipped without any device.
	"""
	devices: [ID]
	createdDate: DateTime
}

