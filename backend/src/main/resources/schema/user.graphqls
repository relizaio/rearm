	purl: String!
	aliases: [VulnerabilityAlias!]
	# resolvedIn/appearedIn/presentIn are PREVIEW-capped (first few entries) for payload control.
	# The *Count fields are the true totals; when a count exceeds the preview length the UI shows
	# "+N more" and drills down via findingAttributionByDate. See changelog-read-contract-redesign.md.
	resolvedIn: [ComponentAttribution!]!
	appearedIn: [ComponentAttribution!]!
	presentIn: [ComponentAttribution!]!
	resolvedInCount: Int!
	appearedInCount: Int!
	presentInCount: Int!
	isNetResolved: Boolean!
	isNetAppeared: Boolean!
	isStillPresent: Boolean!
	orgContext: OrgLevelContext
	analysisState: AnalysisState
	"True when this vulnerability (by CVE id or alias) is in the CISA KEV catalog"
	knownExploited: Boolean
	"ADDITIVE (changelog re-scan visibility): earliest in-window APPEARED finding_change_event date for this finding; null when the appearance is not event-backed."
	scanArrivalDate: DateTime
	"ADDITIVE: earliest in-window release (by creation) whose current metrics carry this finding."
	earliestCarrier: ComponentAttribution
	"ADDITIVE: latest in-window release (by creation) whose current metrics carry this finding."
	latestCarrier: ComponentAttribution
}

type WeaknessWithAttribution {
	# Opaque handle to page this finding's full attribution via findingAttributionByDate.
	findingKey: String!
	cweId: String!
	severity: String
	ruleId: String
	location: String!
	# Preview-capped lists + true totals (see VulnerabilityWithAttribution).
	resolvedIn: [ComponentAttribution!]!
	appearedIn: [ComponentAttribution!]!
	presentIn: [ComponentAttribution!]!
	resolvedInCount: Int!
	appearedInCount: Int!
	presentInCount: Int!
	isNetResolved: Boolean!
	isNetAppeared: Boolean!
	isStillPresent: Boolean!
	orgContext: OrgLevelContext
	analysisState: AnalysisState
	"ADDITIVE (changelog re-scan visibility): earliest in-window APPEARED finding_change_event date for this finding; null when the appearance is not event-backed."
	scanArrivalDate: DateTime
	"ADDITIVE: earliest in-window release (by creation) whose current metrics carry this finding."
	earliestCarrier: ComponentAttribution
	"ADDITIVE: latest in-window release (by creation) whose current metrics carry this finding."
	latestCarrier: ComponentAttribution
}

# Inbound GitHub webhook receiver. The (org, slug) pair forms the public
# URL path /api/programmatic/v1/webhook/{org}/{slug}; delivery, signature
# verification and PR upsert key entirely on (org, slug) + the row's own
# secret. The integration link is OPTIONAL (null = standalone): it is an
# organizational association only (capability gate, one-to-one cardinality,
# integration delete-protection) and is never read on delivery.
# encryptedSecret is intentionally not exposed back through the API --
# it's set-only on create / update.
type Webhook {
	uuid: ID
	org: ID
	# Optional associated GITHUB+WEBHOOK integration; null for a standalone webhook.
	integration: ID
	slug: String
	note: String
	status: WebhookStatus
	lastDeliveryAt: DateTime
	lastDeliveryStatus: WebhookDeliveryOutcome
	lastDeliveryId: String
	consecutiveFailureCount: Int
	createdDate: DateTime
	updatedDate: DateTime
}

# Authentication scheme for outbound WEBHOOK deliveries.
#   NONE          -- no auth header (URL secrecy + transport security only)
#   BEARER        -- Authorization: Bearer <token>
#   HMAC_SHA256   -- X-Reliza-Signature: sha256=<hex of HMAC over body>
enum WebhookAuthSchemeEnum {
	NONE
	BEARER
	HMAC_SHA256
}

enum WebhookDeliveryOutcome {
	SUCCESS
	SIGNATURE_INVALID
	HANDLER_ERROR
	UNKNOWN_EVENT
	DUPLICATE
	WEBHOOK_DISABLED
}

input WebhookInput {
	org: ID!
	# Optional. Associate with a GITHUB+WEBHOOK integration (organizational
	# link only). Omit/null for a standalone webhook -- delivery is identical.
	integration: ID
	# Lowercase ASCII, 4-63 chars, no leading/trailing hyphen. Unique
	# within the org. Reserved values are rejected.
	slug: String!
	# Plain HMAC-SHA256 key (matches the value pasted into the GitHub
	# App's "Webhook secret" field). Encrypted at rest.
	secret: String!
	# GitHub installation ID (numeric, passed as string for symmetry
	# with the GH App's existing schedule field).
	installation: String
	note: String
}

enum WebhookStatus {
	ACTIVE
	DISABLED
}

input WebhookUpdateInput {
	uuid: ID!
	note: String
	status: WebhookStatus
	# Pass empty string to clear, omit to preserve.
	installation: String
	# Optional association change (organizational link only, never affects
	# delivery): omit to preserve, empty string to clear (-> standalone),
	# or a GITHUB+WEBHOOK integration id to set/change it.
	integration: ID
	# Pass to rotate; omit to keep existing.
	secret: String
	# Pass to rename. Same regex + uniqueness rules as create. Changing
	# the slug also changes the public webhook URL -- re-register it on
	# the GitHub App side at the same time.
	slug: String
}
