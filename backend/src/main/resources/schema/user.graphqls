type EnrichmentTriggerResult {
	triggered: Boolean!
	message: String
	bomUuid: ID
}

"""Which release a unit was evaluated against, and why that one."""
enum EvaluatedRelease {
	"""What the unit actually reported running. Preferred: it is the ground truth."""
	REPORTED
	"""What the unit was planned to run. Used only when nothing has been reported."""
	EXPECTED
}

type FederatedGrant {
	type: FederatedGrantType
	"KEY: the Free Form key to act as"
	keyUuid: ID
	"TEMPLATE: org-wide level, usually READ_ONLY so names resolve; NONE for nothing"
	orgPermission: PermissionType
	"TEMPLATE: level on components, branches and releases whose VCS repository is the calling repository"
	vcsPermission: PermissionType
	"TEMPLATE: may create components (and the VCS repository record) bound to the calling repository"
	createComponents: Boolean
	"TEMPLATE: functions on the org-wide and repository-scoped permissions; RESOURCE is implicit"
	functions: [PermissionFunction!]
	"TEMPLATE: extra static scope"
	permissions: [FederatedStaticPermission!]
}

input FederatedGrantInput {
	type: FederatedGrantType!
	keyUuid: ID
	orgPermission: PermissionType
	vcsPermission: PermissionType
	createComponents: Boolean
	functions: [PermissionFunction!]
	permissions: [FederatedStaticPermissionInput!]
}

"""
TEMPLATE: scope evaluated against the token on every call (the calling repository's components, optionally
creating them, plus optional static extras), acting through an identity row materialised per repository.
KEY: act as one Free Form key of the organization, with its permissions and attribution.
"""
enum FederatedGrantType {
	TEMPLATE
	KEY
}

"""
Which identity tokens a trust rule accepts. owner is required; every list constrains only when non-empty.
Repository entries are globs over the bare name or owner/name; refs are globs over the full ref (a bare pattern
matches both heads and tags); workflows match the workflow file name or a glob over workflow_ref; subjects
are globs over the raw sub claim.
"""
type FederatedMatcher {
	owner: String
	repositories: [String!]
	excludeRepositories: [String!]
	refs: [String!]
	environments: [String!]
	workflows: [String!]
	events: [String!]
	subjects: [String!]
}

input FederatedMatcherInput {
	owner: String!
	repositories: [String!]
	excludeRepositories: [String!]
	refs: [String!]
	environments: [String!]
	workflows: [String!]
	events: [String!]
	subjects: [String!]
}

type FederatedStaticPermission {
	scope: PermissionScope
	object: ID
	type: PermissionType
	functions: [PermissionFunction!]
}

input FederatedStaticPermissionInput {
	scope: PermissionScope!
	object: ID!
	type: PermissionType!
	functions: [PermissionFunction!]
}

"""
An organization's trust in identity tokens from an external issuer. Every edit or status change bumps the
version, which invalidates access tokens minted through the rule. The owner id on the provider side is pinned
on first use; a changed id is refused until an admin resets the pin.
"""
type FederatedTrustRule {
	uuid: ID
	org: ID
	name: String
	provider: FederatedProvider
	issuer: String
	status: FederatedTrustRuleStatus
	version: Int
	matcher: FederatedMatcher
	grant: FederatedGrant
	pinnedOwnerId: String
	expiresDate: DateTime
	createdDate: DateTime
	lastUpdatedDate: DateTime
	lastUsedDate: DateTime
	createdBy: ID
	lastUpdatedBy: ID
}

enum FederatedTrustRuleStatus {
	ACTIVE
	DISABLED
}

# Which finding-lifecycle bucket to page in findingAttributionByDate.
enum FindingAttributionBucket { APPEARED, PRESENT, RESOLVED }

"Kind of re-scan-driven finding change between two consecutive metrics snapshots of the same release (board task #37)."
enum FindingChangeKind {
	APPEARED
	RESOLVED
	SEVERITY_INCREASED
	SEVERITY_DECREASED
	KEV_ADDED
	KEV_REMOVED
}

# Read scope for findingChangeTimelineByDate (org-level only). RELEASE_ANCHORED (default) bounds events to
# releases produced in the window; ALL_POSTURE also surfaces re-scan-driven changes on releases produced
# before the window (a newly-disclosed CVE against an already-shipped release). See FindingChangeScope.java.
enum FindingChangeScope {
	RELEASE_ANCHORED
	ALL_POSTURE
}

type FindingChangesWithAttribution {
	vulnerabilities: [VulnerabilityWithAttribution!]!
	violations: [ViolationWithAttribution!]!
	weaknesses: [WeaknessWithAttribution!]!
	totalAppeared: Int!
	totalResolved: Int!
	# "Worsened" rollup counts (board task #38, phase 3 posture-diff). 0 on the legacy path.
	totalNewlyKev: Int
	totalSeverityIncreased: Int
	# Non-null when the window `from` predates the org's finding-change-event retention horizon: the
	# from-baseline could not be fully reconstructed, so buckets degrade to comparing against current
	# metrics for postures before this instant. Null when the window is fully within retention / legacy path.
	reconstructionClampedSince: DateTime
	# true = posture-endpoint diff semantics (window-endpoint reconstruction); false/absent = legacy
	# pairwise-across-releases semantics (e.g. an org whose event-log backfill has not yet certified).
	# Lets a client tell WHICH semantics it renders, since both share this payload at org scope.
	postureDiffApplied: Boolean
}

enum FindingType {
	VULNERABILITY
	VIOLATION
	WEAKNESS
}

