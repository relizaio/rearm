# ---------------------------------------------------------------------------
# User (JWT) root fields
#
# The ReARM GraphQL schema is split by caller:
#   schema.graphqls        shared types, inputs, enums, scalars
#   user.graphqls          root fields for signed-in users (JWT); the Query and
#                          Mutation base types are declared here
#   programmatic.graphqls  root fields for API keys (extend Query / Mutation)
#
# /api/programmatic/graphql (no version segment: the programmatic schema evolves
# additively, with deprecations) accepts only the fields declared in
# programmatic.graphqls and needs no CSRF token or session. /graphql keeps
# serving every field for backward compatibility.
# ---------------------------------------------------------------------------

type Query {
	user: User
	"""Every lock in the organization, active and recently released."""
	locks(orgUuid: ID!): [Lock!]
	"""What a lock or a commit has been attested to."""
	attestations(orgUuid: ID!, subjectType: AttestationSubjectType!, subjectUuid: ID!): [Attestation!]
	"""
	What needs attention: active locks, the commits behind them nobody has claimed, and the
	locks that have escalated to an administrator.
	"""
	integrityInbox(orgUuid: ID!): IntegrityInbox
	organizations: [Organization]
	adminOrganization(org: ID!): AdminOrganization
	allOrganizations: [Organization]
	
	# changelog (sealed interface API)
	componentChangelog(release1:ID!, release2:ID!, orgUuid:ID!, aggregated: AggregationType!, timeZone: String): ComponentChangelog
	componentChangelogByDate(componentUuid:ID!, branchUuid:ID, orgUuid:ID!, aggregated: AggregationType!, timeZone: String, dateFrom: DateTime!, dateTo: DateTime!): ComponentChangelog
	organizationChangelogByDate(orgUuid: ID!, perspectiveUuid: ID, dateFrom: DateTime!, dateTo: DateTime!, aggregated: AggregationType!, timeZone: String): OrganizationChangelog
	# Paginated drill-down for ONE finding's attribution bucket (the "+N more" expansion behind the
	# preview-capped appearedIn/presentIn/resolvedIn lists on the *WithAttribution types). Recomputes the
	# SAME scope + path as the changelog with a single-finding filter, so the page total matches the
	# corresponding *InCount shown inline. Scope: org (only orgUuid) / component (+componentUuid) /
	# branch (+componentUuid+branchUuid). findingKey is the opaque handle from the finding DTO.
	findingAttributionByDate(orgUuid: ID!, componentUuid: ID, branchUuid: ID, perspectiveUuid: ID, dateFrom: DateTime!, dateTo: DateTime!, findingKind: ChangelogFindingKind!, findingKey: String!, bucket: FindingAttributionBucket!, page: Int, pageSize: Int): ComponentAttributionPage!
	# Paginated over-time timeline behind the capped inline overTimeFindingChanges (the drawer source).
	# Optional findingKey narrows to one finding's timeline. Scope: org / component (+componentUuid) /
	# branch (+componentUuid+branchUuid). Newest-first; `total` is the full count, `since` the retention clamp.
	# `scope` (org-level only): RELEASE_ANCHORED (default) bounds to releases produced in the window;
	# ALL_POSTURE also surfaces re-scan-driven changes on releases produced before the window.
	findingChangeTimelineByDate(orgUuid: ID!, componentUuid: ID, branchUuid: ID, perspectiveUuid: ID, dateFrom: DateTime!, dateTo: DateTime!, findingKey: String, page: Int, pageSize: Int, scope: FindingChangeScope = RELEASE_ANCHORED): MetricsRevisionFindingChangePage!

	releaseTagKeys(orgUuid: ID!): [String]
	component(componentUuid:ID!): Component
	components(orgUuid:ID!, componentType:ComponentType!, perspective:ID): [Component]
	"""
	Durable-ownership report (RFC Phase 4c): every NON-OWNED component in the org
	with its computed ownership status/suggestion. Org-admin only; read-only
	governance view -- never blocks releases.
	"""
	componentOwnershipReport(orgUuid: ID!): [ComponentOwnershipReportRow!]!
	branch(branchUuid:ID!): Branch
	branchesOfComponent(componentUuid:ID!): [Branch]
	releases(branchFilter:ID, orgFilter:ID, releaseFilter:[ID], numRecords:Int): [Release]
	getNextVersion(branchUuid:ID!, versionType: VersionType): String
	vcsRepository(vcs:ID!): VcsRepository
	listVcsReposOfOrganization(orgUuid:ID!): [VcsRepository]
	pullRequest(prUuid: ID!): PullRequest
	"""
	List PullRequests for an org. {@code states} narrows the result to
	the supplied {@link PullRequestState} values (case-insensitive); pass
	null/empty to fetch every state. The UI defaults to {@code [OPEN]}
	so terminal-state PRs aren't loaded until the user opts in via the
	state filter.
	"""
	pullRequestsOfOrg(orgUuid: ID!, states: [String!]): [PullRequest]
	"""
	List PullRequests targeting a given VCS repository. {@code states}
	narrows the result by {@link PullRequestState}; pass null/empty for
	all states. Mirrors the {@code pullRequestsOfOrg} default of {@code
	[OPEN]} on the UI side.
	"""
	pullRequestsOfVcs(vcs: ID!, states: [String!]): [PullRequest]
	vcsRepositoryTypes: [String]
	sourceCodeEntry(sceUuid:ID!): SourceCodeEntry
	artifact(artifactUuid: ID!): Artifact
	artifactVersionHistory(artifactUuid: ID!): [Artifact]
	artifactTypes: [String]
	users(orgUuid: ID!, includeInactive: Boolean): [OrgUserData]
	combinedUserOrgPermissions(orgUuid: ID!, userUuid: ID!): Permissions
	resourceGroups(orgUuid: ID!): [ResourceGroup]
	releaseAnalytics(orgUuid: ID!, cutOffDate: DateTime!): [VegaDateValue]
	releaseAnalyticsByComponent(componentUuid: ID!, cutOffDate: DateTime!): [VegaDateValue]
	releaseAnalyticsByBranch(branchUuid: ID!, cutOffDate: DateTime!): [VegaDateValue]
	releaseAnalyticsByPerspective(perspectiveUuid: ID!, cutOffDate: DateTime!): [VegaDateValue]
	totalsAnalytics(orgUuid: ID!): Object
	apiKeys(orgUuid: ID!): [ApiKey]
	"Live keys the calling user owns (USER) or holds (FREEFORM requested by them), across organizations"
	myApiKeys: [ApiKey]
	"CLI browser login: the pending request behind a user code (null when unknown or expired)"
	cliLoginRequest(userCode: String!): CliSession
	"The calling user's active CLI sessions"
	myCliSessions: [CliSession]
	"Org admins: active CLI sessions riding this key"
	cliSessionsOfKey(apiKeyUuid: ID!): [CliSession]
	"Org admins: the organization's federated identity trust rules"
	federatedTrustRules(orgUuid: ID!): [FederatedTrustRule]
	marketingRelease(marketingReleaseUuid: ID!): MarketingRelease
	marketingReleases(componentUuid: ID!): [MarketingRelease]
	marketingReleaseLifecycles: [MarketingReleaseLifecycle]
	defaultApprovalRoles: [ApprovalRole]
	approvalPoliciesOfOrg(orgUuid: ID!): [ApprovalPolicy]
	approvalEntriesOfOrg(orgUuid: ID!): [ApprovalEntry]
	"""
	Read-only "what needs my approval" view: releases in the given org that are
	awaiting the calling user's approval. A release is returned when its effective
	approval policy has at least one unsatisfied requirement whose allowed roles
	intersect an approval role the user holds (via a permission that covers the
	release) and which the user has not yet voted on. Org admins are NOT auto-listed:
	the view keys off assigned approval roles, not the admin override capability.
	"""
	releasesNeedingMyApproval(orgUuid: ID!): [ReleasePendingApproval!]
	artifactReleases(artUuid: ID!): [Release]
	artifactBomLatestVersion(artUuid: ID!): String
	# Deliverables
	deliverable(deliverable: ID!): Deliverable
	listDeliverablesByComponent(componentUuid: ID!): [Deliverable]
	
	# Artifact Collections
	getAcollectionsOfRelease(releaseUuid: ID!): [AcollectionData]

	# Detailed SBOM components aggregated across all BOM artifacts of a release.
	# Each entry is keyed by the canonical purl (purl with qualifiers stripped);
	# artifactParticipations carries the list of artifacts that referenced this
	# component and the exact (qualifier-carrying) purls each one used.
	getReleaseSbomComponents(releaseUuid: ID!): [ReleaseSbomComponent]

	# Single-component graph view: the merged ReleaseSbomComponent row for
	# (release, canonical sbom component), with the same dependencies /
	# dependedOnBy resolvers as getReleaseSbomComponents. Returns null when
	# the canonical component does not appear in the release (or its dep tree,
	# for product releases). Use this from a graph-detail page to navigate by
	# stable (releaseUuid, sbomComponentUuid) instead of scanning the full
	# release set client-side.
	getReleaseSbomComponentGraph(releaseUuid: ID!, sbomComponentUuid: ID!): ReleaseSbomComponent

	configuredBaseIntegrations(org: ID!): [IntegrationType]
	# Detected Dependency-Track generation ("V4"/"V5") of the org's base
	# DEPENDENCYTRACK integration; null when none is configured.
	dependencyTrackVersion(org: ID!): String
	ciIntegrations(org: ID!): [CiIntegration]

	# Inbound webhook reception. {org}/{slug} forms the public URL path
	# the GitHub App is configured to POST to.
	webhook(uuid: ID!): Webhook
	webhooks(orgUuid: ID!): [Webhook]
	
	# Analytics
	mostActiveComponentsOverTime(activeComponentsInput: ActiveComponentsInput!): [ReleasesPerComponent]
	mostActiveBranchesOverTime(activeComponentsInput: ActiveComponentsInput!): [ReleasesPerBranch]
	mostActiveComponentsOverTimeByPerspective(activeComponentsInput: ActiveComponentsInput!, perspectiveUuid: ID!): [ReleasesPerComponent]
	mostActiveBranchesOverTimeByPerspective(activeComponentsInput: ActiveComponentsInput!, perspectiveUuid: ID!): [ReleasesPerBranch]
	vulnerabilitiesViolationsOverTime(orgUuid: ID!, dateFrom: DateTime!, dateTo: DateTime!): [VulnerabilityViolationChart]
	vulnerabilitiesViolationsOverTimeByComponent(componentUuid: ID!, dateFrom: DateTime!, dateTo: DateTime!): [VulnerabilityViolationChart]
	vulnerabilitiesViolationsOverTimeByBranch(branchUuid: ID!, dateFrom: DateTime!, dateTo: DateTime!): [VulnerabilityViolationChart]
	vulnerabilitiesViolationsOverTimeByPerspective(perspectiveUuid: ID!, dateFrom: DateTime!, dateTo: DateTime!): [VulnerabilityViolationChart]
	mostVulnerableComponentsPerOrg(orgUuid: ID!, createdDate: DateTime!, componentType: ComponentType!, maxComponents: Int!, perspectiveUuid: ID): [MostVulnerableComponent]
	findingsPerDay(orgUuid: ID!, date: String!): DependencyTrackMetrics
	findingsPerDayForComponent(componentUuid: ID!, date: String!): DependencyTrackMetrics
	findingsPerDayForBranch(branchUuid: ID!, date: String!): DependencyTrackMetrics
	findingsPerDayByPerspective(perspectiveUuid: ID!, date: String!): DependencyTrackMetrics
	
	organization(orgUuid: ID!): Organization
	
	healthCheck: String
	searchDigestVersion(orgUuid: ID!, query: String!, perspectiveUuid: ID): SearchDigestVersionResponse
	releasesByTags(orgUuid: ID!, branchUuid: ID, tagKey: String!, tagValue:String, perspectiveUuid: ID): [Release]
	releasesByDtrackProjects(orgUuid: ID!, dtrackProjects: [ID], perspectiveUuid: ID): [ComponentWithBranches]
	sbomComponentSearch(orgUuid: ID!, queries: [SbomComponentSearchInput!]!, perspectiveUuid: ID): [ComponentPurlToDtrack]
	searchDtrackComponentByPurlAndProjects(orgUuid: ID!, purl: String!, dtrackProjects: [ID]!): ID

	# Native (non-DependencyTrack) SBOM-component analogues of the three queries
	# above. Search and grouping run against rearm.sbom_components /
	# rearm.release_sbom_components instead of dtrack -- same shapes, sbom_component
	# UUIDs in place of dtrack project UUIDs. See SbomComponentDataFetcher.
	releasesBySbomComponents(orgUuid: ID!, sbomComponentUuids: [ID]!, perspectiveUuid: ID): [ComponentWithBranches]
	sbomComponentSearchNative(orgUuid: ID!, queries: [SbomComponentSearchInput!]!, perspectiveUuid: ID): [ComponentPurlToSbom]
	searchSbomComponentByPurl(orgUuid: ID!, purl: String!): ID

	getAllOrganizations: [Organization]
	
	getSystemInfoIsSet: SystemInfoIsSet
	license: LicensePayload
	
	exportAsObomManual(releaseUuid: ID!): String

	"""
	Export a Common Lifecycle Enumeration (CLE) JSON document for a component
	(or product). The events array is the same chronological union the TEA
	endpoint returns; this query wraps it with `$schema` and `lastUpdated`
	metadata so the response stands alone as a CLE document.

	NOT currently CLE-1.0.0 CONFORMANT, and deliberately no longer described as
	such: endOfSupport events carry no supportId (the spec makes it mandatory)
	and no definitions.support[], because the support-policy catalog was
	removed -- see ai-plans/fda-readiness-1-plan.md P1. Event ids are also
	recomputed per export rather than persisted. Do not reinstate a conformance
	claim here until board t20260831-115702-299 and -13297 land.
	"""
	exportComponentCleManual(componentUuid: ID!): String

	"""
	Export a Common Lifecycle Enumeration (CLE) JSON document for a single
	release. Mirrors exportComponentCleManual at the release level -- events
	come from transformReleaseToCle. Carries the same conformance caveat; see
	exportComponentCleManual above.
	"""
	exportReleaseCleManual(releaseUuid: ID!): String
	
	# User Groups
	getUserGroups(org: ID!): [UserGroupWebDto]
	getTeams(org: ID!): [TeamWebDto]

	# Vulnerability Analysis
	getVulnAnalysis(org: ID!): [VulnAnalysisWebDto]
	getVulnAnalysisByComponent(componentUuid: ID!): [VulnAnalysisWebDto]
	getVulnAnalysisByBranch(branchUuid: ID!): [VulnAnalysisWebDto]
	getVulnAnalysisByRelease(releaseUuid: ID!): [VulnAnalysisWebDto]
	getVulnAnalysisByLocationAndFinding(org: ID!, location: String!, findingId: String!, findingType: FindingType!): [VulnAnalysisWebDto]
	getVulnAnalysisByPerspective(perspectiveUuid: ID!): [VulnAnalysisWebDto]
	getVexStatementProposals(org: ID!, status: ProposalStatus): [VexStatementProposalWebDto]
	getVexStatementProposal(uuid: ID!): VexStatementProposalWebDto
	getVexStatementProposalsBySourceArtifact(artifact: ID!): [VexStatementProposalWebDto]
	getVexStatementProposalsByRelease(org: ID!, release: ID!): [VexStatementProposalWebDto]
	getMitigationAttestations(org: ID!, status: AttestationStatus): [MitigationAttestationWebDto]
	getMitigationAttestation(uuid: ID!): MitigationAttestationWebDto
	getMitigationAttestationsByAssignee(assignee: ID!, status: AttestationStatus): [MitigationAttestationWebDto]

	# Perspectives
	perspectives(org: ID!): [Perspective]
	componentsOfPerspective(perspectiveUuid: ID!): [Component]

	# Download Logs
	listDownloadLogs(org: ID!, fromDate: DateTime, toDate: DateTime, perspective: ID): [DownloadLog]
	
	# CVE Search
	"""
	Bounded search: the hierarchy covers the 500 newest matching releases;
	totalReleases/truncated tell the client when more matches exist.
	"""
	searchReleasesByCveId(org: ID!, cveId: String!, perspectiveUuid: ID): CveSearchResult
	# Time Frame Search
	searchReleasesByTimeFrame(org: ID!, startDate: DateTime!, endDate: DateTime!, perspectiveUuid: ID): [ComponentWithBranches]
	searchReleasesByTimeFrameAndComponent(componentUuid: ID!, startDate: DateTime!, endDate: DateTime!): [ComponentWithBranches]
	searchReleasesByTimeFrameAndBranch(branchUuid: ID!, startDate: DateTime!, endDate: DateTime!): [ComponentWithBranches]
	# Date Range Queries - return flat [Release] list
	releasesByDateRange(org: ID!, startDate: DateTime!, endDate: DateTime!, limit: Int, componentType: ComponentType): [Release]
	releasesByDateRangeAndComponent(componentUuid: ID!, startDate: DateTime!, endDate: DateTime!, limit: Int): [Release]
	"""
	The limit most recent releases of the component across all its branches, newest first
	(default 20, capped at 200). Feeds the component page's Latest tab.
	"""
	latestReleasesOfComponent(componentUuid: ID!, limit: Int): [Release]
	releasesByDateRangeAndBranch(branchUuid: ID!, startDate: DateTime!, endDate: DateTime!, limit: Int): [Release]
	releasesByDateRangeAndPerspective(perspectiveUuid: ID!, startDate: DateTime!, endDate: DateTime!, limit: Int, componentType: ComponentType): [Release]
	# Pattern Preview
	previewPattern(orgUuid: ID!, pattern: String!, targetBranchName: String, defaultStatus: Status, fallbackToBase: FallbackToBase): [EffectiveDependency]

	# Reverse dependency lookup: which feature sets include this component/branch as a dependency
	# (any requirement type -- REQUIRED, OPTIONAL, or IGNORED -- via explicit deps or patterns)
	featureSetsUsingComponent(componentUuid: ID!): [Branch]
	featureSetsUsingBranch(branchUuid: ID!): [Branch]

	# Instances
	#
	# When `revision` is null or -1, returns the live instance state.
	# When `revision` is a positive integer, the lookup is scoped by
	# `stateType`: PLAN (default) reads from the instance_data_plan
	# audit table using the plan-revision counter; ACTUAL reads from
	# instance_data_actual using the actual-revision counter. This
	# matches the per-table revision counters surfaced by
	# instanceHistoryPlan / instanceHistoryActual so the UI can
	# side-by-side a history row against the current state.
	instance(instanceUuid: ID!, revision: Int, stateType: InstanceStateType): Instance
	instancesOfOrganization(orgUuid: ID!): [Instance]
	"""
	Where a component or product is deployed, one row per (instance, namespace)
	occurrence. For a PRODUCT the rows come from the instances' product plans
	(featureSet = the linked feature set, version = the matched product release
	or null when not matched). For a COMPONENT the rows come from the instances'
	deployed releases (featureSet = the release's branch, version = the deployed
	release). Requires read access to the component. SAAS-only.
	"""
	deployedTo(componentUuid: ID!): [DeployedToEntry!]!
	instancesByProp(orgUuid: ID!, propKey: ID, propVal: String!): [Instance]
	instanceHistoryPlan(instanceUuid: ID!): [InstanceHistoryPlan]
	instanceHistoryActual(instanceUuid: ID!): [InstanceHistoryActual]
	instanceHistoryPlanByDate(instanceUuid: ID!, fromDate: DateTime!, toDate: DateTime!, changeType: InstancePlanChangeType): [InstanceHistoryPlan]
	instanceHistoryActualByDate(instanceUuid: ID!, fromDate: DateTime!, toDate: DateTime!, changeType: InstanceActualChangeType): [InstanceHistoryActual]
	searchChangesOverTime(orgUuid: ID!, fromDate: DateTime!, toDate: DateTime!): [InstanceWithHistory]
	environmentTypes(orgUuid: ID, includeBuiltIn: Boolean): [String]
	getInstanceRevisionCycloneDxExportManual(instanceUuid: ID!, revision: Int, namespace: String, stateType: InstanceStateType): String

	# properties
	property(propertyUuid: ID!): Property
	propertyDataTypes: [PropertyDataType]
	propertyConfigTypes: [PropertyConfigurableType]
	propertiesOfOrg(orgUuid: ID!): [Property]

	# secrets
	secret(secretUuid:ID!, orgUuid:ID!): Secret
	secrets(orgUuid:ID!): [Secret]
	
	# BEAR integration
	getBearIntegration(org: ID!): BearIntegration

	# AI Agents
	agent(uuid: ID!): Agent
	agentsOfOrg(orgUuid: ID!): [Agent]
	subAgentsOf(rootAgentUuid: ID!): [Agent]
	session(uuid: ID!): Session
	sessionsOfOrg(orgUuid: ID!, statuses: [SessionStatus]): [Session]
	sessionsOfAgent(rootAgentUuid: ID!, statuses: [SessionStatus]): [Session]
	modelOntology(uuid: ID!): ModelOntology
	modelOntologiesOfOrg(orgUuid: ID!): [ModelOntology]
	"""
	Cross-cutting KPIs for the AI Agents dashboard header -- active
	sessions, closed-in-last-30d, artifacts produced in last 7d, and
	registered-agent count.
	"""
	agentDashboardKpis(orgUuid: ID!): AgentDashboardKpis

	# AI-Agent policies (SAAS-only).
	agentPolicy(uuid: ID!): AgentPolicy
	agentPoliciesOfOrg(orgUuid: ID!): [AgentPolicy]

	# Distribution module (SAAS-only): clients + sites.
	client(uuid: ID!): Client
	clientsOfOrg(orgUuid: ID!): [Client]
	site(uuid: ID!): Site
	sitesOfOrg(orgUuid: ID!): [Site]
	sitesOfClient(clientUuid: ID!): [Site]

	# Distribution module (SAAS-only): shipments / installed base.
	shippedProduct(uuid: ID!): ShippedProduct
	shippedProductsOfOrg(orgUuid: ID!): [ShippedProduct]
	shippedProductsOfSite(siteUuid: ID!): [ShippedProduct]
	shippedProductsOfFeatureSet(featureSetUuid: ID!, orgUuid: ID!): [ShippedProduct]
	# Recall scope: every shipment of a release.
	shippedProductsOfRelease(releaseUuid: ID!, orgUuid: ID!): [ShippedProduct]

	# Per-device layer (optional, one level below a shipment).
	device(uuid: ID!): Device
	devicesOfShipment(shippedProductUuid: ID!): [Device]
	devicesOfSite(siteUuid: ID!, orgUuid: ID!): [Device]

	# Digital twin: field events + as-maintained hardware view of a unit.
	deviceEventsOfDevice(deviceUuid: ID!): [DeviceEvent]
	deviceHbomComponents(deviceUuid: ID!): [DeviceHbomComponent]

	# Fleet drift in a single query: every unit in the org diverging from its
	# authorized baseline, with the site/client it is fielded at.
	driftedDevicesOfOrg(orgUuid: ID!): [FleetDriftEntry]

	# Resolve a feature set's device identity (UDI-DI + regulatory class)
	# from its single UDI-bearing constituent component.
	featureSetDeviceIdentity(featureSetUuid: ID!, orgUuid: ID!): DeviceIdentity

	# HBOM (hardware BOM) components of a release; parsed + cached on first read.
	hbomComponentsOfRelease(releaseUuid: ID!): [HbomComponent]

	# CDX #929 choice slots of a release tree (ship form + repair flow).
	releaseComponentChoices(releaseUuid: ID!): [ComponentChoice]

	# Committers + signing keys + signature verifications.
	committer(uuid: ID!): Committer
	committersOfOrg(orgUuid: ID!): [Committer]
	signingKey(uuid: ID!): SigningKey
	signingKeysOfOwner(orgUuid: ID!, ownerType: SigningKeyOwnerType!, ownerUuid: ID!): [SigningKey]
	signingKeysOfOrg(orgUuid: ID!): [SigningKey]
	signatureVerification(uuid: ID!): SignatureVerification
	signatureVerificationsForSubject(subjectType: SignatureSubjectType!, subjectUuid: ID!): [SignatureVerification]

	# Notifications framework -- read surface (Phase 2e).
	#
	# All queries below are org-admin scoped. The data fetcher resolves
	# the org from the entity uuid before authorizing, so a caller
	# cannot guess uuids in another tenant.

	# Single outbox event lookup -- pairs with injectSyntheticEvent /
	# testNotificationChannel mutations so the UI can poll for the
	# event's row after the mutation returns.
	notificationOutboxEvent(uuid: ID!): NotificationOutboxEventResult

	# Single delivery row lookup.
	notificationDelivery(uuid: ID!): NotificationDeliveryResult

	# Paginated delivery listing with optional filters. Items are
	# ordered newest-first by created_date.
	#   eventUuid  -- filter to deliveries for one outbox event
	#   channelUuid -- filter to deliveries for one channel
	#   subscriptionUuid -- filter to deliveries for one subscription
	#   status     -- typed enum filter; typos rejected at the GraphQL layer
	#   origin     -- typed enum filter; typos rejected at the GraphQL layer
	notificationDeliveries(
		orgUuid: ID!,
		eventUuid: ID,
		channelUuid: ID,
		subscriptionUuid: ID,
		status: NotificationDeliveryStatusEnum,
		origin: NotificationDeliveryOriginEnum,
		limit: Int,
		offset: Int): NotificationDeliveriesPage!

	# Single subscription lookup. Returns null on miss.
	notificationSubscription(uuid: ID!): NotificationSubscriptionResult

	# List subscriptions for an org.
	notificationSubscriptions(orgUuid: ID!): [NotificationSubscriptionResult!]!

	# Single channel lookup. Encrypted secrets are stripped (see
	# NotificationChannelResult). Returns null on miss.
	notificationChannel(uuid: ID!): NotificationChannelResult

	# List channels for an org. Encrypted secrets are stripped from
	# the read surface.
	notificationChannels(orgUuid: ID!): [NotificationChannelResult!]!

	# Notifications framework -- channel-group reads (Phase 13b).
	#
	# Single channel-group lookup. Returns null on miss. Org-admin
	# authorized -- the fetcher resolves org from the row before
	# authorizing so a caller can't probe uuids across tenants.
	notificationChannelGroup(uuid: ID!): NotificationChannelGroupResult

	# List channel groups for an org. Channel-group membership lists
	# (just UUIDs) ride along with the result so the UI can render the
	# group's contents in one round-trip.
	notificationChannelGroups(orgUuid: ID!): [NotificationChannelGroupResult!]!

	# Notifications framework -- Inbox MVP (Phase 14).
	#
	# Personal, visibility-filtered view of delivery rows:
	#   - org-admin tier sees every delivery in the org
	#   - perspective-member sees deliveries whose event payload's
	#     affectedReleases[*].perspectives intersect the caller's
	#     perspective membership
	#   - non-admin without perspective membership sees nothing
	#
	# Distinct from notificationDeliveries (the org-admin audit log).
	# This query is the "what's relevant to me" surface -- visibility
	# is enforced at the SQL layer (no fan-out of per-user rows).
	#
	# unreadOnly defaults to true so the typical badge-driven open
	# lands on the unread queue without the operator needing to flip
	# the filter.
	notificationInbox(
		orgUuid: ID!,
		unreadOnly: Boolean,
		status: NotificationDeliveryStatusEnum,
		# Filter by the originating outbox event's type. Useful for
		# high-volume orgs that want to triage NEW_VULN_AFFECTS_RELEASES
		# separately from VULNERABILITY_RECORD_UPDATED or
		# VEX_STATE_CHANGED. Null = match all event types.
		eventType: NotificationEventTypeEnum,
		# Visibility scope. PERSONAL (default) shows the caller's own
		# component-team + perspective + targeted rows and does NOT auto-show
		# an org admin every delivery in the org; ORG_ALL is the org-wide
		# firehose, honored only for org admins (a non-admin request collapses
		# to PERSONAL). The org-wide audit view also lives in Delivery History.
		inboxScope: NotificationInboxScope = PERSONAL,
		limit: Int,
		offset: Int): NotificationInboxPage!

	# Count of unread deliveries the caller can see, for the inbox-tab
	# badge. Same visibility filter as notificationInbox; defaults to the
	# PERSONAL scope so an admin's badge reflects their own actionable
	# count rather than the whole-org firehose.
	notificationUnreadCount(orgUuid: ID!, inboxScope: NotificationInboxScope = PERSONAL): Int!

	# CISA KEV catalog details for one CVE id (Phase 6a). The catalog is
	# global (public CISA data, no org rows) -- orgUuid is for
	# authorization only. Returns null when the CVE is not KEV-listed.
	kevRecordDetails(orgUuid: ID!, cveId: String!): KevRecordDetails

	# In-app details of one vulnerability from the org's vulnerability
	# record (description, CVSS, EPSS, CWEs, references, per-source
	# provenance). vulnId may be the canonical id or any alias (a GHSA id
	# finds the CVE-keyed record). Null when the org has no record for it;
	# refreshVulnerabilityRecord can fetch one.
	vulnerabilityRecordDetails(orgUuid: ID!, vulnId: String!): VulnerabilityRecordDetails

	# Paged, filtered view of the SAME release component set, for the support
	# attestation table. Separate from the unpaged query above rather than
	# replacing it: the graph view needs every node and the release's own root
	# component, while this one excludes root (a root is the release's own
	# artifact coordinate, never a third-party dependency to disclose) so that
	# its ALL total is the same denominator sbomComponentSupportCoverage
	# reports. Both resolve the release through the same path, PRODUCT unwind
	# included.
	#
	# attestation filters against the SAME SQL body the coverage gauge counts
	# with, and UNATTESTED is its exact complement -- so the rows this returns
	# are exactly the ones the gauge says are missing. search is a
	# case-insensitive substring of the canonical purl, with LIKE metacharacters
	# treated as literals. limit is clamped to the range 1..500 and defaults to
	# 50 -- a limit of 0 becomes 1, since a zero-size page would page forever.
	#
	# KEYSET pagination, not offset. after is the uuid of the last item you saw
	# (endCursor); omit it for the first page. This is not a house-style
	# deviation for its own sake -- attestation:UNATTESTED is a predicate over
	# MUTABLE state, and attesting a page removes those rows from the set. An
	# offset would index into a set that had shifted underneath it and skip
	# exactly as many components as were just written, leaving the operator
	# paged to the end with the gauge still short and no way to find what was
	# missed. A cursor anchored to the sort key is unaffected by rows
	# disappearing behind it, so "select all unattested" walks every row
	# exactly once with no client-side protocol to get wrong.
	#
	# The cursor component only has to still EXIST, not still match the filter
	# -- under UNATTESTED you will have just attested it out of the set. An
	# unrecognised cursor is an error, never a silent restart from the
	# beginning, which would turn a sweep into an infinite loop.
	#
	# totalCount is the FILTERED population, not the release size and not the
	# coverage denominator. Keep reading the gauge from
	# sbomComponentSupportCoverage: it is release-scoped on purpose and must
	# not be recomputed per page.
	#
	# LIMITATION, deliberate: only the page is hydrated, so ALL THREE graph
	# fields on the returned rows are page-scoped, not release-scoped --
	# dependencies, dependedOnBy and ancestors. A component that depends on 40
	# things will report only those that happened to sort onto the same page,
	# which is WRONG data presented as complete, not merely partial. Do not
	# select them here. Each row's own parents array IS complete. Use the
	# unpaged getReleaseSbomComponents, or getReleaseSbomComponentGraph for a
	# single component, when the graph edges matter -- resolving them here
	# would mean loading the whole BOM, which is the cost this query exists to
	# avoid.
	getReleaseSbomComponentsPage(
		releaseUuid: ID!,
		attestation: SupportAttestationFilter = ALL,
		search: String,
		limit: Int,
		after: ID): ReleaseSbomComponentsPage!

	# releaseUuid is OPTIONAL and additive: omit it for the org-wide readiness number
	# (unchanged behaviour), pass it to scope the count to one release's own components.
	#
	# Both scopes are intended. Org-wide answers "how ready is this organisation"; the
	# release scope answers "how much of THIS BOM is disclosed", which is the only number
	# that may sit beside an export -- a gauge reading 100% next to a release whose export
	# carries nothing is the failure that scope exists to prevent.
	#
	# The release scope resolves its components through the same path the component list
	# walks, PRODUCT dependency unwind included, so the gauge and the list beneath it cannot
	# disagree. An empty release returns 0/0 rather than falling back to the org number.
	sbomComponentSupportCoverage(orgUuid: ID!, releaseUuid: ID): SbomComponentSupportCoverage

	"""
	THE FLEET QUESTION (D7): which units in the field outlive their software.

	Per in-field unit: the release it is judged on (what it REPORTED running, else what it
	was planned to run -- the row says which), the device support window resolved for its
	batch, the resulting risk, the soonest ATTESTED component end-of-support in that
	release, and how many attested components end before the device does.

	Units whose disposition is RETURNED, EXPLANTED, DISPOSED or LOST are excluded: they are
	not in service, and counting them inflates the number an operator acts on. A unit with
	no recorded disposition IS included -- absence of a record is not evidence of removal.

	Read-only. `page` is zero-based.
	"""
	devicesAtSupportRisk(orgUuid: ID!, clientUuid: ID, siteUuid: ID, page: Int, size: Int): DevicesAtSupportRiskPage
}

type Mutation {
	# user management
	acceptUserPolicies(tosAccepted: Boolean!, marketingAccepted: Boolean!, email: String): User
	verifyEmail(secret: String!): User
	inviteUser(invitationProperties: InviteUserInput!): AdminOrganization
	joinUserToOrganization(secret: String!): User
	cancelInvite(org: ID!, userEmail: String!): AdminOrganization
	updateUserPermissions(orgUuid: ID!, userUuid: ID!, permissionType: PermissionType, permissions: [PermissionInput]): OrgUserData
	updateUserName(name: String!): User
		
	# system global
	unSealSystem(secret: String): Boolean
	uploadLicense(license: String!): LicensePayload
	finalizeAllReleases: Boolean
	createOrganization(name: String!): Organization
	setEmailProperties(emailProperties: EmailPropertiesInput!): Boolean
	# Global setVulnCheckKevToken removed in V54 KEV per-org refactor;
	# use setVulnCheckKevTokenForOrg(orgUuid, token) below (org-admin scope).
	setDefaultOrganization(organization: ID!): Boolean
	inactivateUser(userUuid: ID!): User
	reactivateUser(userUuid: ID!): User
	sendTestEmail: Boolean
	
	# integrations
	createIntegration(integration: IntegrationInput!): Integration
	createTriggerIntegration(integration: IntegrationInput!): Integration
	deleteBaseIntegration(org: ID!, type: IntegrationType!): Boolean
	# Replace the capabilities asserted on an Integration. Org-admin
	# authorized; idempotent; preserves all other fields.
	updateIntegrationCapabilities(uuid: ID!, capabilities: [IntegrationCapability!]!): Integration
	# Replace the GitHub App private key (and optionally the App ID) on an existing
	# GITHUB integration without re-creating it. The key is normalized + re-encrypted
	# and the PR_VALIDATE-needs-key rule is re-asserted. A blank appId leaves the
	# stored App ID unchanged. Org-admin authorized.
	updateGithubAppCredentials(uuid: ID!, privateKey: String!, appId: String): Integration
	# "Test connection" for a GITHUB integration: validates the stored App key + App
	# ID by minting an App JWT and calling GitHub GET /app/installations. No
	# installation id needed (that lives on the trigger). Org-admin authorized.
	testGithubIntegration(uuid: ID!): GithubIntegrationTestResult
	# "Test credentials" for UNSAVED GitHub App input (the key + App ID typed into a
	# create/edit form), validated against GitHub WITHOUT persisting anything, so the
	# user can verify before saving. Org-admin authorized on the supplied org. The
	# privateKey is never logged/echoed -- only the verdict is returned.
	testGithubCredentialsInput(org: ID!, privateKey: String!, appId: String): GithubIntegrationTestResult
	# Delete a CI integration by uuid. Refuses with an error message
	# listing reference counts when any Webhook, GlobalPrValidationTriggerRule,
	# VcsRepository.outputTriggers entry, or ApprovalPolicy.globalOutputEvents
	# entry still points at this integration -- those have to be cleaned
	# up first so the integration delete doesn't silently break them.
	deleteCiIntegration(uuid: ID!): Boolean

	# KEV per-org integration management (V54 refactor). All three are
	# org-admin authorized on the target org. CISA_KEV is auto-created
	# enabled when an org is provisioned (migration backfill + new-org
	# hook), so the UI typically only calls enableKevSource/disableKevSource
	# for CISA. VULNCHECK_KEV is opt-in: the org admin sets a token via
	# setVulnCheckKevTokenForOrg, which lazily creates the integration row
	# (enabled) and fires an immediate async first sync.
	enableKevSource(orgUuid: ID!, source: IntegrationType!): Boolean
	disableKevSource(orgUuid: ID!, source: IntegrationType!): Boolean
	setVulnCheckKevTokenForOrg(orgUuid: ID!, token: String): Boolean

	# webhooks (inbound)
	createWebhook(webhook: WebhookInput!): Webhook
	updateWebhook(webhook: WebhookUpdateInput!): Webhook
	deleteWebhook(uuid: ID!): Boolean

	# cdx import
	importCyclonedxComponents(orgUuid: ID!, cdxJson: String!): [ImportComponentResult]
	
	# components and products
	createComponent(component: CreateComponentInput!): Component
	updateComponent(component: UpdateComponentInput!): Component
	createBranch(componentUuid: ID!, name: String!, versionSchema: String): Branch
	updateBranch(branch: BranchInput!): Branch
	"""
	Clone a branch / feature set under the same component or product: the new branch starts
	with the source's version schema (unless overridden), auto-integrate setting, manual
	dependencies and dependency patterns. branchType defaults to the source's type (a BASE
	source is cloned as the type its name resolves to). Name must be unique on the component.
	"""
	cloneBranch(branchUuid: ID!, name: String!, branchType: BranchType, versionSchema: String): Branch
	autoIntegrateFeatureSet(branchUuid: ID!): Release
	archiveBranch(branchUuid: ID!): Boolean
	archiveComponent(componentUuid: ID!): Boolean
	setNextVersion(branchUuid: ID!, versionString: String!, versionType: VersionType): Boolean
	"""
	Iterates active releases of the component and fills in identifiers for any that
	currently have an empty identifier list. Releases that already carry any identifier
	(PURL, CPE, TEI, etc.) are left untouched -- this mutation is intentionally narrow
	per design D13 / D15: v1 does not productize a "rebuild sid PURL on existing releases"
	flow. Operators wanting to migrate sid identity on already-identified releases must
	use a one-off script.
	"""
	updateComponentReleasesIdentifiers(componentUuid: ID!): Boolean
	
	createVcsRepository(vcsRepository: VcsRepositoryInput!): VcsRepository
	updateVcsRepository(vcsUuid: ID!, name: String, uri: String): VcsRepository
	"""
	Replace the VCS repository's output triggers. Constraint: at most one
	entry, and (if present) must be of type EXTERNAL_VALIDATION. Pass an
	empty list to clear.
	"""
	setVcsRepositoryOutputTriggers(vcsUuid: ID!, triggers: [ReleaseOutputEventInput!]!): VcsRepository
	"""
	Replace the org's global PR-validation trigger rules atomically.
	Each input rule must (a) carry a non-blank, org-unique {@code name},
	(b) compile as a valid Java regex, (c) supply a trigger of type
	EXTERNAL_VALIDATION whose {@code integration} resolves to a GITHUB
	integration in the same org with the PR_VALIDATE capability. Pass
	an empty list to clear all rules. SAAS-only -- the SAAS DataFetcher
	guards on installation type. List order is the priority order;
	send the rules in the order you want first-match-wins to honour.
	"""
	setGlobalPrValidationTriggerRules(orgUuid: ID!, rules: [GlobalPrValidationTriggerRuleInput!]!): Organization
	"""
	Replace the org's team-assignment rules wholesale. Each rule needs a name
	(unique within the org, case-insensitive), a compilable regex no longer than
	512 characters, and an ownerTeam that exists, is ACTIVE and belongs to this
	org. List order is the priority order; send the rules in the order you want
	first-match-wins to honour. Pass an empty list to clear all rules.
	Org-admin only.
	"""
	setGlobalTeamAssignmentRules(orgUuid: ID!, rules: [GlobalTeamAssignmentRuleInput!]!): Organization
	"""
	Replace the org's global approval-policy assignment rules
	atomically. Each input rule must (a) carry a non-blank, org-unique
	{@code name}, (b) compile as a valid Java regex in
	{@code namePattern}, (c) supply an {@code approvalPolicy} UUID
	that resolves to an existing policy in the same org. Pass an empty
	list to clear all rules. SAAS-only -- the SAAS DataFetcher guards on
	installation type. List order is the priority order; send the
	rules in the order you want first-match-wins to honour.
	"""
	setGlobalApprovalPolicyRules(orgUuid: ID!, rules: [GlobalApprovalPolicyRuleInput!]!): Organization
	"""
	Replace the organization's action-guard list. Each guard picks the components it governs by
	name pattern; a blank pattern governs every component in the org. Admin on the org required.
	"""
	setOrgActionGuards(orgUuid: ID!, guards: [ActionGuardInput!]!): Organization
	"""
	Lock a component by hand. Defaults to the strictest release rule: an administrator, with no
	attestation able to resolve it. ADMIN on the component required.
	"""
	lockComponent(componentUuid: ID!, reason: String!, unlockLevel: UnlockLevel,
		attestationRequirement: AttestationRequirement): Lock
	"""Lock one branch of a component. ADMIN on the component required."""
	lockBranch(branchUuid: ID!, reason: String!, unlockLevel: UnlockLevel,
		attestationRequirement: AttestationRequirement): Lock
	"""
	Release a lock, writing the LOCK_RELEASE attestation that is the record of it. Permission
	comes from the lock's effective level. `override` is an administrator releasing without the
	requirement being met -- allowed, never silent, and requires a reason.
	"""
	releaseLock(orgUuid: ID!, lockUuid: ID!, reason: String!, override: Boolean): Lock
	"""
	Claim or disown a commit. MINE makes it recognized, which is what lets a rule about
	accountability pass on the next build and what releases a lock waiting on it. It certifies
	nothing about the content.
	"""
	attest(subjectType: AttestationSubjectType!, subjectUuid: ID!, verdict: AttestationVerdict!,
		note: String): Attestation
	"""Revoke an attestation. The row stays and is marked; the history is the point."""
	revokeAttestation(uuid: ID!, reason: String!): Attestation
	"""
	Replace the guards written on one component. These accumulate with the guards its
	perspectives and its organization declare -- a component can add to what it is held to,
	never subtract from it.
	"""
	setComponentActionGuards(componentUuid: ID!, guards: [ActionGuardInput!]!): Component
	"""
	Replace the guards applying to every component of a perspective. Real perspectives only --
	a product-derived perspective is a view of a product, not something anybody configures.
	"""
	setPerspectiveActionGuards(uuid: ID!, guards: [ActionGuardInput!]!): Perspective
	archiveVcsRepository(vcsUuid: ID!): Boolean
	getNewVersionManual(branchUuid: ID!, action: ActionEnum): Version
	createSourceCodeEntry(sourceCodeEntry: SourceCodeEntryInput!): SourceCodeEntry
	addReleaseManual(release: ReleaseInput!): Release
	setComponentApiKey(componentUuid: ID!): ApiKeyForUser
	setOrgApiKey(orgUuid: ID!, apiType: ApiTypeEnum!, keyOrder: String, notes: String): ApiKeyForUser
	"Create an org-level key id with no secret yet; mint the first secret with addApiKeySecret"
	createOrgApiKey(orgUuid: ID!, apiType: ApiTypeEnum!, notes: String): ApiKey
	"Personal USER key for the calling user in this org: created without a secret and with an empty permission ceiling"
	createUserApiKey(orgUuid: ID!, notes: String): ApiKey
	"CLI browser login: approve the pending request with an existing key of mine (apiKeyUuid), or with a personal key created for this session in createKeyOrgUuid"
	approveCliLogin(userCode: String!, apiKeyUuid: ID, createKeyOrgUuid: ID, createKeyNotes: String, permissionType: PermissionType, permissions: [PermissionInput]): CliSession
	denyCliLogin(userCode: String!): Boolean
	"Revoke one of my CLI sessions, or (org admin) any session in my org; a key created for that session is deleted with it"
	revokeCliSession(uuid: ID!): Boolean
	"Org admins: trust identity tokens from an external issuer (issuer defaults per provider, e.g. GitHub Actions on github.com)"
	createFederatedTrustRule(orgUuid: ID!, name: String!, provider: FederatedProvider!, issuer: String, matcher: FederatedMatcherInput!, grant: FederatedGrantInput!, expiresDate: DateTime): FederatedTrustRule
	"Org admins: edit a rule; bumps its version, which invalidates tokens minted through it"
	updateFederatedTrustRule(uuid: ID!, name: String!, matcher: FederatedMatcherInput!, grant: FederatedGrantInput!, expiresDate: DateTime): FederatedTrustRule
	setFederatedTrustRuleStatus(uuid: ID!, status: FederatedTrustRuleStatus!): FederatedTrustRule
	deleteFederatedTrustRule(uuid: ID!): Boolean
	"Org admins: accept whatever owner id the next exchange presents"
	resetFederatedTrustRulePin(uuid: ID!): FederatedTrustRule
	"Org admins: accept whatever repository id the next exchange presents for this identity"
	resetFederatedIdentityPin(apiKeyUuid: ID!): ApiKey
	"Write user asks admins for a FREEFORM key: created at once as REQUESTED with the caller as holder and the proposed permissions; unusable until approved"
	requestFreeformApiKey(orgUuid: ID!, notes: String, permissionType: PermissionType, permissions: [PermissionInput]): ApiKey
	"Admin approves (ACTIVE, still without a secret) or denies (DENIED, reason appended to notes) a REQUESTED key"
	resolveApiKeyRequest(apiKeyUuid: ID!, approve: Boolean!, reason: String): ApiKey
	"Admin reassigns or clears (null) the holder of a FREEFORM key; the holder must be a member of the org"
	setApiKeyHolder(apiKeyUuid: ID!, holder: ID): ApiKey
	updateRelease(release: ReleaseInput!): Release
	updateReleaseLifecycle(release: ID!, newLifecycle: ReleaseLifecycleEnum!): Release

	"""
	Record an approval request on a release and notify the users able to act
	on it (APPROVAL_REQUESTED targeted notifications). `approvalEntries`
	defaults to every entry of the release's effective approval policy;
	entries already satisfied / disapproved or covered by an open request
	are skipped. Errors if nothing actionable remains. Requires WRITE on
	the release.
	"""
	requestReleaseApprovals(release: ID!, approvalEntries: [ID!]): ReleaseApprovalRequest

	"""
	Bulk-advance every release of a component whose lifecycle is
	≥ GENERAL_AVAILABILITY but < `targetLifecycle` to `targetLifecycle`.
	Pre-GA releases (PENDING, DRAFT, ASSEMBLED, READY_TO_SHIP) and
	terminal-state releases (CANCELLED, REJECTED) are untouched, as are
	releases already at or beyond the target. Each bumped release records
	a normal LIFECYCLE-CHANGED update event so per-release histories stay
	coherent and the CLE synthesis surfaces the bump as a merged
	component-level event by minute. `targetLifecycle` must be > GA
	(ordinal-bounded so the validation survives future enum additions);
	GA itself isn't a meaningful bulk target -- that's the natural state
	for assembled releases.
	"""
	bulkUpdateComponentReleaseLifecycle(componentUuid: ID!, targetLifecycle: ReleaseLifecycleEnum!): BulkLifecycleUpdateResult
	updateReleaseTagsMeta(release: ReleaseInput!): Release
	overrideApprovedEnvironments(releaseUuid: ID!, approvedEnvironments: [String!]!): Release
	addMarketingReleaseManual(marketingRelease: MarketingReleaseInput!): MarketingRelease
	updateMarketingRelease(marketingRelease: MarketingReleaseInput!): MarketingRelease
	modifyMarketingReleaseLifecycle(marketingReleaseUuid: ID!, newLifecycle: MarketingReleaseLifecycleEnum): MarketingRelease 
	archiveMarketingRelease(marketingReleaseUuid: ID!): Boolean
	releaseMarketingRelease(marketingRelease: MarketingReleaseInput!, marketingVersion: String!): MarketingRelease
	addApprovalRole(orgUuid: ID!, approvalRole: ApprovalRoleInput!): Organization
	deleteApprovalRole(orgUuid: ID!, approvalRoleId: String!): Organization
	updateOrganizationTerminology(orgUuid: ID!, terminology: TerminologyInput!): Organization
	updateOrganizationIgnoreViolation(orgUuid: ID!, ignoreViolation: IgnoreViolationInput!): Organization
	updateOrganizationSettings(orgUuid: ID!, settings: SettingsInput!): Organization
	# Admin-gated, org-scoped backfill of finding_change_events from the existing metrics_audit
	# history (board task #38, phase 2). Idempotent + restartable: re-running is a near no-op.
	# sinceRevisionDate bounds the lower edge of the audit window (null = full range). reseed=true
	# bypasses the per-release "already covered" skip and re-diffs covered history -- required after
	# the FindingChangeKind vocabulary widens so historical rows of the new kinds are emitted (and the
	# org's watermark is bumped to the current vocabulary version). Returns the number of releases
	# processed for the org.
	backfillFindingChangeEvents(org: ID!, sinceRevisionDate: DateTime, reseed: Boolean): Int
	createApprovalEntry(approvalEntry: ApprovalEntryInput!): ApprovalEntry
	archiveApprovalEntry(approvalEntryUuid: ID!): ApprovalEntry
	createApprovalPolicy(approvalPolicy: ApprovalPolicyInput!): ApprovalPolicy
	archiveApprovalPolicy(approvalPolicyUuid: ID!): ApprovalPolicy
	setGlobalInputEvents(approvalPolicyUuid: ID!, events: [ReleaseInputEventInput!]!): ApprovalPolicy
	setGlobalOutputEvents(approvalPolicyUuid: ID!, events: [ReleaseOutputEventInput!]!): ApprovalPolicy
	
	approveReleaseManual(release: ID!, approvals: [ReleaseApprovalInput!]): Release
	"""
	Ask this release's rules to look at it again.

	Rules are evaluated when the release changes, so a release whose promotion was withheld by a
	guard can sit still while the reason clears somewhere else -- a dependency is promoted, a lock
	is released, a scan finishes. Nothing about the release itself changed, so nothing re-evaluates
	it, and an approver without lifecycle permissions cannot finish what their approval started.

	This promotes nothing by itself: it re-runs the same evaluation the engine runs on any change,
	and every guard still applies. Triggers that already fired are not fired again, so the only
	thing that can happen is the thing that was withheld. Available to anyone who may write the
	component or who may approve anything on this release.
	"""
	reevaluateReleaseTriggers(release: ID!): Release
	
	# Analytics
	computeAnalyticsMetricsForDate(orgUuid: ID!, date: String!): DependencyTrackMetrics
	
	updateArtifactTags(artifact: ID!, tags: [TagRecordInput]!): Artifact
	addArtifactManual(artifactInput: CreateArtifactInput, artifactUuid: ID): Release

	addOutboundDeliverablesManual(deliverables: AddDeliverableInput!): Boolean
	releaseSbomExport(release: ID!, tldOnly: Boolean, ignoreDev: Boolean, structure: BomStructureType, belongsTo: ArtifactBelongsToEnum, mediaType: BomMediaType, excludeCoverageTypes: [ArtifactCoverageType], includeSupportMetadata: Boolean, includeInternalMetadata: Boolean): String
	releaseVdrExport(release: ID!, includeSuppressed: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum): String
	releaseVdrExportWithApproval(release: ID!, includeSuppressed: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum, targetApproval: String): String
	"""
	Generate a CycloneDX 1.6 VEX (Vulnerability Exploitability eXchange) document for a release.
	Filters vulnerabilities[] to decided analysis statements (EXPLOITABLE, NOT_AFFECTED, RESOLVED, FALSE_POSITIVE);
	IN_TRIAGE and analysis-less entries are excluded unless includeInTriage=true, in which case they are
	stamped with an explicit IN_TRIAGE analysis state. components[] is retained so the document is
	self-contained. Marked with VEX_DOCUMENT=true in metadata.properties. CE-compatible: supports DATE
	and LIFECYCLE snapshots.
	"""
	releaseCdxVexExport(release: ID!, includeSuppressed: Boolean, includeInTriage: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum): String
	"""
	SaaS-only. Generate a CycloneDX 1.6 VEX document with approval-snapshot support.
	Precedence: targetLifecycle > targetApproval > upToDate. Same filtering and metadata contract
	as releaseCdxVexExport.
	"""
	releaseCdxVexExportWithApproval(release: ID!, includeSuppressed: Boolean, includeInTriage: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum, targetApproval: String): String
	"""
	Generate an OpenVEX 0.2.0 document for a release. Reuses the same enrichment + snapshot +
	filtering pipeline as releaseCdxVexExport; each retained vulnerability is emitted as one
	OpenVEX statement. Status mapping: EXPLOITABLE→affected, NOT_AFFECTED→not_affected,
	FALSE_POSITIVE→not_affected (+ justification vulnerable_code_not_present), RESOLVED→fixed,
	IN_TRIAGE→under_investigation. CE-compatible: supports DATE and LIFECYCLE snapshots.
	"""
	releaseOpenVexExport(release: ID!, includeSuppressed: Boolean, includeInTriage: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum): String
	"""
	SaaS-only. Generate an OpenVEX 0.2.0 document with approval-snapshot support.
	Precedence: targetLifecycle > targetApproval > upToDate. Same status-mapping contract as
	releaseOpenVexExport.
	"""
	releaseOpenVexExportWithApproval(release: ID!, includeSuppressed: Boolean, includeInTriage: Boolean, upToDate: DateTime, targetLifecycle: ReleaseLifecycleEnum, targetApproval: String): String

	createFeatureSetFromRelease(featureSetName: String!, releaseUuid: ID!): Branch

	# Synchronously rebuild the SBOM component / dependency aggregation for a single release.
	# Operator escape hatch when a release is left with stale or empty release_sbom_components rows
	# (e.g. an earlier async reconcile failed). Returns true on success; throws on failure so the
	# caller sees the underlying error.
	reconcileReleaseSbomComponents(releaseUuid: ID!): Boolean
	"""
	Recompute a release's findings metrics from CURRENT scan and KEV state:
	re-gathers the release's artifacts, merges their (fan-out-maintained)
	metrics, re-applies the analysis overlay and re-stamps known-exploited
	membership against kev_assertions. No Dependency-Track round-trip -- this
	refreshes from data already ingested, so it is cheap and idempotent. Use
	forceReuploadDtrackData for a true org-wide re-analysis. Requires WRITE on
	the release (satisfied by component/org-scoped WRITE permissions).
	"""
	recomputeReleaseFindings(releaseUuid: ID!): Boolean
	"""
	Org-ADMIN repair for duplicate component registrations: several live
	COMPONENT-type components on one (vcs, repoPath) carrying the SAME name.
	Folds non-conflicting releases under the oldest component and archives the
	duplicates; on version conflicts archives without folding. Same-vcs groups
	with differing names are reported but never auto-merged. Same routine the
	enforceUniqueComponents startup sweep runs.
	"""
	repairDuplicateComponents(orgUuid: ID!): DuplicateComponentRepairSummary

	# Programmatic
	setApprovalsOnApiKey(apiKeyUuid: ID!, approvals: [String], notes: String): ApiKey
	setPermissionsOnFreeformApiKey(apiKeyUuid: ID!, permissionType: PermissionType, permissions: [PermissionInput]): ApiKey
	"""
	Edit just the notes field on an API key. Admin auth on the owning
	org -- paired with setPermissionsOnFreeformApiKey so a notes-only
	UI tab doesn't have to round-trip the full permissions list. Notes
	is a generic field on the api_keys recordData jsonb, so works for
	any key type (FREEFORM is the primary consumer today).
	"""
	setNotesOnApiKey(apiKeyUuid: ID!, notes: String): ApiKey
	deleteApiKey(apiKeyUuid: ID!): Boolean
	"""Add the second secret of a key id (rotation). Org admin. Returns the new secret once."""
	addApiKeySecret(apiKeyUuid: ID!, expiresDate: DateTime): ApiKeyForUser
	"""Replace one secret in place; tokens exchanged with the old one stop working. Org admin. Returns the new secret once."""
	regenerateApiKeySecret(apiKeyUuid: ID!, slot: Int!, expiresDate: DateTime): ApiKeyForUser
	"Set or clear (null) the expiry of one secret"
	setApiKeySecretExpiry(apiKeyUuid: ID!, slot: Int!, expiresDate: DateTime): ApiKey
	"""Retire or re-enable one secret without deleting it. Org admin."""
	setApiKeySecretActive(apiKeyUuid: ID!, slot: Int!, active: Boolean!): ApiKey
	"Remove one secret for good; the slot frees up and tokens exchanged with it stop working"
	deleteApiKeySecret(apiKeyUuid: ID!, slot: Int!): ApiKey
	"""Kill switch for the whole key id. Org admin."""
	setApiKeyStatus(apiKeyUuid: ID!, status: ApiKeyStatus!): ApiKey
	triggerReleasecompletionfinalizer(release: ID!): Boolean
	removeUser(org: ID!, user: ID!): Boolean


	archiveOrganization(orgUuid: ID!): Boolean
	
	createResourceGroup(orgUuid: ID!, name: String!): ResourceGroup

	acceptPolicies(acceptTos: Boolean!, acceptMarketing: Boolean!, email: String): User
	logout: Boolean
	updateEmailAddress(oldEmail: String!, newEmail: String!, makePrimary: Boolean!, acceptMarketing: Boolean!): Boolean
	resendEmailVerification: Boolean
	
	# User Groups
	createUserGroup(userGroup: CreateUserGroupInput!): UserGroupWebDto
	updateUserGroup(userGroup: UpdateUserGroupInput!): UserGroupWebDto
	createTeam(team: CreateTeamInput!): TeamWebDto
	updateTeam(team: UpdateTeamInput!): TeamWebDto

	# Vulnerability Analysis
	createVulnAnalysis(analysis: CreateVulnAnalysisInput!): VulnAnalysisWebDto
	updateVulnAnalysis(analysis: UpdateVulnAnalysisInput!): VulnAnalysisWebDto
	acceptVexStatementProposal(uuid: ID!, comment: String): VexStatementProposalWebDto
	rejectVexStatementProposal(uuid: ID!, reason: String): VexStatementProposalWebDto
	updateVexStatementProposal(uuid: ID!, updates: VexProposalUpdateInput!): VexStatementProposalWebDto
	attestMitigation(uuid: ID!, evidence: String!): MitigationAttestationWebDto
	waiveMitigation(uuid: ID!, reason: String!): MitigationAttestationWebDto

	# Perspectives
	createPerspective(org: ID!, name: String!): Perspective
	updatePerspective(uuid: ID!, name: String!): Perspective
	"""
	Set the sid override + authority segments on a real perspective (SaaS only;
	rejects product-derived perspectives with a clear error). Each field is
	optional -- null leaves the existing value unchanged. ENABLE/DISABLE override
	writes are rejected when the org is not in ENABLED_FLEXIBLE (D3 / G2).
	"""
	updatePerspectiveSidPurl(uuid: ID!, sidPurlOverride: SidPurlOverride, sidAuthoritySegments: [String!]): Perspective
	deletePerspective(uuid: ID!): Perspective
	setPerspectivesOnComponent(componentUuid: ID!, perspectiveUuids: [ID!]!): Component
	"""
	SaaS-only. Creates a component or product and atomically assigns it to the given
	perspective. Requires WRITE permission on the perspective. Only real perspectives
	(PerspectiveType.PERSPECTIVE) are allowed -- product-derived perspectives are rejected.
	Perspective org must match component's target org (enforced by authorization).
	"""
	createComponentInPerspective(component: CreateComponentInput!, perspectiveUuid: ID!): Component
	
	# Enrichment
	triggerEnrichment(artifact: ID!): EnrichmentTriggerResult
	
	# DTrack
	syncDtrackProjects(orgUuid: ID!): Boolean
	# Admin-only force re-upload: re-submit every synthetic bucket to DTrack
	# (existing project or a new one), triggering full re-analysis + re-ingest.
	forceReuploadDtrackData(orgUuid: ID!): Boolean
	# Fetch one vulnerability from the org's Dependency-Track by id and store
	# it as the org's vulnerability record; returns the merged details.
	# Requires WRITE on the organization. Fails with a message when the org
	# has no Dependency-Track integration or Dependency-Track does not know
	# the id.
	refreshVulnerabilityRecord(orgUuid: ID!, vulnId: String!): VulnerabilityRecordDetails

	# Instances
	createInstance(orgUuid: ID!, name: String, instanceType: InstanceType, namespace: String, uri: String!, environment: String, clusterId: ID): Instance
	createInstanceFromDto(instance: CreateInstanceInput!, plan: UpdateInstancePlanInput): Instance
	updateInstance(instance: InstanceInput!): Instance
	setInstanceApiKey(instanceUuid: ID!): ApiKeyForUser
	generateProductRelease(instanceUuid: ID!): [InstanceProductMapActual]
	archiveInstance(instanceUuid: ID!): Boolean

	# properties
	createProperty(property: PropertyInput!): Property

	# secrets
	createSecret(secret: SecretInput!): Secret
	updateSecretDistribution(orgUuid: ID!, secretUuid: ID!, permissions: [PermissionInput]): Secret
	updateSecretDetails( secretUuid: ID!, secret: SecretUpdateInput!): Secret
	deleteSecret(orgUuid: ID!, secretUuid: ID!): Boolean
	
	# BEAR integration
	setBearIntegration(org: ID!, uri: String!, apiKey: String!, skipPatterns: [String]): BearIntegration
	updateBearSkipPatterns(org: ID!, skipPatterns: [String]): BearIntegration
	deleteBearIntegration(org: ID!): Boolean!

	# AI Agents
	# Refine display fields on an existing Agent (name, icon, color,
	# notes, status). Only non-null fields are applied -- partial edits
	# can't blank unrelated fields. Hierarchy fields and the model
	# ontology pointer are immutable from this entry point; sub-agent
	# registration goes through spawnSubAgentProgrammatic.
	updateAgent(input: AgentUpdateInput!): Agent

	# Set the admin-chosen display label for an agent. Org-admin only.
	# Does NOT touch the registration `name` (the runtime resolution
	# key) -- pass null/blank to clear and fall back to name.
	setAgentDisplayName(uuid: ID!, displayName: String): Agent

	# Refine ModelOntology display fields (publisher, description,
	# purl, notes). Name + version are immutable identity -- re-register
	# under a new name+version pair if needed.
	updateModelOntology(input: ModelOntologyUpdateInput!): ModelOntology

	# AI-Agent policies (SAAS-only).
	#
	# Create or update an Agent policy. CEL is validated at write time
	# -- an invalid expression throws so a typo never silently no-ops
	# at evaluation. Use the same input to update (pass uuid).
	upsertAgentPolicy(input: AgentPolicyInput!): AgentPolicy

	# Toggle a policy's enabled flag without rewriting the rest.
	setAgentPolicyEnabled(uuid: ID!, enabled: Boolean!): AgentPolicy

	# Delete a policy (org admin only). Past verdicts on sessions keep
	# their recorded policy uuid for forensic value.
	deleteAgentPolicy(uuid: ID!): Boolean

	# Distribution module (SAAS-only): client + site CRUD. Pass uuid to
	# update. Deleting a client cascades to its sites (no DB FK).
	upsertClient(input: ClientInput!): Client
	"""Soft delete: archives the client, cascading to sites, shipments, and devices."""
	deleteClient(uuid: ID!): Boolean
	upsertSite(input: SiteInput!): Site
	"""Soft delete: archives the site, cascading to shipments and devices."""
	deleteSite(uuid: ID!): Boolean

	# Distribution module (SAAS-only): shipments (batch). shipProduct is
	# append-only (always a new row).
	shipProduct(input: ShipProductInput!): ShippedProduct
	"""Admin edit of an existing shipment (same input shape as shipProduct)."""
	updateShippedProduct(uuid: ID!, input: ShipProductInput!): ShippedProduct
	"""Soft delete: archives the shipment, cascading to its devices."""
	deleteShippedProduct(uuid: ID!): Boolean

	# Per-device layer. Phone-home (actual) and 821 disposition (tracking) are
	# per-device. updateDevicePlan records a field-repair / version change.
	upsertDevice(input: DeviceInput!): Device
	reportDeviceActual(uuid: ID!, input: ActualReportInput!): Device
	updateDeviceTracking(uuid: ID!, input: TrackingInput!): Device
	updateDevicePlan(uuid: ID!, expectedRelease: ID): Device
	"""Soft delete: archives the device."""
	deleteDevice(uuid: ID!): Boolean

	# Digital twin. addDeviceEvent records a field event (failure / repair /
	# replacement / inspection) anchored to the release ontology (hbomRef / purl).
	# reportDeviceState is the programmatic (API-key) phone-home: submit observed
	# digests (or a raw k8s image list) and reconcile against the expected release.
	addDeviceEvent(input: DeviceEventInput!): DeviceEvent
	"""Soft delete: archives the event."""
	deleteDeviceEvent(uuid: ID!): Boolean
	"""Operator-posted observed-state report (same payload as reportDeviceState, JWT auth)."""
	reportDeviceStateManual(report: DeviceStateReportInput!): Device

	# Rebuild a hardware release HBOM components from its BOM artifact.
	reconcileReleaseHbomComponents(releaseUuid: ID!): Boolean

	# Committer + signing-key management.
	upsertCommitter(input: CommitterInput!): Committer
	archiveCommitter(uuid: ID!): Committer
	enrollSigningKey(input: SigningKeyInput!): SigningKey
	revokeSigningKey(uuid: ID!): SigningKey
	"""
	Update the allowed_signers principal (identity) on an enrolled key.
	Operator JWT path. Fingerprint / pubKey are immutable; SSH keys
	must keep a non-blank identity. Pass null/blank to clear a GPG
	informational identity.
	"""
	updateSigningKeyIdentity(uuid: ID!, identity: String): SigningKey

	# Notifications framework -- synthetic event injection (Phase 2d).
	#
	# Write a curated synthetic event into the org's outbox so the rest
	# of the pipeline (fan-out, channel dispatch, history) can be
	# exercised end-to-end without waiting for a real CVE / VEX change.
	# Operator-only -- gated as ADMIN at ORGANIZATION scope. Returns the
	# persisted outbox event for the caller to link to the resulting
	# history rows (which land asynchronously on the next fan-out tick).
	injectSyntheticEvent(orgUuid: ID!, template: SyntheticEventTemplateEnum!): NotificationOutboxEventResult!

	# Notifications framework -- channel test (Phase 2d).
	#
	# Inject a synthetic event tagged with the given channel as the
	# direct test target. The fan-out worker skips subscription / CEL /
	# severity-gate evaluation and writes a single delivery row addressed
	# at this channel; the channel worker then dispatches the rendered
	# payload to the real webhook. Used by the "Test channel" button to
	# confirm a webhook is reachable + auth'd before relying on real
	# event traffic. Org-admin only; the channel must belong to the
	# caller's org.
	testNotificationChannel(channelUuid: ID!): NotificationOutboxEventResult!

	# Notifications framework -- channel CRUD (Phase 3).
	#
	# Upsert is one mutation per the rearm convention (see
	# upsertAgentPolicy, upsertCommitter). uuid null on the input = create;
	# uuid present = update. webhookUrl null/blank on update preserves
	# the existing encrypted value (rename without re-typing the URL).
	# Slack URL prefix is enforced server-side at save time.
	upsertNotificationChannel(input: NotificationChannelInput!): NotificationChannelResult!

	# Status flip (ENABLED / DISABLED). Free-form transitions; the
	# fan-out + dispatch workers already short-circuit on DISABLED so
	# this is the kill-switch surface. No-op when status already matches.
	setNotificationChannelStatus(uuid: ID!, status: NotificationChannelStatusEnum!): NotificationChannelResult!

	# Hard delete. In-flight deliveries pointing at this channel get
	# marked FAILED by the delivery worker (channel-no-longer-exists path).
	# Soft-delete semantics are available via setNotificationChannelStatus(DISABLED).
	deleteNotificationChannel(uuid: ID!): Boolean!

	# Notifications framework -- channel-group CRUD (Phase 13b).
	#
	# A channel group is a named, cross-type bundle of channels
	# ("security-oncall" = Slack #sec + Teams #leadership + Email
	# security@) referenceable from a subscription route. At fan-out
	# the route's channelGroups list is resolved to member channel
	# UUIDs and merged with the route's direct channels (dedup,
	# first-seen order preserved). Each member channel still produces
	# its own delivery row with independent retry / dedup / audit --
	# the group is purely a naming layer.
	#
	# Upsert: uuid null = create; uuid present = update. Service-layer
	# validation rejects empty channel lists, duplicate channel UUIDs,
	# missing channel UUIDs, and cross-org channel membership.
	# Cross-org reparent on update is also rejected.
	upsertNotificationChannelGroup(input: NotificationChannelGroupInput!): NotificationChannelGroupResult!

	# Hard delete. Subscriptions that referenced this group keep their
	# reference UUID; the fan-out treats a missing group as "no members"
	# and silently no-ops the group from the route's resolution. No
	# cascade -- operators may want to recreate a group with the same
	# name and have existing references stay broken until manually
	# repointed.
	deleteNotificationChannelGroup(uuid: ID!): Boolean!

	# Notifications framework -- subscription CRUD (Phase 3).
	#
	# Upsert: uuid null = create, present = update. Service-layer
	# validation enforces: CEL filter compiles + meets the safety caps,
	# every route channel uuid exists in the same org, record_data
	# stays under the 256 KB JSONB cap.
	upsertNotificationSubscription(input: NotificationSubscriptionInput!): NotificationSubscriptionResult!

	# Status flip (ACTIVE / DISABLED / PREVIEW). PREVIEW is the
	# observe-only mode used during Quick Start verification; the
	# fan-out worker's active-subscription query treats it like
	# DISABLED for live traffic. No-op when status already matches.
	setNotificationSubscriptionStatus(uuid: ID!, status: NotificationSubscriptionStatusEnum!): NotificationSubscriptionResult!

	# Hard delete. Customers wanting reversible pause flip status to
	# DISABLED instead.
	deleteNotificationSubscription(uuid: ID!): Boolean!

	# Notifications framework -- Inbox MVP read-state (Phase 14).
	#
	# markNotificationRead: idempotent. A repeat call on the same
	# (caller × delivery) is a no-op upsert; read_at anchors to the
	# FIRST read so the inbox can show "you saw this 3 days ago"
	# without drifting on every re-render. Authorization: the caller
	# must be able to see this delivery under the inbox visibility
	# filter (org-admin tier OR perspective-member with intersecting
	# perspectives) -- toggling read-state of a delivery you can't see
	# is rejected, not silently succeeded.
	markNotificationRead(deliveryUuid: ID!): NotificationInboxItem!

	# markNotificationUnread: returns true when an existing read row
	# was removed, false when the (caller × delivery) pair was already
	# unread. Same visibility auth as markNotificationRead.
	markNotificationUnread(deliveryUuid: ID!): Boolean!

	# Mark every currently-visible-and-unread delivery in the org as
	# read for the caller. Returns the count of newly-created read
	# rows AND a hasMore flag -- the backend caps a single sweep at
	# 500 to bound the per-call work; the UI uses hasMore to decide
	# whether to surface "re-run to clear the remaining" guidance.
	# Bulk variant of markNotificationRead; same visibility scope
	# (org-admin or perspective-member).
	#
	# Note: ignores notificationInbox's status / eventType / unreadOnly
	# filters by design -- "Mark all as read" is the user-facing
	# kill-switch for the whole inbox-tab badge, not a scoped sweep.
	# A future "Mark filtered as read" would land as a separate
	# mutation that takes the same filter inputs as notificationInbox.
	markAllNotificationsRead(orgUuid: ID!, inboxScope: NotificationInboxScope = PERSONAL): MarkAllNotificationsReadResult!

	# FDA-Readiness-1: manufacturer attests a component's support level / milestone dates.
	# Server-set source=MANUAL, attester recorded, appended to the append-only attestation
	# history. Dates are ISO-8601 (YYYY-MM-DD).
	#
	# levelOfSupport is the manufacturer's ATTESTED claim about what the upstream maintainer
	# is actually doing -- the thing FDA asks for, which cannot be computed from dates. It is
	# stored, and is NOT the same field as the derived supportStatus; the two are surfaced
	# separately and never reconciled, so a reviewer can see when they disagree.
	#
	# assessedAt is an RFC-3339 instant stating when the HUMAN assessed, which need not be
	# when they filed it ("read the advisory on the 12th, recorded it on the 30th"). Omit it
	# to mean now. A malformed value is rejected, never silently defaulted.
	#
	# state: WITHDRAWN retracts an attestation without erasing it -- the row and its history
	# survive, and exports stop making the claim. This is how a mistaken attestation is
	# corrected, because a regulatory record is superseded rather than deleted.
	#
	# Each date argument is independent: an omitted one leaves that milestone's own date AND
	# provenance untouched (so e.g. an EOL asserted from a different source than EOS survives
	# an EOS-only edit) -- only a non-null value upserts that milestone.
	#
	# reason records WHY this write happened. It is stored on the audit row and is NEVER
	# exported. Do not confuse it with justification, which is the basis for the
	# level-of-support CLAIM and IS exported: keeping them separate is what stops a milestone
	# removal note ("removed a typo'd EOL") from becoming the stated reason a third party's
	# project was called abandoned. REQUIRED when clearMilestones is non-empty.
	#
	# clearMilestones REMOVES milestones, and is the only way to correct a mistaken date. A
	# null date means "leave alone", so without this a typo'd endOfLife is re-merged by every
	# later write and permanently blocks any date after it; WITHDRAWN is not a substitute,
	# because it suppresses the whole component from exports and coverage rather than removing
	# the one wrong fact. Clearing still SUPERSEDES rather than erases: the removal writes an
	# audit row carrying `reason`, so the history keeps what was claimed, when it was
	# withdrawn and why. Setting and clearing the same milestone in one call is rejected.
	#
	# assessedAt dates the level-of-support claim and is PRESERVED across writes that do not
	# supply it or re-assert a level, so editing a date cannot silently re-date an older
	# attestation.
	setSbomComponentSupport(sbomComponentUuid: ID!, levelOfSupport: LevelOfSupport, justification: String, assessedAt: String, state: SupportState, endOfGuaranteedSupportDate: String, endOfSupportDate: String, endOfLifeDate: String, supportNotes: String, supportParty: SupportParty, clearMilestones: [SupportMilestoneType!], reason: String): SbomComponent

	# Attest MANY components in one pass, reporting PER COMPONENT rather than as a count.
	#
	# Three rules: ROOT components are skipped (the application itself is not a third-party
	# dependency to attest); an already-attested component is SKIPPED, never overwritten, so a
	# sweep cannot flatten a considered per-component judgement; and therefore a re-run applies
	# nothing. Each component is written in its own transaction, so one rejection fails that
	# component alone.
	#
	# The result carries a per-item list, not just a count, because skip-and-report is only
	# useful if the caller can show WHICH rows were skipped and why -- "312 applied" of 450
	# leaves an operator no way to find the other 138, and the two skip reasons need
	# different responses.
	#
	# That list is WRAPPED in a response type rather than returned bare, matching the other
	# bulk mutations in this file. The input is an unbounded [ID!]!, so this surface will
	# eventually need to say something about the batch as a whole -- a cap, a truncation
	# flag -- and a bare list can never gain a sibling field without a breaking change. The
	# schema is carried into the Community Edition verbatim, so that change is not available
	# later.
	#
	# "Already attested" here means exactly what the coverage gauge means: a MANUAL attestation
	# that is not WITHDRAWN. Row-existence would be a different, weaker test, and a bulk sweep
	# that used it could never close the gap the gauge reports -- a withdrawn attestation reads
	# as unattested on the gauge, so bulk must be able to re-attest it.
	#
	# SINGLE-ORG BY CONSTRUCTION: the organization is taken from the FIRST component in
	# sbomComponentUuids and every other id must resolve within it. Ids from another org
	# come back as FAILED "component not found in this organization" rather than being
	# written, so a caller cannot smuggle a foreign component into an authorized batch.
	#
	# NO state OR clearMilestones ARGUMENT, deliberately. Both would be dead on this mutation:
	# it only writes rows it has judged un-attested, so any row with a milestone to clear is
	# skipped first, and on a fresh row a clear is rejected as "not set" -- clearMilestones
	# could never succeed. A bulk WITHDRAWN is likewise incoherent: fresh attestations are
	# implicitly ATTESTED, so it would conjure an assessment and retract it in one call. Use
	# the single-component mutation for both. `reason` IS accepted: it records why this batch
	# happened, on the audit row.
	# batchId: OPTIONAL, and normally omitted. The server issues one per call and returns it
	# on SbomComponentSupportBulkResponse; pass that value back on batches 2..n of a paged
	# sweep so the whole sweep is ONE id in the audit history. Supplying an arbitrary id is
	# accepted and not validated -- see the resolver for why validating it would break the
	# legitimate paged case, and what that exposure is bounded to.
	#
	# At most 1000 uuids per call (SbomComponentService.BULK_SUPPORT_MAX_IDS). A larger call
	# is refused outright rather than truncated, because a silently truncated sweep reports
	# success over components it never wrote. Split and reuse the batchId.
	bulkSetSbomComponentSupport(sbomComponentUuids: [ID!]!, levelOfSupport: LevelOfSupport, justification: String, assessedAt: String, endOfGuaranteedSupportDate: String, endOfSupportDate: String, endOfLifeDate: String, supportNotes: String, supportParty: SupportParty, reason: String, batchId: ID): SbomComponentSupportBulkResponse!
}



