# Capabilities a GITHUB integration is wired up to perform. Picked at
# create/update time, validated by the server, and used both as a UI
# filter (e.g. the "create webhook" picker only shows integrations with
# WEBHOOK) and as a runtime guard on outbound dispatch paths.
enum IntegrationCapability {
	WORKFLOW_DISPATCH
	PR_VALIDATE
	WEBHOOK
}

input IntegrationInput {
	org: ID!
	uri: String
	identifier: String!
	secret: String!
	type: IntegrationType!
	frontendUri: String
	tenant: String
	client: String
	note: String
	schedule: String
	capabilities: [IntegrationCapability!]
}

enum IntegrationType {
	GITHUB
	GITLAB
	JENKINS
	ADO
	SLACK
	MSTEAMS
	DEPENDENCYTRACK
	# KEV catalog sources (V54 per-org refactor). Must stay in sync with the
	# Java IntegrationType enum: enableKevSource/disableKevSource take these as
	# an input arg and configuredBaseIntegrations returns them as output, so a
	# missing value here breaks both coercion (enable/disable) and output
	# serialization (every org has a CISA_KEV row after the V54 backfill).
	CISA_KEV
	VULNCHECK_KEV
}

"""What needs a person's attention: what is locked, and what nobody has claimed."""
type IntegrityInbox {
	activeLocks: [Lock!]
	"""Commits behind those locks that nobody is accountable for."""
	unrecognizedCommits: [UnrecognizedCommit!]
	"""Locks that need an administrator because a cause was disowned or contested."""
	escalatedLocks: [Lock!]
}

input InviteUserInput {
	org: ID!,
	email: String!,
	type: PermissionType!
}

type InvitedObject {
	email: String
	type: PermissionType
	challengeExpiry: DateTime
}

# A named ransomware campaign (with optional reference URL). Empty for CISA,
# which supplies no campaign names; populated by richer sources.
type KevRansomwareCampaign {
	name: String!
	url: String
}

# Whether a source reports a vulnerability as used in known ransomware
# campaigns. Three-state so "source says no" (UNKNOWN) and "source is
# silent" (UNSPECIFIED) stay distinct.
enum KevRansomwareStatus {
	KNOWN
	UNKNOWN
	UNSPECIFIED
}

# KEV detail for one CVE: the aggregated ransomware status plus every
# source's assertion (active and revoked).
type KevRecordDetails {
	cveId: String!
	ransomwareStatus: KevRansomwareStatus
	assertions: [KevSourceAssertion!]!
}

# One source's assertion that a CVE is known-exploited. revokedDate set means
# the source withdrew the listing -- the CVE still counts as KEV, the date is
# shown as a note. Date fields stay feed-format strings (yyyy-MM-dd).
type KevSourceAssertion {
	source: String!
	revokedDate: String
	vendorProject: String
	product: String
	vulnerabilityName: String
	dateAdded: String
	shortDescription: String
	requiredAction: String
	dueDate: String
	ransomwareStatus: KevRansomwareStatus
	ransomwareCampaigns: [KevRansomwareCampaign!]
	notes: String
	cwes: [String!]
}

# Merged view of one vulnerability across its upstream sources. Descriptive
# fields come from the highest-priority source that has them (GitHub, then
# OSV, then NVD); cwes, aliases and references are unions.
type VulnerabilityRecordDetails {
	primaryVulnId: String!
	aliases: [String!]!
	title: String
	description: String
	severity: VulnerabilitySeverity
	cwes: [String!]!
	# Merged scores: at most one entry per VulnScoreType, in VulnScoreType
	# declaration order. Each is taken from the highest-priority source (GitHub,
	# then OSV, then NVD) that published one; for CVSS a published score from any
	# source beats one computed from a vector.
	scores: [VulnScore!]!
	published: DateTime
	updated: DateTime
	references: [VulnerabilityReference!]!
	sources: [VulnerabilitySourceSnapshot!]!
	firstSeenDate: DateTime
	lastUpdatedDate: DateTime
}

# One score of one type (CVSS v2 / v3 / v4, EPSS, OWASP Risk Rating).
# - score: the primary number (CVSS base score, EPSS probability 0..1); null
#   for OWASP_RR, which has only sub-scores. A CVSS v4 score computed from a
#   vector (scoreSource COMPUTED_FROM_VECTOR) scores the whole vector as given,
#   so any threat / environmental metrics in it count.
# - subScores: CVSS v2 / v3 IMPACT and EXPLOITABILITY, EPSS PERCENTILE, OWASP_RR
#   LIKELIHOOD / TECHNICAL_IMPACT / BUSINESS_IMPACT. On Dependency-Track 5 the
#   CVSS entries carry no IMPACT / EXPLOITABILITY sub-scores.
# - upstreamSource and scoreSource describe merged entries only and are always
#   null on per-source entries. On a merged entry they can also be null when
#   the record was stored before scores were tracked per source.
type VulnScore {
	type: VulnScoreType!
	score: Float
	vector: String
	subScores: [VulnSubScore!]!
	upstreamSource: UpstreamSource
	scoreSource: ScoreSource
}

# One named secondary number of a VulnScore.
type VulnSubScore {
	type: VulnSubScoreType!
	value: Float!
}

# Kind of score. Lists are returned in this declaration order.
enum VulnScoreType {
	CVSS_V2
	CVSS_V3
	CVSS_V4
	EPSS
	OWASP_RR
}

# Name of a VulnSubScore; which score types carry which is listed on VulnScore.
enum VulnSubScoreType {
	IMPACT
	EXPLOITABILITY
	PERCENTILE
	LIKELIHOOD
	TECHNICAL_IMPACT
	BUSINESS_IMPACT
}

# Whether a merged score was published by the upstream feed or computed by
# ReARM from the vector the feed published without a score.
enum ScoreSource {
	UPSTREAM
	COMPUTED_FROM_VECTOR
}

# One advisory link; label is the link text when the source supplied one.
type VulnerabilityReference {
	url: String!
	label: String
}

# One upstream feed's view of the vulnerability, as last fetched.
type VulnerabilitySourceSnapshot {
	upstreamSource: UpstreamSource
	upstreamVulnId: String
	severity: VulnerabilitySeverity
	# What this feed published. Today this also holds at most one entry per
	# type, but unlike the merged list that is not part of the contract: a feed
	# may later carry, for example, a primary and a secondary score of the same
	# type, so clients must not key per-source entries by type alone.
	scores: [VulnScore!]!
	lastFetchedDate: DateTime
	lastModifiedDate: DateTime
}

# Advisory feed a vulnerability snapshot came from. OTHER is any feed without
# its own value here.
enum UpstreamSource {
	GITHUB
	OSV
	NVD
	VULNDB
	OTHER
}

# The manufacturer's ATTESTED claim about what a component's upstream maintainer is
# actually doing -- FDA's "level of support provided through monitoring and maintenance
# from the software component manufacturer" (V.A.4(b)). Distinct from SupportStatus,
# which is derived from dates, and never reconciled with it.
#
# Deliberately THREE members and no "unknown": FDA gives three words, CycloneDX taxonomy
# PR #186 has three, and CLE has no such vocabulary. "Assessed but indeterminate" is a
# null level plus a justification, which is the L1021-1022 mechanism for being unable to
# provide the information and a stronger record than an undefined token.
#
# NO_LONGER_MAINTAINED and ABANDONED are negative claims about a named third party and
# REQUIRE a justification. FDA defines neither term, so an organisation must define the
# boundary once in its submission narrative and apply it consistently; ReARM ships no
# default definition for either.
enum LevelOfSupport {
	ACTIVELY_MAINTAINED
	NO_LONGER_MAINTAINED
	ABANDONED
}

type LicensePayload {
	baseUri: String
	validFrom: DateTime
	validTo: DateTime
	maxWriteUsers: Int
	maxReadUsers: Int
	globalUserCounts: GlobalUserCounts
}

enum LocationType {
	PURL
	CODE_POINT
}

# Phase 14 Inbox MVP -- markAllNotificationsRead result. See the
# mutation's javadoc for the cap rationale and the count/hasMore
# semantics.
type MarkAllNotificationsReadResult {
	count: Int!
	hasMore: Boolean!
}

type MarketingRelease {
	uuid: ID
	version: String
	status: Status
	org: ID
	orgDetails: Organization
	component: ID
	componentDetails: Component
	notes: String
	tags: [TagRecord]
	lifecycle: MarketingReleaseLifecycleEnum
	integrateType: IntegrateType
	integrateBranch: ID
	integrateBranchDetails: Branch
	devReleasePointer: ID
	lastUpdatedBy: ID
	createdDate: DateTime
	devReleaseDetails: Release
	events: [MarketingReleaseEvent]
}

type MarketingReleaseEvent {
	release: ID
	releaseDetails: Release
	lifecycle: MarketingReleaseLifecycleEnum
	date: DateTime
	wu: WhoUpdated
}

input MarketingReleaseInput {
	uuid: String
	version: String
	status: Status
	org: ID
	component: ID
	notes: String
	tags: [TagRecordInput]
	lifecycle: MarketingReleaseLifecycleEnum
	integrateType: IntegrateType
	integrateBranch: ID
	devReleasePointer: ID
}

type MarketingReleaseLifecycle {
	lifecycle: MarketingReleaseLifecycleEnum
	suffix: String
	prettyName: String
	ordinal: Int
}

enum MarketingReleaseLifecycleEnum {
	FIRST_MENTION
	ALPHA_TESTING
	BETA_TESTING
	RELEASE_CANDIDATE
	GENERAL_AVAILABILITY
	END_OF_LIFE
}

"""
A single re-scan-driven finding change for one release, bucketed at the date the change took
effect (the metrics_audit revision date, NOT the release creation date). Exactly one of
vulnerability / violation / weakness is non-null. previousSeverity is populated for
SEVERITY_INCREASED and SEVERITY_DECREASED (the pre-change severity).
"""
type MetricsRevisionFindingChange {
	changeDate: DateTime!
	changeKind: FindingChangeKind!
	releaseUuid: ID!
	version: String!
	componentUuid: ID!
	componentName: String!
	"ADDITIVE (board task F7b): the producing branch, so the timeline drawer can distinguish rows that share one component@version."
	branchUuid: ID
	branchName: String
	vulnerability: ReleaseVulnerabilityInfo
	violation: ReleaseViolationInfo
	weakness: ReleaseWeaknessInfo
	previousSeverity: String
}

# One page of the over-time finding-change timeline (findingChangeTimelineByDate). total is the full count;
# since is the retention-clamp lower bound (non-null only when the window predated the retention horizon).
type MetricsRevisionFindingChangePage {
	items: [MetricsRevisionFindingChange!]!
	total: Int!
	page: Int!
	pageSize: Int!
	since: DateTime
	"ADDITIVE (board task F4): true when total is a FLOOR, not the true count -- the org-scope ALL_POSTURE scan hit its row cap, so more events exist than were counted. Render the total as 'N+' and hint to narrow the window. Always false for the release-anchored (default) scope, which is unbounded."
	truncated: Boolean!
}

type MitigationAttestationWebDto {
	uuid: ID!
	org: ID!
	proposal: ID!
	claimType: ClaimType!
	claimText: String!
	scope: AnalysisScope!
	scopeUuid: ID!
	assignedTo: ID
	assignedAt: DateTime
	deadline: DateTime
	status: AttestationStatus!
	evidence: String
	attestedAt: DateTime
	attestedBy: ID
	statusReason: String
}

input ModelOntologyUpdateInput {
	uuid: ID!
	publisher: String
	description: String
	purl: String
	notes: String
}

type MostVulnerableComponent {
	componentuuid: ID
	componentname: String
	componenttype: ComponentType
	metrics: DependencyTrackMetrics
}

type NoneBranchChanges {
	branchUuid: ID!
	branchName: String!
	componentUuid: ID
	componentName: String
	releases: [NoneReleaseChanges!]!
	changeType: ChangeType
}

type NoneChangelog {
	componentUuid: ID!
	componentName: String!
	orgUuid: ID!
	# firstRelease/lastRelease are nullable on ALL ComponentChangelog members even though only
	# AggregatedChangelog has a null-producing path (the posture empty-window bypass): GraphQL's
	# OverlappingFieldsCanBeMerged rule rejects a merged inline-fragment selection when the same
	# field name has different nullability across union members (FieldsConflict 400, observed live).
	firstRelease: ReleaseInfo
	lastRelease: ReleaseInfo
	branches: [NoneBranchChanges!]!
	"ADDITIVE (board task #37): re-scan-driven finding changes over time, read from finding_change_events. Defaults to empty."
	overTimeFindingChanges: [MetricsRevisionFindingChange!]!
	"ADDITIVE (board task #38, phase 3): effective lower bound the over-time read started at when the requested window was clamped to the retention horizon; null when not clamped."
	overTimeFindingChangesSince: DateTime
}

type NoneOrganizationChangelog {
	orgUuid: ID!
	dateFrom: DateTime!
	dateTo: DateTime!
	components: [ComponentChangelog!]!
	"ADDITIVE (board task #37): org-wide re-scan-driven finding changes over time, read from finding_change_events. Defaults to empty."
	overTimeFindingChanges: [MetricsRevisionFindingChange!]!
	"ADDITIVE (board task #38, phase 3): effective lower bound the over-time read started at when the requested window was clamped to the retention horizon; null when not clamped."
	overTimeFindingChangesSince: DateTime
}

type NoneProductChangelog {
	componentUuid: ID!
	componentName: String!
	orgUuid: ID!
	firstRelease: ReleaseInfo
	lastRelease: ReleaseInfo
	productReleases: [ProductReleaseChanges!]!
}

type NoneReleaseChanges {
	releaseUuid: ID!
	version: String!
	lifecycle: ReleaseLifecycleEnum!
	commits: [CodeCommit!]!
	sbomChanges: ReleaseSbomChanges!
	findingChanges: ReleaseFindingChanges!
	createdDate: DateTime!
	"ADDITIVE (changelog re-scan visibility): true when this is the component's first release EVER -- its finding/SBOM sections are empty because there is no baseline to diff against, not because nothing changed."
	baselineRelease: Boolean!
}

# Channel-group write input (Phase 13b). uuid null = create; uuid
# present = update. Every {@code channels} UUID must resolve to a
# channel in the same {@code org}; duplicate UUIDs within the list
# are rejected at save time. Empty {@code channels} list is also
# rejected -- a group with zero members would silently no-op every
# route that referenced it.
input NotificationChannelGroupInput {
	uuid: ID
	# Optimistic-locking gate. See NotificationChannelInput.expectedRevision.
	expectedRevision: Int
	org: ID!
	resourceGroup: ID
	name: String!
	channels: [ID!]!
}

# Channel-group summary (Phase 13b). Pure-naming layer -- no per-type
# config, no secrets, no status. {@code channels} is the ordered list
# of member channel UUIDs (each one points at a NotificationChannel
# in the same org; cross-org membership is rejected at save time).
# revision / createdDate / lastUpdatedDate ride along so the UI can
# show "last edited by whom, when" without a second round-trip.
type NotificationChannelGroupResult {
	uuid: ID!
	org: ID!
	resourceGroup: ID
	name: String!
	channels: [ID!]!
	revision: Int!
	createdDate: String
	lastUpdatedDate: String
}

# Channel write input. uuid null = create; uuid present = update. The
# per-type secret config lives in a nested input matching the channel
# type -- customer supplies the one matching `type` and the service
# ignores the others. On update, leaving the matching config null
# preserves the existing encrypted value ("rename without re-typing").
input NotificationChannelInput {
	uuid: ID
	# Optimistic-locking gate. On update, the UI sends the revision
	# value it captured at Edit-load time; the service rejects the
	# save when the current DB row's revision is higher (a concurrent
	# admin edit landed between load and save). Null on create or for
	# callers opting out of the check.
	expectedRevision: Int
	org: ID!
	resourceGroup: ID
	name: String!
	type: NotificationChannelTypeEnum!
	status: NotificationChannelStatusEnum
	slackConfig: NotificationSlackChannelConfigInput
	webhookConfig: NotificationWebhookChannelConfigInput
	emailConfig: NotificationEmailChannelConfigInput
	teamsConfig: NotificationTeamsChannelConfigInput
	sentinelConfig: NotificationSentinelChannelConfigInput
}

# Channel summary. encryptedSecret is NEVER projected through this
# read surface -- webhook URLs / SMTP passwords are set-only.
#
# configData is intentionally omitted in Phase 2e. The blob can carry
# Slack/Teams webhook URLs (when the customer chose to store them as
# config rather than as the encrypted secret), and a webhook URL is
# itself an auth credential -- exposing it through an org-admin read
# would let any admin lift production-channel URLs and post arbitrary
# content. Phase 3 channel CRUD introduces typed input fields that
# split credential-vs-display; the read surface stays conservative.
type NotificationChannelResult {
	uuid: ID!
	org: ID!
	resourceGroup: ID
	name: String!
	type: NotificationChannelTypeEnum!
	status: NotificationChannelStatusEnum!
	# Row revision (bumped manually on each save -- the underlying
	# Integration row has no Hibernate @Version); round-tripped as
	# expectedRevision on the next save to reject concurrent admin
	# edits. See the NotificationSubscriptionResult.revision comment.
	revision: Int!
	# Effective email digest policy (EMAIL channels only; null for
	# other types). Defaults applied: absent config reads back as
	# ROLLING / PT24H. Not credentials -- safe on the read surface,
	# unlike configData (see type comment above).
	digestMode: NotificationEmailDigestModeEnum
	digestInterval: String
	# Recipient inbox addresses (EMAIL channels only; null for other
	# types). Display data, not credentials -- the edit UI needs the
	# current list to render. The configData embargo stays in force
	# for every other type.
	emailRecipients: [String!]
	# Operator-facing reason a channel was AUTO-disabled (e.g. its webhook
	# URL isn't the expected host). Null when enabled or manually disabled.
	# Lets the Catalog explain why a channel stopped delivering and prompt a
	# re-verify, instead of the failure only showing as FAILED History rows.
	disabledReason: String
}

# Channel lifecycle status. DISABLED short-circuits dispatch.
enum NotificationChannelStatusEnum {
	ENABLED
	DISABLED
}

# Channel destination types. Slack only in v1; Teams / SMTP / Sentinel
# land in later phases.
enum NotificationChannelTypeEnum {
	SLACK
	# Generic webhook (Phase 4). Customer-defined HTTPS endpoint with
	# optional bearer-token or HMAC-SHA256 auth. Catches PagerDuty /
	# Opsgenie / Splunk / in-house receivers without per-vendor work.
	WEBHOOK
	# Email recipient list (Phase 9). SMTP / SendGrid creds come from
	# system config; per-channel state is just the recipient list.
	EMAIL
	# Microsoft Teams via Power Automate Workflows webhook (Phase 10).
	# Adaptive Card v1.5 envelope; webhook URL is the auth credential.
	MS_TEAMS
	# Azure Sentinel via the Logs Ingestion API + DCR (Phase 11).
	# Six-field SP-credential + DCR-routing secret; client-credentials
	# OAuth bearer.
	SENTINEL
}

type NotificationDeliveriesPage {
	items: [NotificationDeliveryResult!]!
	totalCount: Int!
	limit: Int!
	offset: Int!
}

# Whether the delivery's originating outbox event was REAL traffic or
# a SYNTHETIC injection (channel test / Quick Start verify / harness).
enum NotificationDeliveryOriginEnum {
	REAL
	SYNTHETIC
}

# One delivery row -- the result of fan-out picking a channel for an
# event. Carries queue state (status, attemptCount, nextAttemptAt) for
# the operator UI's "what's happening with my notifications" view.
# subscriptionUuid is nullable for Phase 2d channel-test rows;
# channelUuid is nullable for per-user targeted rows (approval-request
# events), which bypass channel routing entirely.
# nextAttemptAt is nullable to match the projector's null defense --
# the DB column is non-null in practice, but the schema declaration
# stays permissive so a hypothetical future row with a null value
# wouldn't blow up the GraphQL layer.
type NotificationDeliveryResult {
	uuid: ID!
	org: ID!
	outboxEventUuid: ID!
	subscriptionUuid: ID
	channelUuid: ID
	status: NotificationDeliveryStatusEnum!
	origin: NotificationDeliveryOriginEnum!
	dedupKey: String
	attemptCount: Int!
	nextAttemptAt: String
	sentAt: String
	lastError: String
	createdDate: String!
	"""The outbox event's rendered payload as JSON (BUG 3); null when unavailable. Truncation sentinel past the byte cap."""
	payloadJson: String
}

# Lifecycle status of a single delivery row. Promoted to a typed
# GraphQL enum (Phase 2e layer-2) so filter args + output projections
# share one declaration and a typo in either direction is rejected at
# the parser instead of silently returning zero rows.
enum NotificationDeliveryStatusEnum {
	PENDING
	SENT
	FAILED
	ACKED
	# Rate limit hit at fan-out time -- delivery row persisted for
	# history but never dispatched.
	RATE_LIMITED
	# CEL evaluation aborted on the wall-clock budget; subscription
	# circuit-breaker may auto-disable.
	EVAL_TIMEOUT
	# Customer-initiated channel test from the "send test event" UI button.
	TEST
	# Subscription is in PREVIEW mode; render captured for history,
	# never dispatched.
	PREVIEW
	# Held in an EMAIL channel's rolling-cap digest window; flushed as
	# one digest email when the window expires.
	BATCHED
}

# Email-channel config (Phase 9; digest fields Phase 5). The "auth
# credential" for email is the system's SMTP / SendGrid setup on
# SystemInfoService; per-channel state is the recipient list plus the
# digest policy. Stored unencrypted in the channel's parameters
# (recipients aren't secret -- they're inbox addresses on customer
# infrastructure). Update semantics are per-field: null recipients
# preserves the existing list (digest-only update); null digest fields
# preserve the existing digest config. digestInterval is an ISO-8601
# duration (e.g. "PT24H"), accepted range PT5M..P7D. Absent digest
# config means rolling 24h digest (on by default); actionable events
# (approval requests / resolutions) always send immediately.
# Mid-window changes: switching digestMode to IMMEDIATE releases any
# already-batched rows for individual delivery right away; changing
# only digestInterval leaves the open batch's deadline as-is -- the
# new interval applies from the next window.
input NotificationEmailChannelConfigInput {
	recipients: [String!]
	digestMode: NotificationEmailDigestModeEnum
	digestInterval: String
}

# Email digest batching mode. ROLLING = at most one non-actionable
# email per digestInterval; overflow is held and flushed as a single
# digest email when the window expires. IMMEDIATE = no batching.
enum NotificationEmailDigestModeEnum {
	IMMEDIATE
	ROLLING
}

# CEL evaluation mode for subscription filters.
enum NotificationEvaluationModeEnum {
	PRESET
	ADVANCED
}

# Domain event types that can trigger notifications.
enum NotificationEventTypeEnum {
	NEW_VULN_AFFECTS_RELEASES
	VULNERABILITY_RECORD_UPDATED
	VEX_STATE_CHANGED
	RELEASE_CREATED
	RELEASE_LIFECYCLE_CHANGED
	RELEASE_BOM_DIFF
	APPROVAL_REQUESTED
	APPROVAL_RESOLVED
	INSTANCE_DEPLOYMENT_CHANGED
	INSTANCE_DEPLOYMENT_FAILED
}

input NotificationFilterInput {
	mode: NotificationEvaluationModeEnum!
	# Free-form preset state surfaced as a JSON string so the UI can
	# evolve the preset toggles without a schema bump per field.
	presetConfigJson: String
	# CEL expression. Validated server-side via NotificationCelEvaluator.
	celExpression: String
}

# Phase 14 Inbox MVP item. Sibling to NotificationDeliveryResult -- same
# core delivery fields (uuid, status, attemptCount, etc.) plus the
# per-caller read-state (readAt is null when unread for this user).
# Maintained as a separate type rather than extending
# NotificationDeliveryResult so the History view's projection
# stays clean (History is org-scoped audit, not per-user).
type NotificationInboxItem {
	uuid: ID!
	org: ID!
	outboxEventUuid: ID!
	subscriptionUuid: ID
	# Nullable: per-user targeted rows (approval requests) have no channel.
	channelUuid: ID
	# Server-resolved display name of the channel addressed by channelUuid.
	# Carried here so the non-admin notification bell never has to call the
	# admin-only channel-list query to label a row. Null when the channel
	# has been deleted (channelUuid no longer resolves to an Integration).
	channelName: String
	# Whether the addressed channel is currently enabled. Null when the row is
	# channel-less (targeted) or the channel was deleted. False means deliveries
	# to it are paused -- lets the inbox distinguish a disabled channel from a
	# deleted one instead of dead-ending at "(deleted channel)".
	channelEnabled: Boolean
	# Operator-facing reason a channel was auto-disabled (e.g. a bad webhook
	# URL); null when the channel is enabled, manually disabled, deleted, or
	# channel-less. Surfaced so a failed delivery explains itself.
	channelDisabledReason: String
	status: NotificationDeliveryStatusEnum!
	origin: NotificationDeliveryOriginEnum!
	dedupKey: String
	attemptCount: Int!
	nextAttemptAt: String
	sentAt: String
	lastError: String
	createdDate: String!
	# Null = unread for the calling user; non-null = ISO-8601 timestamp
	# of when the caller first marked this delivery read. Subsequent
	# re-reads are idempotent and do NOT advance this anchor -- the
	# inbox MVP needs a stable "first seen" cue.
	readAt: String
	# Event-type label from the originating outbox event. Lifted so the
	# inbox row can render the event kind without a separate lookup.
	eventType: NotificationEventTypeEnum
	# Severity rolled up from the outbox event payload. NONE when the
	# event type doesn't carry a severity (e.g. some VEX state changes).
	severity: NotificationSeverityEnum
	# Canonical human-rendered inbox text built server-side by
	# NotificationInboxFormatter. Mirrors what a user would see at the
	# top of their Slack / email notification but stays channel-agnostic.
	# Either can be null when the event payload is malformed; the UI
	# falls back to {eventType, severity} for a label-only row.
	title: String
	description: String
	# The originating outbox event's recordData serialized as a JSON
	# string. Lets the UI deep-link into the affected release /
	# vulnerability without an extra round-trip. UI parses on demand --
	# the schema doesn't enumerate per-event-type fields here so a new
	# event type doesn't break the inbox query.
	payloadJson: String
}

type NotificationInboxPage {
	items: [NotificationInboxItem!]!
	totalCount: Int!
	# Subset of totalCount that is currently unread for the caller --
	# convenient for the inbox-tab badge so the UI doesn't need a
	# separate notificationUnreadCount round-trip when it's already
	# rendering the page.
	unreadCount: Int!
	limit: Int!
	offset: Int!
}

# Inbox visibility scope for notificationInbox / notificationUnreadCount /
# markAllNotificationsRead. PERSONAL (default) = the caller's own component-team
# + perspective + targeted rows (an org admin is NOT auto-shown every delivery,
# so the bell and badge stay relevant). ORG_ALL = the org-wide firehose, honored
# only for admins; a non-admin request safely collapses to PERSONAL.
enum NotificationInboxScope {
	PERSONAL
	ORG_ALL
}

# Returned by injectSyntheticEvent + testNotificationChannel + the
# notificationOutboxEvent read query. The UI polls
# notificationDeliveries(eventUuid: ...) keyed by uuid to show the
# rendered output.
type NotificationOutboxEventResult {
	uuid: ID!
	org: ID!
	eventType: String!
	status: String!
	occurredAt: String!
	origin: String!
	dedupKey: String
	# Non-null only for testNotificationChannel -- the target channel.
	channelTestTarget: ID
}

input NotificationRateLimitInput {
	maxPerWindow: Int
	windowMinutes: Int
}

input NotificationRouteInput {
	whenSeverityAtLeast: NotificationSeverityEnum
	andEnvIn: [String!]
	# Re-uses the existing release-lifecycle enum (declared elsewhere
	# in this schema) so a customer using the same lifecycle name in
	# a route as in a release stays consistent.
	andLifecycleIn: [ReleaseLifecycleEnum!]
	# Direct channel UUIDs the route delivers to. May be empty when
	# channelGroups is non-empty -- at least one of {channels, channelGroups}
	# must resolve to a non-empty merged list at fan-out time, otherwise
	# the route is logged + skipped.
	channels: [ID!]!
	# Phase 12 perspective scoping: limit this route's deliveries to
	# events that touch a release in at least one of these perspectives.
	# Empty / unset = no perspective gate (match anything). The route
	# enrichment populates AffectedRelease.perspectives from the
	# release's component, and the fan-out intersects against this list.
	#
	# Null vs. [] equivalence: DGS coerces a missing / explicit-null
	# field to Java `null`; an explicit `[]` becomes an empty List.
	# Both are treated as "no gate" by the gate logic
	# (perspectiveGateMatches in NotificationFanOutService), so callers
	# may pass either shape with identical effect.
	perspectives: [ID!]
	# Phase 13b channel-group expansion. UUIDs of NotificationChannelGroups
	# whose member channels are merged with the route's direct {@code channels}
	# list at fan-out time. Missing groups (deleted, never existed) are
	# silently skipped; dedup is first-seen across {channels ⨁ groups}.
	# Same null/[] equivalence as perspectives: both treated as "no group
	# expansion."
	channelGroups: [ID!]
	# T3 team targeting. UUIDs of Teams (user groups) whose own
	# notificationChannels are merged into this route at fan-out time. Lets an
	# operator say "tell the Payments Team" without knowing which Slack channel
	# that is today, and keeps it correct when the team later changes channel.
	# Teams are resolved at fan-out, not at save: a team that no longer exists
	# contributes nothing rather than failing the route. Expands to team
	# CHANNELS only -- it does not push rows into members' inboxes, which have
	# their own visibility arms. Same null/[] equivalence as the fields above.
	teams: [ID!]
	# T4a owner-aware targeting. When true the route ALSO delivers to the owner
	# team of every component the event affects, resolved at fan-out from the
	# component's ownership (stored owner, else a matching team-assignment
	# rule). Complements `teams`: that names a FIXED set an operator must keep
	# up to date, this follows whatever currently owns the component, so
	# reassigning ownership needs no subscription edit.
	# Only OWNED / NON_DURABLE ownership delivers -- a suggestion is not an
	# owner and an archived owner team's channels are stale. USER owners
	# contribute no channel; they are reached through the inbox arms.
	# Null / false = no owner expansion.
	notifyComponentOwner: Boolean
}

# Azure Sentinel channel config (Phase 11). Six required fields:
# the three SP-credential fields (tenantId, clientId, clientSecret)
# acquire an Azure AD bearer token; the three DCR-routing fields
# (dcrEndpoint, dcrImmutableId, streamName) target the Logs Ingestion
# API. All six are serialized together as a SentinelChannelSecret blob
# and encrypted at rest. On update, leaving the SP-credential fields
# blank preserves the existing encrypted value.
input NotificationSentinelChannelConfigInput {
	tenantId: String
	clientId: String
	clientSecret: String
	dcrEndpoint: String
	dcrImmutableId: String
	streamName: String
}

# Vuln severity classification carried on event payloads + route gates.
enum NotificationSeverityEnum {
	CRITICAL
	HIGH
	MEDIUM
	LOW
	INFO
	NONE
}

# Slack-specific channel config. Only the incoming-webhook URL -- the
# URL itself is the auth credential.
input NotificationSlackChannelConfigInput {
	webhookUrl: String
}

# Subscription write input. Mirrors the existing
# NotificationSubscriptionData record 1:1; nested config is typed
# rather than JSON-stringified because the write path needs schema-
# level validation.
input NotificationSubscriptionInput {
	uuid: ID
	# Optimistic-locking gate. See NotificationChannelInput.expectedRevision.
	expectedRevision: Int
	org: ID!
	resourceGroup: ID
	name: String!
	status: NotificationSubscriptionStatusEnum!
	eventTypes: [NotificationEventTypeEnum!]!
	filter: NotificationFilterInput
	routes: [NotificationRouteInput!]!
	dedupWindowMinutes: Int
	rateLimit: NotificationRateLimitInput
	# Ownership MATCHING scope -- "only events about components THIS team owns".
	# Validated at save: must resolve to a team in the same org. An ARCHIVED team
	# is accepted, since scoping is a matching rule and an archived owner already
	# resolves to nothing at fan-out; rejecting it would block editing unrelated
	# fields on a subscription whose team was archived after it was written.
	#
	# Do not confuse with routes[].notifyComponentOwner: that is a destination
	# covering EVERY owner, this restricts which events match at all. A
	# per-team subscription built from the flag would deliver one team's events
	# to all the others. See ai-plans/team-owned-component-notifications.md.
	ownedByTeam: ID
}

# Subscription summary. Complex nested config (filter, routes, rateLimit)
# remains JSON-stringified through the read surface -- Phase 3 introduces
# typed *Input* shapes for writes, but the read side keeps the existing
# string projection to avoid expanding the schema with parallel inner
# types. A future phase can unify them.
type NotificationSubscriptionResult {
	uuid: ID!
	org: ID!
	resourceGroup: ID
	name: String!
	status: NotificationSubscriptionStatusEnum!
	eventTypes: [NotificationEventTypeEnum!]!
	# JSON-stringified filter config: { mode, presetConfig, celExpression }.
	filter: String
	# JSON-stringified route table:
	# [{ whenSeverityAtLeast, andEnvIn, andLifecycleIn, channels, perspectives, channelGroups,
	#    teams, notifyComponentOwner }].
	# perspectives is the Phase 12 list of UUIDs gating the route -- null/empty = no gate.
	# channelGroups is the Phase 13b list of group UUIDs expanded to member channels at fan-out.
	# teams is the T3 list of team UUIDs whose own channels are merged in at fan-out.
	# notifyComponentOwner is the T4a flag: when true the route also delivers to the owner
	# team of each affected component, resolved at fan-out -- null/false = no owner expansion.
	routes: String
	dedupWindowMinutes: Int
	# JSON-stringified rate limit config: { maxPerWindow, windowMinutes }. Nullable.
	rateLimit: String
	# Ownership MATCHING scope: when set, this subscription matches an event only
	# if at least one component the event affects is owned by this team. Null =
	# unscoped (org-wide), which is every subscription written before this field.
	# Distinct from routes[].notifyComponentOwner, which is a DESTINATION meaning
	# "deliver to whoever owns the affected component" -- every owner, not one.
	ownedByTeam: ID
	# Set when this row is MATERIALISED by a team's own notification setting
	# rather than authored here. Such a row cannot be edited, disabled or deleted
	# through the subscription API -- it is changed on the team that owns it -- so
	# a client must use this to badge the row and withhold those controls.
	managedByTeam: ID
	# Hibernate @Version-managed row revision. The UI captures this on
	# Edit load and round-trips it as expectedRevision on the next save
	# so a concurrent edit by another admin is rejected with a clear
	# "this record was edited by another user -- reload" error rather
	# than silently overwriting their changes.
	revision: Int!
}

# Subscription lifecycle status. PREVIEW is observe-only (used during
# Quick Start verification); the fan-out worker treats it as not-active
# for live traffic.
enum NotificationSubscriptionStatusEnum {
	ACTIVE
	DISABLED
	PREVIEW
}

# MS Teams channel config (Phase 10). The webhook URL is the auth
# credential -- same shape as Slack. Validated at save and dispatch
# against the Power Automate Workflows host suffixes (logic.azure.com
# for the LogicApps-style URL and powerplatform.com for the newer
# Power-Platform-environment URL Microsoft hands out).
input NotificationTeamsChannelConfigInput {
	webhookUrl: String
}

# Generic webhook channel config (Phase 4). url is the customer
# endpoint (required, must be HTTPS). authScheme picks how the
# dispatcher signs each POST. authToken carries the bearer token or
# HMAC shared secret -- required when authScheme != NONE.
input NotificationWebhookChannelConfigInput {
	url: String
	authScheme: WebhookAuthSchemeEnum
	authToken: String
}

enum OAuthType {
	GITHUB
	GOOGLE
	MICROSOFT
}

type OrgLevelContext {
	isNewToOrganization: Boolean!
	wasPreviouslyReported: Boolean!
	isPartiallyResolved: Boolean!
	isFullyResolved: Boolean!
	isInheritedInAllComponents: Boolean!
	componentCount: Int!
	affectedComponentNames: [String!]!
	# "Worsened" annotations from the posture-diff rollup (board task #38, phase 3). Tri-state:
	# null = not computed (legacy pairwise-diff path); true/false = computed from in-window
	# finding_change_events on the posture-diff path. previousSeverity is null unless
	# isSeverityIncreased is true.
	isNewlyKev: Boolean
	isSeverityIncreased: Boolean
	previousSeverity: String
}

