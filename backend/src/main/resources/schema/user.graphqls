	gudidStatus: GudidStatus
	"""
	Release lifecycle date: the CLE END_OF_SUPPORT projection (TeaTransformerService).
	NOT the device support window -- that is declared on the device model at
	ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
	"""
	eos: String
	"""
	Release lifecycle date: the CLE END_OF_LIFE projection (TeaTransformerService).
	NOT the device support window -- that is declared on the device model at
	ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
	"""
	eol: String
	"""
	Update-only: explicitly unset eos, distinct from omitting the field (which
	leaves it unchanged). Wins over a concurrently-supplied eos value. Ignored
	on create (there is nothing to clear yet).
	"""
	clearEos: Boolean
	# Update-only: explicitly unset eol. See clearEos.
	clearEol: Boolean
	"""
	Per-release override of the org FDA assessment narrative. PATCH: omitting the
	field leaves the stored value alone; supplying an EMPTY STRING is a deliberate
	clear that returns the release to inheriting the org default. Bounded to the same
	length as the org-level prose fields.

	Deliberately NOT a clearFdaAssessmentNarrative flag like clearEos above: a date
	has no empty form, so the flag expresses something the value cannot, while prose
	has one and the org-level prose fields already read blank as clear.
	"""
	fdaAssessmentNarrative: String
