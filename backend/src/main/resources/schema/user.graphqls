"""
Resolved device identity for a feature set: its effective UDI-DI and
regulatory class, derived from the single UDI-bearing constituent component.
"""
type DeviceIdentity {
	featureSet: ID
	deviceClass: DeviceClass
	udiBearingComponent: ID
	udiBearingRelease: ID
	udiDi: String
	"""
	Physical-ness of what a shipment of this feature set records: HARDWARE when any constituent
	component is HARDWARE-nature, SOFTWARE otherwise. Together with deviceClass this is the
	same two-axis classification components carry: HARDWARE = physical batch, SOFTWARE +
	MEDICAL_* = SaMD (shipped and tracked per unit like hardware), SOFTWARE + NONE = plain
	software.
	"""
	nature: ComponentNature
}

input DeviceInput {
	"""null on create; existing uuid on update."""
	uuid: ID
	org: ID!
	shippedProduct: ID!
	identifiers: [IdentifierInput]
	plan: DevicePlanInput
	notes: String
}

input DevicePlanInput {
	expectedRelease: ID
}

# DERIVED per-component verdict: whether the component's declared support window ends
# before the DEVICE's support horizon (the Feb-2026 FDA signal). The device horizon is the
# DEVICE WINDOW resolved by DeviceLifecycleResolver -- declared on the device model and
# optionally overridden per batch -- and NOT the release's own eos, which is a CLE lifecycle
# projection. There is no end-of-life fallback, because end-of-life means end of SALE.
# Computed from the component's end-of-support and that horizon; never stored.
enum DeviceSupportRisk {
	OK
	EOS_BEFORE_DEVICE
	UNKNOWN
}

"""One in-field unit's support-risk evaluation (D7)."""
type DeviceSupportRiskRow {
	device: ID
	shippedProduct: ID
	site: ID
	"""Unit-level identifiers (SERIAL, UDI, ...), so a row can be labelled without a device read."""
	identifiers: [Identifier]
	"""The site the unit is fielded at, or null when it has none or the site is archived."""
	siteName: String
	"""The client that owns that site, or null when unresolved or archived."""
	clientName: String
	"""The release this unit was judged on, or null when it has neither."""
	release: ID
	"""Which release that was: REPORTED (ground truth) or EXPECTED (the plan)."""
	releaseSource: EvaluatedRelease
	"""The device window that applied, or null when none is declared."""
	window: ResolvedDeviceSupportWindow
	risk: DeviceSupportRisk
	"""Soonest ATTESTED component end-of-support in that release (WITHDRAWN excluded)."""
	earliestComponentEos: String
	"""How many attested components end support before the device does."""
	componentsDrivingRisk: Int
}

"""
A declared window, for writes. Rejected when the component has no device class, or when
`eos` is after `eol`.

**An empty object is NOT a clear.** A form bound to two date pickers posts `{}` the moment
both are blank; retracting a regulatory commitment has to be asked for explicitly, with
`clearDeviceSupportWindow`.
"""
input DeviceSupportWindowInput {
	"""ISO-8601 date, YYYY-MM-DD."""
	eos: String
	"""ISO-8601 date, YYYY-MM-DD."""
	eol: String
	"""UTC RFC-3339 instant. Defaults to the time of the write when omitted."""
	assessedAt: String
}

"""
A page of fleet rows plus the unpaged totals, so a caller can show "N of M" and "K at risk".
Rows come at-risk first (EOS_BEFORE_DEVICE, then UNKNOWN, then OK; uuid order within a
verdict), so page 1 answers the question.
"""
type DevicesAtSupportRiskPage {
	rows: [DeviceSupportRiskRow]
	"""The size of the whole in-field fleet matching the filters, not of this page."""
	total: Int
	"""How many units in that fleet are EOS_BEFORE_DEVICE, counted before paging."""
	atRiskTotal: Int
}

"""Industry framing for a distribution; drives UI terminology per client."""
enum DistributionDomain {
	GENERIC
	MEDICAL
	DEFENSE
}

