input UpdateComponentInput {
	"""
	The section 524B device support window for this device model (D7). PATCH: omitted
	leaves the stored value alone. Rejected when the component has no device class, or
	when eos is after eol.
	"""
	deviceSupportWindow: DeviceSupportWindowInput
	"""
	Explicitly retract the declared window. Distinct from omitting the field and from
	sending an empty window object -- an empty object is what a form with two blank date
	pickers posts by accident, and it must not withdraw a regulatory commitment.
	"""
	clearDeviceSupportWindow: Boolean
	uuid: ID
	name: String!
	kind: ComponentKind
	versionSchema: String
	marketingVersionSchema: String
	versionType: VersionType
	featureBranchVersioning: String
	vcs: ID
	approvalPolicy: ID
	"""
	Explicitly clear the per-component approvalPolicy reference. The
	default {@code null} on {@code approvalPolicy} means "leave the
	existing value alone" (server-side leave-unchanged convention), so
	a separate flag is needed to express "actually remove the assigned
	policy". When {@code true}, the server unsets the reference; the
	same guard as the change-policy path still applies (the component
	must not still reference globalInputEvents from the old policy).
	{@code approvalPolicy} is ignored when this flag is true.
	"""
	clearApprovalPolicy: Boolean
	releaseInputTriggers: [ReleaseInputEventInput]
	outputTriggers: [ReleaseOutputEventInput]
	globalInputEventRefs: [GlobalInputEventRefInput]
	identifiers: [IdentifierInput]
	# Distribution module: device classification + profiles + native identifiers.
	nature: ComponentNature
	deviceClass: DeviceClass
	medicalProfile: MedicalProfileInput
	repoPath: String
	authentication: ComponentAuthenticationInput
	branchSuffixMode: BranchSuffixMode
	"""
	Update component-level sid override. Null leaves the existing value unchanged.
	INHERIT clears the override (defers to higher level). Only writeable under
	org ENABLED_FLEXIBLE.
	"""
	sidPurlOverride: SidPurlOverride
	"""
	Update component-level authority segments. Null leaves the existing value unchanged.
	"""
	sidAuthoritySegments: [String!]
	"""
	Update internal/external classification (D16). Null leaves the existing value unchanged.
	"""
	isInternal: BelongsToOrganization
	"""Manually-assigned lead user UUIDs. Null leaves unchanged; empty list clears."""
	leads: [ID!]
	"""Freeform stakeholder contacts (HTML-sanitized server-side). Null leaves unchanged; empty list clears."""
	contacts: [ComponentContactInput!]
	"""
	Set the durable owner (RFC Phase 4b). Validated server-side against this
	component's org (no DB FK). Null leaves the existing owner unchanged.
	"""
	owner: ComponentOwnerInput
	"""
	Explicitly remove the stored owner. Needed because owner: null already means
	"no change", so it cannot express removal. Clearing hands the component back
	to org team-assignment rules. Takes precedence over owner when both are sent.
	"""
	clearOwner: Boolean
}

input UpdateInstancePlanInput {
	properties: [InstancePropertyRecordInput]
	addProperties: [InstancePropertyRecordInput]
	targetReleases: [DeployedReleaseInput]
	environment: String
	products: [InstanceProductMapPlanInput]
}

"""
Every collection is NULL-MEANS-KEEP: omitting a field leaves the stored value
alone, sending an empty list REPLACES it with nothing. A partially-loaded editor
must omit rather than send [] -- that is how a roster gets silently emptied.
"""
input UpdateTeamInput {
	teamId: ID!
	name: String
	description: String
	status: TeamStatus
	members: [ID]
	# Must exist and belong to this org; validated on save.
	userGroups: [ID]
	# Must exist, belong to this org, and actually be notification channels.
	notificationChannels: [ID]
	# Must be on the effective roster (members + members of contained groups).
	leads: [ID]
	# Omit to leave the team's notification setting alone. Sending it replaces
	# the whole object, and saving the team re-materialises its subscription.
	ownedComponentNotifications: OwnedComponentNotificationsInput
}

