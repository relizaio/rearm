enum SourceFormat {
	OPENVEX
	CDX_VEX
}

type SshKey {
	uuid: ID
	name: String
}

enum SupportAttestationFilter {
	# Every non-root component in the release.
	ALL
	# Only those the coverage gauge counts as disclosed.
	ATTESTED
	# Only those the gauge counts as missing -- the bulk-attest work queue.
	UNATTESTED
}

# What a bulk attestation did to one component.
enum SupportBulkOutcome {
	# The attestation was written.
	APPLIED
	# Skipped: the component is the application itself, not a third-party dependency.
	SKIPPED_ROOT
	# Skipped: an attestation already exists. A bulk pass never overwrites one -- that is what
	# makes a re-run idempotent and what protects an earlier per-component judgement.
	SKIPPED_ATTESTED
	# This component's write was rejected; `message` says why. The batch continued.
	FAILED
}

# Support-disclosure completeness for an org. attested = non-root components with a
# MANUFACTURER (MANUAL) attestation (excludes machine ENRICHED / supplier-declared
# provenance, which are not a manufacturer disclosure). total = all non-root components.
# Per-source counts can be added as new fields additively if needed.
"""
Whether an org's BOM exports carry the FDA support-disclosure properties.

Deliberately NOT a Boolean -- see supportExportState on SbomComponentSupportCoverage.
"""
enum SupportExportState {
	"""Exports carry the support properties."""
	ENABLED
	"""Exports omit them; the coverage counts describe data that is not being shipped."""
	DISABLED
	"""
	RETIRED. Never returned.

	It described a real state that no longer exists: injection reaching some egresses and
	not others, when the native artifact download injected while the SPDX-augmented form and
	the release-level export did not. One setting now gates all three, so an export either
	carries the properties or it does not.

	Retained so clients built against the published schema keep parsing. A client that still
	branches on it should treat it as it always meant: do not assume this export carries the
	disclosure.
	"""
	PARTIAL @deprecated(reason: "Retired: one setting now gates every egress, so an export either carries the properties or it does not. Never returned; retained so published-schema clients keep parsing.")
	"""The server could not determine the setting. Never collapse this to ENABLED or DISABLED."""
	UNKNOWN
}

# One independently-provenanced support milestone assertion. An entry's presence IS the
# assertion of that date. notes is internal-only, never exported.
#
# NOTE the nullability change from the previous shape: these fields are no longer
# non-null. The facts now live in the attestation's JSONB rather than in a table whose
# NOT NULL constraints enforced them, so the schema states what the storage can actually
# guarantee. Claiming non-null here and serving null on a hand-edited or partially
# migrated payload would be a runtime error at the client, which is a worse failure than
# an honest nullable field.
type SupportMilestone {
	milestoneType: SupportMilestoneType!
	date: String
	source: SupportSource
	lastAssessed: String
	assertedBy: ID
	notes: String
}

# Which per-component support milestone is being asserted. Scoped to per-component
# support only; a full per-component CLE mapping (e.g. endOfDevelopment) is out of
# scope here -- CLE 1.0.0 treats per-component assertions as third-party claims,
# future-scope there. Device-level CLE events are a separate axis.
enum SupportMilestoneType {
	# Bug fixes stop, security fixes continue. Feeds SupportStatus.SECURITY_ONLY.
	END_OF_GUARANTEED_SUPPORT
	# All support ceases (transfer of risk) -- the date FDA's disclosure wants.
	END_OF_SUPPORT
	# The component reaches end of life.
	END_OF_LIFE
}

# Whether the manufacturer is the first party for a component's support facts (its own
# device/release) or a third party making a claim about a component it has no
# operational control over (e.g. log4j).
enum SupportParty {
	FIRST_PARTY
	THIRD_PARTY
}

# Provenance of one milestone's support assertion, set server-side per write path.
# Independent per milestone -- see SupportMilestone.
enum SupportSource {
	MANUAL
	SUPPLIER
	ENRICHED
}

# Lifecycle of the attestation RECORD itself, as opposed to the support lifecycle of
# the component it describes. WITHDRAWN exists because a regulatory record is corrected
# by superseding it, never by erasing it: a manufacturer who finds an attestation was
# made in error must be able to say so on the record, and deleting the row would destroy
# the history that makes the correction credible.
enum SupportState {
	ATTESTED
	WITHDRAWN
}

# The DERIVED per-component support state: what the stored dates entail as of a clock, and
# nothing more. The manufacturer's own claim is a different field with a different type --
# see LevelOfSupport and attestedLevelOfSupport. The two are shown side by side and are never
# reconciled: a maintainer can publish a far-future end-of-support and have abandoned the
# library in practice, and a reviewer needs to see both.
#
# ACTIVELY_SUPPORTED, ABANDONED and END_OF_LIFE are retained but NEVER returned. The first two
# moved to LevelOfSupport as attested claims; END_OF_LIFE was retired because it means END OF
# SALE, which is not a support state. They stay because this enum is published in the CE
# schema and removing a value would break consumers who already hold it.
enum SupportStatus {
	ACTIVELY_SUPPORTED
	SECURITY_ONLY
	END_OF_SUPPORT
	END_OF_LIFE
	ABANDONED
	UNKNOWN
}

# Curated synthetic event templates surfaced through the
# injectSyntheticEvent mutation. The full set lives on
# {@code SyntheticEventTemplates.Template}; each value here maps 1:1
# to a constant in that enum.
enum SyntheticEventTemplateEnum {
	CRITICAL_VULN_SINGLE_SHIPPED_RELEASE
	CRITICAL_KEV_VULN_THREE_RELEASES_IN_PAYLOAD
	KEV_LISTED_DRAFT_RELEASE
	SEVERITY_BUMP_MEDIUM_TO_CRITICAL
	KEV_ADDED
	VEX_RESOLVED_NOT_AFFECTED
}

type SystemInfoIsSet {
	emailDetailsSet: Boolean
	defaultOrg: ID
	defaultOrgDetails: Organization
	# vulncheckKevConfigured dropped in V54 KEV per-org refactor; surfaced
	# per-org via the Integrations Catalog cards on Organization Settings.
}

enum TeamStatus {
	ACTIVE
	INACTIVE
}

"""
A Team is the organization's addressable unit -- what a notification route can
point at, and (from a later phase) what a component is owned by. A team grants
NOTHING: access comes from UserGroup and the permission model, and the two are
separate entities so neither drifts into doing the other's job.
"""
type TeamWebDto {
	uuid: ID
	name: String
	description: String
	org: ID
	status: TeamStatus
	# Individually-added members.
	members: [ID]
	"""
	Permission groups whose members are also on this team. Not a convenience:
	component ownership derives its candidate teams from COMPONENT-scoped
	permissions and its durability from SSO-backed groups, so a team that could
	hold only individual users would lose both once ownership retargets here.
	"""
	userGroups: [ID]
	# Channels this team is reachable on (e.g. its Slack channel).
	notificationChannels: [ID]
	"""
	Members who may administer this team. Stored and validated now; nothing
	reads it for authorization yet -- delegated administration is a later phase.
	Distinct from ComponentData.leads, which names people on a component.
	"""
	leads: [ID]
	"""
	This team's own "notify me about the components I own" setting. ReARM
	materialises an ordinary subscription behind it, scoped to this team's
	components and delivering to this team's channels; the subscription appears
	in the subscription list flagged as team-managed and is edited HERE, not
	there. Null means never configured, which reads as off.
	"""
	ownedComponentNotifications: OwnedComponentNotifications
}

