FROM maven:3.9.16-eclipse-temurin-25-noble@sha256:93b8a14ea2f412782e4e842651273b4d903e35cc496284f178fbbe2d67d00976
# October 2026 eMudhra CA compromise: the fixed Ubuntu store for curl, the two roots out of the JDK cacerts for Maven.
RUN apt-get update && apt-get install -y --only-upgrade ca-certificates && dpkg-query -W ca-certificates && rm -rf /var/lib/apt/lists/*
COPY ci/trust-gate/jdk-distrust.sh /gate/
RUN sh /gate/jdk-distrust.sh
ARG CODEQL_BUNDLE_VERSION=2.25.5
ARG CODEQL_URL="https://github.com/github/codeql-action/releases/download/codeql-bundle-v${CODEQL_BUNDLE_VERSION}/codeql-bundle-linux64.tar.gz"

RUN curl -sSL "$CODEQL_URL" -o /tmp/codeql.tgz \
    && echo "24717f939f1bef659f893ff4a9c99ba8c056fbaca9640f877c4dc74cf96486d7  /tmp/codeql.tgz" | sha256sum -c - \
    && mkdir -p /opt/codeql \
    && tar -xzf /tmp/codeql.tgz -C /opt/codeql --strip-components=1 \
    && rm /tmp/codeql.tgz

ENV PATH="/opt/codeql:${PATH}"

RUN mkdir /workspace && mkdir /sarif
WORKDIR /workspace

COPY . .
RUN codeql database create qldb --language=java
RUN codeql database analyze qldb --format=sarifv2.1.0 --output=/sarif/results.sarif